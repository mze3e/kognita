# Deprecated terms. Before 1.0 a release can rename terms; each renamed IRI stays
# declared with owl:deprecated for one version and names its replacement
# (ROADMAP.md, versioning policy).
#
# 0.6 renamed nine terms to US English spelling. Remove these declarations in 0.7.

owl:deprecated a owl:AnnotationProperty .
dcterms:isReplacedBy a owl:AnnotationProperty .

pwm:AuthorisedSignatory a owl:Class ; rdfs:label "authorised signatory (deprecated)"@en ;
    skos:definition "Deprecated spelling. Use pwm:AuthorizedSignatory."@en ;
    owl:deprecated true ; dcterms:isReplacedBy pwm:AuthorizedSignatory ; rdfs:subClassOf pwm:AuthorizedSignatory ;
    pwm:inModule pwm:ModuleCore ; pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.6 US English rename; deprecated alias for one version" ] .

