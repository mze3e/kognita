
# PWM 0.4: missing ingestion, declarative policy and lifecycle records.
# Versioned policy artefacts and breaker configuration are SlowContext.
# Recorded evidence and review state are MediumContext; FastContext is reserved for live data.
pwm:ModuleLifecycle a pwm:Module ; rdfs:label "Ingestion, policy and lifecycle controls"@en ; pwm:moduleOrder 10 ; skos:definition "Structured ingestion and the missing policy, review and monitoring records for milestone 0.4."@en .

pwm:IngestedDocument a owl:Class ; rdfs:label "ingested document"@en ;
    skos:definition "Immutable source-file ingestion record identifying the parser and its exact version. Reuses contentHash and versionId."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:DocumentElement a owl:Class ; rdfs:label "document element"@en ;
    skos:definition "Parser-derived passage or structural element of an ingested document, with page, section path, character span, classification and content hash. Parent links preserve the parsed tree."@en ; rdfs:subClassOf pwm:DocumentSection ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:DeclarativePolicy a owl:Class ; rdfs:label "declarative policy"@en ;
    skos:definition "Versioned declarative artefact serialising existing PolicyRule records; not a replacement rule engine."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:PolicyChange a owl:Class ; rdfs:label "policy change"@en ;
    skos:definition "Archived proposed, reviewed, strictly validated and applied delta against a policy version, containing added, modified or removed rule identifiers."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:PolicyTestCase a owl:Class ; rdfs:label "policy test case"@en ;
    skos:definition "Named scenario under a policy rule, with given attributes, requested action and expected decision outcome."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:PolicyPack a owl:Class ; rdfs:label "policy pack"@en ;
    skos:definition "Named versioned bundle of policy artefacts, scenarios and fixture references; a private overlay may shadow a built-in pack."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 5" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:FlightRecorderSession a owl:Class ; rdfs:label "flight recorder session"@en ;
    skos:definition "Evidence export manifest for recorded runs and interactions, with a content hash and retained export locator. Reuses Run and ReconstructionReport rather than duplicating their evidence."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:Replay a owl:Class ; rdfs:label "replay"@en ;
    skos:definition "Verification of a recorder session against retained evidence, producing an existing ReconstructionReport; does not mean re-executing client actions."@en ; rdfs:subClassOf prov:Activity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:RMReviewEdit a owl:Class ; rdfs:label "RM review edit"@en ;
    skos:definition "Structured edit captured during HumanReview, preserving hashes of what the RM saw, what was approved and the retained diff."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ] .

pwm:ReviewQueue a owl:Class ; rdfs:label "review queue"@en ;
    skos:definition "Use-case review queue receiving high-risk and sampled low-risk interactions for human review."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 13" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight; 5.23: monitoring" ] .

pwm:ReviewQueueEntry a owl:Class ; rdfs:label "review queue entry"@en ;
    skos:definition "Risk-selected interaction awaiting or completing human review, with reason, queue time and delivery boundary."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 13" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight; 5.23: monitoring" ] .

pwm:ReviewCoverageReport a owl:Class ; rdfs:label "review coverage report"@en ;
    skos:definition "Evidence-derived counts of eligible, screened, queued and reviewed interactions over a window, with review latency; grouped by use case and its risk tier."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 13" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight; 5.23: monitoring" ] .

pwm:CircuitBreaker a owl:Class ; rdfs:label "circuit breaker"@en ;
    skos:definition "Automatic halt configuration specifying flag threshold, time window and scope; trips create a prohibiting policy and incident, and reset requires accountable-owner approval."@en ; rdfs:subClassOf pwm:KillSwitch ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(b): incidents and monitoring" ] .

pwm:CircuitBreakerTrip a owl:Class ; rdfs:label "circuit breaker trip"@en ;
    skos:definition "Recorded threshold crossing with exact scope, threshold, observed flags, window and inserted prohibiting rule."@en ; rdfs:subClassOf pwm:AIIncident ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(b): incidents and monitoring" ] .

pwm:AffectedClientQuery a owl:Class ; rdfs:label "affected client query"@en ;
    skos:definition "Version-scoped and time-bounded query for clients receiving output, with an explicit result even when no clients match."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
