
# PWM 0.5: Agents, Authority and Fleets

pwm:ModuleAgents a pwm:Module ; rdfs:label "Agents, authority and fleets"@en ; pwm:moduleOrder 11 ;
    skos:definition "Workload identities, scoped human authority, autonomy evidence, containment and fleet controls."@en .

pwm:WorkloadIdentity a owl:Class ; rdfs:label "workload identity"@en ;
    skos:definition "Registry of an individual agent workload credential reference, issuer, subject and environment. Stores no private key or token. Gateways verify possession on every call."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.11 agent risks; fn 25 agent identifiers and components" ] .

pwm:AuthorityScope a owl:Class ; rdfs:label "authority scope"@en ;
    skos:definition "Explicit finite sets of clients, purposes, verbs, tools, fields, systems, products and jurisdictions. Omission grants nothing for dimensions checked by the written narrowing rules. Numeric caps and autonomy may only narrow."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:HumanEntitlement a owl:Class ; rdfs:label "human entitlement"@en ;
    skos:definition "Time-bounded entitlement held by a named person, with explicit subject scope. An agent delegation cannot enlarge this scope."@en ; rdfs:subClassOf cmns-bauth:Authorization ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:AuthorityRevocation a owl:Class ; rdfs:label "authority revocation"@en ;
    skos:definition "Record that authority or a credential was revoked at a stated time, including task completion. Revocation is effective on the next decision."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:AutonomyTransition a owl:Class ; rdfs:label "autonomy transition"@en ;
    skos:definition "Evidenced promotion or automatic one-level step-down for an agent, with before and after levels, evaluation window, metric sample, approval and notification records. Restoration requires promotion again."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: quality metrics before more autonomy" ], [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 04: autonomy is a licence, not a launch setting" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9 human oversight" ] .

pwm:BlastRadiusLimit a owl:Class ; rdfs:label "blast radius limit"@en ;
    skos:definition "Agent-wide damage limits independent of RunBudget. Each limit names a dimension, unit, aggregation basis, time window and maximum. Decisions carry projected consumption including the proposed action."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:BlastRadiusObservation a owl:Class ; rdfs:label "blast radius observation"@en ;
    skos:definition "Recorded projected cumulative consumption against one agent limit, including the requested action. Window and dimension are inherited from that exact limit."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:ExternalContent a owl:Class ; rdfs:label "external content"@en ;
    skos:definition "Content from outside the institution, including agent messages, PDFs and API responses. Its trust label never conveys instruction authority."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 6" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:AuthenticatedInstruction a owl:Class ; rdfs:label "authenticated instruction"@en ;
    skos:definition "Instruction with authenticated human, assurance level, source and transaction context. A signature reference is evidence to verify, never a secret or a substitute for step-up authorization."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:BehaviourBaseline a owl:Class ; rdfs:label "behaviour baseline"@en ;
    skos:definition "Versioned per-agent expected behaviour and containment threshold for a named metric over a window."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:BehaviourAnomaly a owl:Class ; rdfs:label "behaviour anomaly"@en ;
    skos:definition "Observed deviation from an agent baseline, with automatic containment and incident links. Human release follows containment."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:CapabilityGrant a owl:Class ; rdfs:label "capability grant"@en ;
    skos:definition "Explicit expiring and revocable capability assigned to an agent within a subject scope. Issue, use, expiry and revocation are evidenced."@en ; rdfs:subClassOf cmns-bauth:Authorization ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 10" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:AgentFleet a owl:Class ; rdfs:label "agent fleet"@en ;
    skos:definition "Registered group of agents under common quotas, isolation and halt controls. External members are untrusted principals."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:FleetHalt a owl:Class ; rdfs:label "fleet halt"@en ;
    skos:definition "Recorded fleet-wide stop instruction with explicit fleet scope and time. Runtime dispatch and cancellation are performed by the gateway."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:SandboxConstraints a owl:Class ; rdfs:label "sandbox constraints"@en ;
    skos:definition "Decision output specifying the permitted credential references, network destinations, filesystem scope, APIs, commands, export, persistence, auto-stop interval and resource caps. Kognita emits constraints, not a sandbox."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 12" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:CompensatingAction a owl:Class ; rdfs:label "compensating action"@en ;
    skos:definition "Registered recovery action for a reversible tool; recovery records reference the original call and an explicit reverse execution order."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 13" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:AdversarialTestCase a owl:Class ; rdfs:label "adversarial test case"@en ;
    skos:definition "Attack scenario specialising the existing policy test case, linked to a versioned threat model and the control tested. Passing requires denial, escalation or containment."@en ; rdfs:subClassOf pwm:PolicyTestCase ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 14" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:ThreatModel a owl:Class ; rdfs:label "threat model"@en ;
    skos:definition "Versioned threat model covering own-agent failures and hostile external agents, mapping attack scenarios to controls."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 14" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:EnforcementAttestation a owl:Class ; rdfs:label "enforcement attestation"@en ;
    skos:definition "Attributed time-stamped evidence about gateway mediation, credential custody, egress routing and evidence-store isolation for a use case. The attestation is a claim to verify operationally."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:ActionStop a owl:Class ; rdfs:label "action stop"@en ;
    skos:definition "Recorded stop or cancellation request for an in-flight tool call with outcome cancelled, completed, timed out or unsupported; unsupported cancellation requires compensation or decision-separated steps."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 16" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:workloadIdentity a owl:ObjectProperty ; rdfs:label "workload identity"@en ;
    skos:definition "Workload identity assigned exclusively to this agent."@en ; rdfs:range pwm:WorkloadIdentity ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:credentialReference a owl:DatatypeProperty ; rdfs:label "credential reference"@en ;
    skos:definition "Non-secret opaque credential handle held by the gateway."@en ; rdfs:domain pwm:WorkloadIdentity ; rdfs:range xsd:anyURI ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:credentialIssuer a owl:DatatypeProperty ; rdfs:label "credential issuer"@en ;
    skos:definition "Issuer of the workload identity."@en ; rdfs:domain pwm:WorkloadIdentity ; rdfs:range xsd:anyURI ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:workloadSubject a owl:DatatypeProperty ; rdfs:label "workload subject"@en ;
    skos:definition "Authenticated subject bound to exactly one workload."@en ; rdfs:domain pwm:WorkloadIdentity ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:deploymentEnvironment a owl:DatatypeProperty ; rdfs:label "deployment environment"@en ;
    skos:definition "Environment in which a workload or agent is deployed."@en ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:deploymentDate a owl:DatatypeProperty ; rdfs:label "deployment date"@en ;
    skos:definition "Time of the owner-approved deployment."@en ; rdfs:domain pwm:AIAgent ; rdfs:range xsd:dateTime ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:agentOwner a owl:ObjectProperty ; rdfs:label "agent owner"@en ;
    skos:definition "Named human accountable for this agent deployment."@en ; rdfs:domain pwm:AIAgent ; rdfs:range fibo-fnd-aap-ppl:Person ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:operatesFor a owl:ObjectProperty ; rdfs:label "operates for"@en ;
    skos:definition "Human principal on whose behalf an agent operates."@en ; rdfs:domain pwm:AIAgent ; rdfs:range fibo-fnd-aap-ppl:Person ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:agentStatus a owl:ObjectProperty ; rdfs:label "agent status"@en ;
    skos:definition "Agent lifecycle state, reusing the use-case status codes without inferring an agent is a use case."@en ; rdfs:domain pwm:AIAgent ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .
pwm:agentStatus pwm:valuesFrom pwm:UseCaseStatusScheme .

pwm:approvedDeploymentVersion a owl:DatatypeProperty ; rdfs:label "approved deployment version"@en ;
    skos:definition "Exact deployment hash approved by the owner."@en ; rdfs:domain pwm:AIAgent ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:authorityScope a owl:ObjectProperty ; rdfs:label "authority scope"@en ;
    skos:definition "Explicit scope of an entitlement, delegation or capability grant."@en ; rdfs:range pwm:AuthorityScope ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:holdsEntitlement a owl:ObjectProperty ; rdfs:label "holds entitlement"@en ;
    skos:definition "Entitlement held by a human grantor."@en ; rdfs:range pwm:HumanEntitlement ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:scopeTool a owl:ObjectProperty ; rdfs:label "scope tool"@en ;
    skos:definition "Tool permitted within an authority scope."@en ; rdfs:domain pwm:AuthorityScope ; rdfs:range pwm:Tool ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:scopeField a owl:DatatypeProperty ; rdfs:label "scope field"@en ;
    skos:definition "Field name permitted within a scope; whole-record access is never implicit."@en ; rdfs:domain pwm:AuthorityScope ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 5" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:scopeSystem a owl:DatatypeProperty ; rdfs:label "scope system"@en ;
    skos:definition "System identifier permitted within a scope."@en ; rdfs:domain pwm:AuthorityScope ; rdfs:range xsd:anyURI ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:scopeProduct a owl:ObjectProperty ; rdfs:label "scope product"@en ;
    skos:definition "Product permitted within a scope."@en ; rdfs:domain pwm:AuthorityScope ; rdfs:range pwm:Product ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:revokedAuthority a owl:ObjectProperty ; rdfs:label "revoked authority"@en ;
    skos:definition "Delegation, capability, entitlement or credential invalidated by this record."@en ; rdfs:domain pwm:AuthorityRevocation ; rdfs:range owl:Thing ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:revokedAt a owl:DatatypeProperty ; rdfs:label "revoked at"@en ;
    skos:definition "Effective revocation time, including completion of the authorized task."@en ; rdfs:domain pwm:AuthorityRevocation ; rdfs:range xsd:dateTime ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:parentDelegation a owl:ObjectProperty ; rdfs:label "parent delegation"@en ;
    skos:definition "Immediate parent authorization; the root human remains delegatedBy and parent delegatedTo identifies the sub-delegating agent."@en ; rdfs:domain pwm:DelegatedAuthority ; rdfs:range pwm:DelegatedAuthority ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 9" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:delegationDepth a owl:DatatypeProperty ; rdfs:label "delegation depth"@en ;
    skos:definition "Depth from root human authorization, zero at the root."@en ; rdfs:domain pwm:DelegatedAuthority ; rdfs:range xsd:nonNegativeInteger ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 9" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:maxDelegationDepth a owl:DatatypeProperty ; rdfs:label "max delegation depth"@en ;
    skos:definition "Maximum total depth allowed by the root, preserved or reduced by children."@en ; rdfs:domain pwm:DelegatedAuthority ; rdfs:range xsd:nonNegativeInteger ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 9" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:transitionAgent a owl:ObjectProperty ; rdfs:label "transition agent"@en ;
    skos:definition "Agent whose effective autonomy changes."@en ; rdfs:domain pwm:AutonomyTransition ; rdfs:range pwm:AIAgent ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .

pwm:fromAutonomyLevel a owl:ObjectProperty ; rdfs:label "from autonomy level"@en ;
    skos:definition "Effective autonomy before a transition."@en ; rdfs:domain pwm:AutonomyTransition ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleAgents ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialised record or property; no exact standard term identified" ] .
pwm:fromAutonomyLevel pwm:valuesFrom pwm:AutonomyLevelScheme .

pwm:toAutonomyLevel a owl:ObjectProperty ; rdfs:label "to autonomy level"@en ;
    skos:definition "Effective autonomy after a transition."@en ; rdfs:domain pwm:AutonomyTransition ; rdfs:range skos:Concept ;
