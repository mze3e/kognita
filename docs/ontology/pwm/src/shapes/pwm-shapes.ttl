pwmsh:EnvelopeAttributeShape a sh:NodeShape ; rdfs:label "EnvelopeAttributeShape"@en ; sh:targetClass pwm:EnvelopeAttribute ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 4."@en ;
    sh:property [ sh:path pwm:attributeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record attributeName (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:attributeValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record attributeValue (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:attributeSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record attributeSource (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Classifier-derived attribute needs calibrated confidence and classifier version (0.3 item 4)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:attributeSource pwm:AttributeClassifierDerived . FILTER NOT EXISTS { $this pwm:derivedFromClassifier ?c . ?c pwm:confidence ?confidence ; pwm:classifierVersion ?version } }""" ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
      sh:message "Identity attributes come from authentication, never classifier text (0.3 item 4 and Tier 0)." ;
      sh:select """SELECT $this WHERE { $this pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:attributeName ?name .
        FILTER (?name IN ("principal", "agent", "agent_name", "system_trigger", "client_configuration")) }""" ] .

pwmsh:ClassifierThresholdShape a sh:NodeShape ; rdfs:label "ClassifierThresholdShape"@en ; sh:targetSubjectsOf pwm:hasAttribute , pwm:escalationThreshold ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 4."@en ;
    sh:property [ sh:path pwm:escalationThreshold ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Below-threshold or missing-threshold classifier evidence cannot yield ALLOW (0.3 item 4)." ; sh:select """SELECT DISTINCT $this WHERE { { $this pwm:decisionOutcome pwm:OutcomeAllow . BIND($this AS ?decision) } UNION { $this pwm:governedByDecision ?decision . ?decision pwm:decisionOutcome pwm:OutcomeAllow } $this pwm:hasAttribute ?a . ?a pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:derivedFromClassifier ?c . ?c pwm:confidence ?confidence . FILTER NOT EXISTS { ?decision pwm:escalationThreshold ?t . FILTER (?confidence >= ?t) } }""" ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
      sh:message "Classifier fills gaps only; a typed attribute remains authoritative (0.3 item 4)." ;
      sh:select """SELECT DISTINCT $this WHERE {
        $this pwm:hasAttribute ?typed, ?derived .
        ?typed pwm:attributeSource pwm:AttributeTyped ; pwm:attributeName ?name .
        ?derived pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:attributeName ?name .
      }""" ] .

