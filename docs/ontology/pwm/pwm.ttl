pwm:capacityForLoss pwm:valuesFrom pwm:RatingLevelScheme .
pwm:claimType pwm:valuesFrom pwm:ClaimTypeScheme .
pwm:classification pwm:valuesFrom pwm:DataClassificationScheme .
pwm:clientImpactClass pwm:valuesFrom pwm:ClientImpactClassScheme .
pwm:communicationLevel pwm:valuesFrom pwm:CommunicationLevelScheme .
pwm:complexity pwm:valuesFrom pwm:RatingLevelScheme .
pwm:contentProvenance pwm:valuesFrom pwm:ContentProvenanceScheme .
pwm:coverageRole pwm:valuesFrom pwm:CoverageRoleScheme .
pwm:decisionConsequence pwm:valuesFrom pwm:DecisionConsequenceScheme .
pwm:decisionOutcome pwm:valuesFrom pwm:DecisionOutcomeScheme .
pwm:decisionResult pwm:valuesFrom pwm:DecisionResultScheme .
pwm:disclosureTrigger pwm:valuesFrom pwm:DisclosureTriggerScheme .
pwm:doNotContactReason pwm:valuesFrom pwm:DoNotContactReasonScheme .
pwm:eventType pwm:valuesFrom pwm:EvidenceEventTypeScheme .
pwm:feeType pwm:valuesFrom pwm:FeeTypeScheme .
pwm:impact pwm:valuesFrom pwm:RatingLevelScheme .
pwm:inherentMateriality pwm:valuesFrom pwm:RatingLevelScheme .
pwm:investorCategory pwm:valuesFrom pwm:InvestorCategoryScheme .
pwm:lifecycleStatus pwm:valuesFrom pwm:UseCaseStatusScheme .
pwm:maxAutonomyLevel pwm:valuesFrom pwm:AutonomyLevelScheme .
pwm:memoryScope pwm:valuesFrom pwm:MemoryScopeScheme .
pwm:optStatus pwm:valuesFrom pwm:OptStatusScheme .
pwm:originationTrigger pwm:valuesFrom pwm:OriginationTriggerScheme .
pwm:pepCategory pwm:valuesFrom pwm:PEPCategoryScheme .
pwm:permitsDataClass pwm:valuesFrom pwm:DataClassificationScheme .
pwm:primaryMetric pwm:valuesFrom pwm:PrimaryMetricScheme .
pwm:productComplexity pwm:valuesFrom pwm:ProductComplexityScheme .
pwm:productRiskLevel pwm:valuesFrom pwm:IllustrativeRiskScale .
pwm:reliance pwm:valuesFrom pwm:RatingLevelScheme .
pwm:requiredAutonomyLevel pwm:valuesFrom pwm:AutonomyLevelScheme .
pwm:residualMateriality pwm:valuesFrom pwm:RatingLevelScheme .
pwm:riskProfileLevel pwm:valuesFrom pwm:IllustrativeRiskScale .
pwm:riskTier pwm:valuesFrom pwm:RiskTierScheme .
pwm:screeningDisposition pwm:valuesFrom pwm:ScreeningDispositionScheme .
pwm:signingRule pwm:valuesFrom pwm:SigningRuleScheme .
pwm:staleAction pwm:valuesFrom pwm:StaleActionScheme .
pwm:suitabilityOutcome pwm:valuesFrom pwm:SuitabilityOutcomeScheme .
pwm:targetRiskProfile pwm:valuesFrom pwm:IllustrativeRiskScale .
pwm:usesDataClass pwm:valuesFrom pwm:DataClassificationScheme .
pwm:validatorStatus pwm:valuesFrom pwm:ValidatorStatusScheme .

pwm:sustainabilityPreferenceKind pwm:valuesFrom pwm:SustainabilityPreferenceScheme .

# PWM 0.3: roadmap milestone 0.3, Gateways, the Run and Replay

pwm:Run a owl:Class ; rdfs:label "run"@en ;
    skos:definition "Governed execution grouping calls across agent steps, budget snapshots, pending approvals and lifecycle transitions."@en ; rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:RunBudget a owl:Class ; rdfs:label "run budget"@en ;
    skos:definition "Limits and consumption snapshot for one run. Cost is USD; wall clock is seconds. Evidence records successive snapshots rather than overwriting history."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:BudgetExceededDenial a owl:Class ; rdfs:label "budget exceeded denial"@en ;
    skos:definition "Denial caused by an exceeded run budget, naming the budget and breached dimension."@en ; rdfs:subClassOf pwm:PolicyDecision ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:ApprovalRequest a owl:Class ; rdfs:label "approval request"@en ;
    skos:definition "Request to a human to approve an exact held policy decision at a run checkpoint."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(a) to (d): human oversight" ] .

pwm:RunCheckpoint a owl:Class ; rdfs:label "run checkpoint"@en ;
    skos:definition "Durable snapshot at a synchronous policy evaluation boundary; contentHash is the continuation handle in the retention store."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(a) to (d): human oversight" ] .

pwm:ApprovalResolution a owl:Class ; rdfs:label "approval resolution"@en ;
    skos:definition "Human resolution of a specific approval request, approved or denied, with attribution and time."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(a) to (d): human oversight" ] .

pwm:RunResumption a owl:Class ; rdfs:label "run resumption"@en ;
    skos:definition "Evidenced continuation of a checkpointed run after a human resolution; denied resolutions never authorize the held action."@en ; rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(a) to (d): human oversight" ] .

pwm:GovernedCall a owl:Class ; rdfs:label "governed call"@en ;
    skos:definition "Gateway call carrying a run, policy decision and identity bound to authenticated client configuration."@en ; rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ModelCall a owl:Class ; rdfs:label "model call"@en ;
    skos:definition "Gateway model invocation recording provider-reported identity, prompt as sent and response as received, template version and token usage."@en ; rdfs:subClassOf pwm:GovernedCall ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ToolCall a owl:Class ; rdfs:label "tool call"@en ;
    skos:definition "Governed tool invocation with response hash and retained response reference."@en ; rdfs:subClassOf pwm:GovernedCall ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:MCPProxiedCall a owl:Class ; rdfs:label "MCP proxied call"@en ;
    skos:definition "Tool invocation mediated by the MCP proxy, recording backend and invoked tool."@en ; rdfs:subClassOf pwm:ToolCall ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 5" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:EnvelopeAttribute a owl:Class ; rdfs:label "envelope attribute"@en ;
    skos:definition "Recorded request or response attribute, with name, value and typed or classifier-derived source. Typed values are authoritative; classification fills gaps and may only narrow permission. Authentication supplies identity."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ClassifierOutput a owl:Class ; rdfs:label "classifier output"@en ;
    skos:definition "Calibrated classifier evidence with model identifier, version, label, confidence and input hash. Replay uses the recorded label without invoking the classifier."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:PolicyCheck a owl:Class ; rdfs:label "policy check"@en ;
    skos:definition "Individual rule evaluation, pinning the evaluated policy row content hash; a policy decision may contain several checks."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:RetrievedItem a owl:Class ; rdfs:label "retrieved item"@en ;
    skos:definition "Retrieved source snapshot with content hash and embedding model identity."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:RetentionEntry a owl:Class ; rdfs:label "retention entry"@en ;
    skos:definition "Content-addressed retention store entry, separate from chain evidence. Erasure removes content but preserves its hash and erasure evidence."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:RetentionPolicy a owl:Class ; rdfs:label "retention policy"@en ;
    skos:definition "Per-use-case policy for how long source snapshots, prompts and responses are retained, subject to lawful erasure."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ErasureEvent a owl:Class ; rdfs:label "erasure event"@en ;
    skos:definition "Erasure of retained content, recording its hash on the surviving evidence chain."@en ; rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ReconstructionReport a owl:Class ; rdfs:label "reconstruction report"@en ;
    skos:definition "Report for an interaction verifying chain and pinned hashes, listing findings and explicitly covering all ten supervisory questions, including not recorded answers."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:ReconstructionFinding a owl:Class ; rdfs:label "reconstruction finding"@en ;
    skos:definition "Finding from reconstruction, including hash mismatch, affected record, expected hash and observed hash."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:QuestionCoverage a owl:Class ; rdfs:label "question coverage"@en ;
    skos:definition "Answer status for exactly one supervisory reconstruction question; absent evidence is explicitly not recorded."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): record keeping; 5.17: reproducibility" ] .

pwm:AuthenticatedClientConfiguration a owl:Class ; rdfs:label "authenticated client configuration"@en ;
    skos:definition "Authenticated gateway client configuration binding permitted agent names and listed system triggers."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 Tier 0" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:SystemTrigger a owl:Class ; rdfs:label "system trigger"@en ;
    skos:definition "Listed authenticated system identity admitted for calls without an agent; still subject to purpose, use-case, policy and budget checks."@en ; rdfs:subClassOf prov:Agent ;
    pwm:inModule pwm:ModuleEvidence ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.3 Tier 0" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.3 gateway and replay records: NEW specialised record or property; no exact standard term identified" ] .

pwm:hasBudget a owl:ObjectProperty ; rdfs:label "has budget"@en ; skos:definition "Budget snapshot applied to a run."@en ;
