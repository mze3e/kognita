pwm:PolicyCheck pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 14: the rule and rule version that decided it" ] .
pwm:SystemTrigger pwm:citation [ pwm:cites pwmref:W3C-PROV-O ; pwm:locator "Section 3.1: Agent" ] .

# PWM 0.4: missing ingestion, declarative policy and lifecycle records.
# Versioned policy artefacts and breaker configuration are SlowContext.
# Recorded evidence and review state are MediumContext; FastContext is reserved for live data.
pwm:ModuleLifecycle a pwm:Module ; rdfs:label "Ingestion, policy and lifecycle controls"@en ; pwm:moduleOrder 10 ; skos:definition "Structured ingestion and the missing policy, review and monitoring records for milestone 0.4."@en .

pwm:IngestedDocument a owl:Class ; rdfs:label "ingested document"@en ;
    skos:definition "Immutable source-file ingestion record identifying the parser and its exact version. Reuses contentHash and versionId."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:DocumentElement a owl:Class ; rdfs:label "document element"@en ;
    skos:definition "Parser-derived passage or structural element of an ingested document, with page, section path, character span, classification and content hash. Parent links preserve the parsed tree."@en ; rdfs:subClassOf pwm:DocumentSection ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:DeclarativePolicy a owl:Class ; rdfs:label "declarative policy"@en ;
    skos:definition "Versioned declarative artefact serialising existing PolicyRule records; not a replacement rule engine."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:PolicyChange a owl:Class ; rdfs:label "policy change"@en ;
    skos:definition "Archived proposed, reviewed, strictly validated and applied delta against a policy version, containing added, modified or removed rule identifiers."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:PolicyTestCase a owl:Class ; rdfs:label "policy test case"@en ;
