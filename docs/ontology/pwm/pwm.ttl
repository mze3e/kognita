# Citations for the context-speed device itself
pwm:contextSpeed pwm:citation
    [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 7: policies change over months, client status over days, prices in seconds" ] .

pwmref:EU-SUSTAINABILITY a pwm:Reference ;
    dcterms:alternative "MiFID sustainability preferences" ;
    dcterms:title "Commission Delegated Regulation (EU) 2021/1253 amending Delegated Regulation (EU) 2017/565" ;
    dcterms:publisher "European Commission" ; dcterms:date "2021-04-21" ;
    rdfs:seeAlso <https://eur-lex.europa.eu/eli/reg_del/2021/1253/oj> ;
    pwm:sourceType pwm:SourceRegulatory ; pwm:jurisdiction "EU" ; pwm:verificationStatus "verified" ;
    skos:note "Verified against EUR-Lex CELEX 32021R1253, EN/ALL text and relationship table on 3 November 2026. Article 1(1) adds Article 2(7)(a)-(c) to 2017/565. Article 1(6)(a)-(f) amends Article 54(2)(a), (5), (9), (10), (12), (13). These are articles of the amended 2017/565, not Articles 2(7) and 54 of 2021/1253. No preference is an explicit PWM recording code, not a fourth statutory category." .

# =============================================================================
#  Module 0: Core patterns
# =============================================================================

pwm:Assessment a owl:Class ;
    rdfs:label "assessment"@en ;
    skos:definition "Dated, attributable record of an evaluation of a party, product, portfolio or AI use case, valid for a period and replaceable by a later assessment."@en ;
    skos:scopeNote "Due diligence, investor classification, risk profile, suitability, product risk rating and AI risk materiality are all assessments. Who assessed it is recorded with prov:wasAttributedTo; when, with prov:generatedAtTime."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleCore ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:citation [ pwm:cites pwmref:W3C-PROV-O ; pwm:locator "prov:Entity, prov:wasAttributedTo, prov:generatedAtTime" ] ,
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Shared pattern for dated evaluations" ] .

pwm:assesses a owl:ObjectProperty ;
    rdfs:label "assesses"@en ;
    skos:definition "Thing an assessment evaluates."@en ;
    rdfs:domain pwm:Assessment ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Core pattern" ] .

pwm:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    skos:definition "Start of the period in which a record, rule or document is in force."@en ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch dcterms:valid ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: effective date as a minimum label" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.3: policy rows effective-dated; 0.6 item 8: standards are effective-dated" ] .

pwm:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    skos:definition "End of the period in which a record, rule or document is in force. Absent while it remains in force."@en ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch dcterms:valid ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 2: created, effective, superseded and expiry dates" ] .

pwm:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    skos:definition "Earlier version that this record, rule or document replaces. The earlier version stays readable for reconstruction but may no longer be used."@en ;
    skos:closeMatch dcterms:replaces ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: what it supersedes, as a minimum label" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 4: house-view change propagation" ] .

pwm:nextReviewDate a owl:DatatypeProperty ;
    rdfs:label "next review date"@en ;
    skos:definition "Date by which a record must be reviewed. Past this date the record is treated as expired."@en ;
    rdfs:range xsd:date ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10: ongoing due diligence" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.11, 4.13: assessments regularly reviewed" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: past its review date, a use case is a DENY" ] .

pwm:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale"@en ;
    skos:definition "Reasons for an assessment or decision, stated as facts and evidence rather than as a bare score."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10: reasons, not scores" ] .

pwm:approvedBy a owl:ObjectProperty ;
    rdfs:label "approved by"@en ;
    skos:definition "Role whose holder approved this record."@en ;
    rdfs:range cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleCore ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.13: control function approves materiality; 5.21: approval body" ] .

# =============================================================================
#  Module 1: Parties, roles and relationships
# =============================================================================

pwm:Client a owl:Class ;
    rdfs:label "client"@en ;
    skos:definition "Role of a party that has, or is establishing, a business relationship with a wealth manager to receive investment, banking, advisory or fiduciary services."@en ;
    rdfs:subClassOf fibo-fnd-pas-pas:Client ;
    pwm:inModule pwm:ModuleParties ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10: customer subject to due diligence" ] .

pwm:IndividualClient a owl:Class ;
    rdfs:label "individual client"@en ;
    skos:definition "Client role played by a natural person."@en ;
    rdfs:subClassOf pwm:Client ,
        [ a owl:Restriction ; owl:onProperty cmns-rlcmp:isPlayedBy ; owl:someValuesFrom fibo-fnd-aap-ppl:Person ] ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10" ] .

pwm:EntityClient a owl:Class ;
    rdfs:label "entity client"@en ;
    skos:definition "Client role played by a legal person or a legal arrangement, such as a company, foundation or trust."@en ;
    rdfs:subClassOf pwm:Client ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10, R.24, R.25" ] .

pwm:Prospect a owl:Class ;
    rdfs:label "prospect"@en ;
    skos:definition "Role of a party a wealth manager is considering or approaching before any business relationship exists."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 11: prospect scoring in fairness reporting" ] ,
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Pre-relationship role" ] .

pwm:ClientRelationship a owl:Class ;
    rdfs:label "client relationship"@en ;
    skos:definition "Business relationship between a wealth manager and one or more clients, booked in a booking centre and covered by named relationship managers for a period."@en ;
    rdfs:subClassOf cmns-pts:Situation ;
    pwm:inModule pwm:ModuleParties ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10: business relationship" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "booking-centre, relationship-manager" ] .

pwm:RelationshipGroup a owl:Class ;
    rdfs:label "relationship group"@en ;
    skos:altLabel "household"@en , "family group"@en ;
    skos:definition "Set of related clients, such as a family, its holding structures and its trusts, managed and reported together."@en ;
    skos:editorialNote "FIBO's Household (IND/EconomicIndicators) is a statistical concept for economic indicators and is not aligned here."@en ;
    pwm:inModule pwm:ModuleParties ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Household and family-group view used in private banking" ] .

pwm:RelationshipManager a owl:Class ;
    rdfs:label "relationship manager"@en ;
    skos:definition "Person responsible for a client relationship on behalf of the wealth manager."@en ;
    rdfs:subClassOf fibo-fbc-pas-caa:RelationshipManager ;
    skos:exactMatch fibo-fbc-pas-caa:RelationshipManager ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "relationship-manager (acting principal equals the named RM); rm-location" ] .

pwm:CoverageAssignment a owl:Class ;
    rdfs:label "coverage assignment"@en ;
    skos:definition "Assignment of a relationship manager or a specialist to a client relationship, in a stated coverage role, for a period."@en ;
    rdfs:subClassOf cmns-pts:Situation ;
    pwm:inModule pwm:ModuleParties ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "relationship-manager" ] ,
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Primary and secondary coverage" ] .

pwm:InvestmentAdviser a owl:Class ;
    rdfs:label "investment adviser"@en ;
    skos:definition "Role of a person who gives investment advice to clients under the wealth manager's licence or registration."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(4): investment advice" ] ,
                 [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Recommendations on investment products" ] .

pwm:ExternalAssetManager a owl:Class ;
    rdfs:label "external asset manager"@en ;
    skos:altLabel "independent asset manager"@en ;
    skos:definition "Independent firm that manages a client's assets booked with the wealth manager, acting under a limited power of attorney granted by the client."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Intermediated private banking model" ] .

pwm:AuthorisedSignatory a owl:Class ;
    rdfs:label "authorised signatory"@en ;
    skos:definition "Person authorised to give instructions on an account or for an entity client, within stated signing rules."@en ;
    rdfs:subClassOf fibo-be-oac-exec:AuthorizedIndividual ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Account mandate and signing authority" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "BE/OwnershipAndControl/Executives/AuthorizedIndividual, Release; master source verified 2026-11-03" ] .

pwm:PowerOfAttorneyHolder a owl:Class ;
    rdfs:label "power of attorney holder"@en ;
    skos:definition "Party authorised by a client, under a power of attorney, to act for the client within the scope that instrument grants."@en ;
    rdfs:subClassOf fibo-be-oac-exec:AuthorizedIndividual ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "General and limited powers of attorney" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "BE/OwnershipAndControl/Executives/AuthorizedIndividual, Release; master source verified 2026-11-03" ] .

pwm:BeneficialOwner a owl:Class ;
    rdfs:label "beneficial owner"@en ;
    skos:definition "Natural person who ultimately owns or controls a client, or on whose behalf a transaction is conducted, including those exercising ultimate effective control over a legal person or arrangement."@en ;
    rdfs:subClassOf fibo-be-oac-cown:BeneficialOwner ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "Glossary: beneficial owner; R.24; R.25" ] ,
                 [ pwm:cites pwmref:MAS-626 ; pwm:locator "Customer due diligence on beneficial owners" ] .

pwm:ControllingPerson a owl:Class ;
    rdfs:label "controlling person"@en ;
    skos:definition "Natural person who exercises control over an entity account holder for tax-reporting purposes; for a trust, the settlor, trustees, protector, beneficiaries and anyone with ultimate effective control."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:closeMatch pwm:BeneficialOwner ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII(D)(6)" ] .

pwm:PoliticallyExposedPerson a owl:Class ;
    rdfs:label "politically exposed person"@en ;
    skos:altLabel "PEP"@en ;
    skos:definition "Role of a person who is or has been entrusted with a prominent public function, or is a family member or close associate of such a person, attracting enhanced due diligence."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12; Glossary: politically exposed persons" ] ,
                 [ pwm:cites pwmref:MAS-626 ; pwm:locator "Politically exposed persons" ] .

pwm:ConnectedParty a owl:Class ;
    rdfs:label "connected party"@en ;
    skos:definition "Party linked to a client by family, business or control, recorded for due diligence and conflict checks."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12: family members and close associates" ] .

pwm:LegalArrangement a owl:Class ;
    rdfs:label "legal arrangement"@en ;
    skos:definition "Express trust or similar arrangement through which assets are held and controlled, treated as a party to the relationship."@en ;
    skos:editorialNote "FIBO models a trust as a legal entity. PWM keeps that alignment and adds this FATF term so trusts and similar arrangements can be handled together."@en ;
    rdfs:subClassOf cmns-pts:Party ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25; Glossary: legal arrangements" ] .

pwm:Trust a owl:Class ;
    rdfs:label "trust"@en ;
    skos:definition "Arrangement in which a settlor places assets under the control of a trustee for the benefit of beneficiaries."@en ;
    rdfs:subClassOf fibo-be-tr-tr:Trust , pwm:LegalArrangement ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25" ] .

pwm:Settlor a owl:Class ;
    rdfs:label "settlor"@en ;
    skos:altLabel "trustor"@en ;
    skos:definition "Party that establishes a trust and places assets into it."@en ;
    rdfs:subClassOf fibo-be-tr-tr:Trustor ;
    skos:exactMatch fibo-be-tr-tr:Trustor ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25" ] , [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII(D)(6)" ] .

pwm:Trustee a owl:Class ;
    rdfs:label "trustee"@en ;
    skos:definition "Party that holds and manages trust assets for the beneficiaries."@en ;
    rdfs:subClassOf fibo-be-tr-tr:Trustee ;
    skos:exactMatch fibo-be-tr-tr:Trustee ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25" ] .

pwm:TrustBeneficiary a owl:Class ;
    rdfs:label "trust beneficiary"@en ;
    skos:definition "Party, or class of parties, for whose benefit a trust holds assets."@en ;
    rdfs:subClassOf fibo-be-tr-tr:TrustBeneficiary ;
    skos:exactMatch fibo-be-tr-tr:TrustBeneficiary ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25" ] .

pwm:Protector a owl:Class ;
    rdfs:label "protector"@en ;
    skos:definition "Party appointed under a trust instrument to oversee the trustee, often with powers of consent or removal."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.25" ] , [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII(D)(6)" ] .

pwm:Foundation a owl:Class ;
    rdfs:label "private foundation"@en ;
    skos:definition "Legal person, without shareholders, established to hold and administer assets for stated purposes or beneficiaries."@en ;
    rdfs:subClassOf cmns-org:LegalEntity ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.24: legal persons" ] ,
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "No FIBO class for foundations at the version checked" ] .

pwm:PrivateInvestmentCompany a owl:Class ;
    rdfs:label "private investment company"@en ;
    skos:definition "Company formed to hold the investments of an individual or family, usually with no operating business."@en ;
    rdfs:subClassOf cmns-org:LegalEntity ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Personal holding structure" ] , [ pwm:cites pwmref:FATF ; pwm:locator "R.24" ] .

pwm:FamilyOffice a owl:Class ;
    rdfs:label "family office"@en ;
    skos:definition "Organisation that administers and manages the affairs and wealth of one or more families."@en ;
    rdfs:subClassOf fibo-be-fct-fct:FamilyOffice ;
    skos:exactMatch fibo-be-fct-fct:FamilyOffice ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Client or intermediary" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "BE/FunctionalEntities/FunctionalEntities/FamilyOffice, Release; master source verified 2026-11-03" ] .

pwm:WealthManager a owl:Class ;
    rdfs:label "wealth manager"@en ;
    skos:definition "Financial service provider that delivers wealth management services: advice, portfolio management, custody, lending and planning."@en ;
    rdfs:subClassOf fibo-fbc-pas-fpas:FinancialServiceProvider ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:ISO-22222 ; pwm:locator "Scope of personal financial planning" ] .

pwm:PrivateBank a owl:Class ;
    rdfs:label "private bank"@en ;
    skos:definition "Bank that delivers wealth management services to high-net-worth clients."@en ;
    rdfs:subClassOf fibo-fbc-fct-fse:Bank , pwm:WealthManager ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:SG-BANKING-ACT ; pwm:locator "s47: customer information may be disclosed only as the Act provides" ] .

pwm:WealthManagementService a owl:Class ;
    rdfs:label "wealth management service"@en ;
    skos:definition "Service combining investment advice or portfolio management with planning, custody, credit and estate services for a client."@en ;
    rdfs:subClassOf fibo-fbc-fct-fse:WealthManagementService ;
    skos:exactMatch fibo-fbc-fct-fse:WealthManagementService ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:ISO-22222 ; pwm:locator "Personal financial planning process" ] .

pwm:BookingCentre a owl:Class ;
    rdfs:label "booking centre"@en ;
    skos:definition "Role of a legal entity or branch of a wealth manager in which client accounts, contracts and assets are booked, and whose jurisdiction's rules apply to them."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "booking-centre: recognised booking centres" ] ,
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Booking model" ] .

pwm:Custodian a owl:Class ;
    rdfs:label "custodian"@en ;
    skos:definition "Financial institution that holds clients' securities for safekeeping."@en ;
    rdfs:subClassOf fibo-sec-eq-eq:Custodian ;
    skos:exactMatch fibo-sec-eq-eq:Custodian ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Custody chain" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "SEC/Equities/EquityInstruments/Custodian, Release; master source verified 2026-11-03" ] .

# --- Properties ------------------------------------------------------------------

pwm:hasClient a owl:ObjectProperty ;
    rdfs:label "has client"@en ;
    skos:definition "Client in a client relationship."@en ;
    rdfs:domain pwm:ClientRelationship ; rdfs:range pwm:Client ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10" ] .

pwm:hasProvider a owl:ObjectProperty ;
    rdfs:label "has provider"@en ;
    skos:definition "Wealth manager in a client relationship."@en ;
    rdfs:domain pwm:ClientRelationship ; rdfs:range pwm:WealthManager ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Relationship pattern" ] .

pwm:isBookedAt a owl:ObjectProperty ;
    rdfs:label "is booked at"@en ;
    skos:definition "Booking centre in which a relationship, account or contract is booked."@en ;
    rdfs:range pwm:BookingCentre ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "booking-centre" ] .

pwm:inGroup a owl:ObjectProperty ;
    rdfs:label "in group"@en ;
    skos:definition "Relationship group a client belongs to."@en ;
    rdfs:domain pwm:Client ; rdfs:range pwm:RelationshipGroup ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Household view" ] .

pwm:assignedCoverage a owl:ObjectProperty ;
    rdfs:label "assigned coverage"@en ;
    skos:definition "Party role named in a coverage assignment: a relationship manager, or a product, credit, investment or planning specialist. The coverage role says which."@en ;
    rdfs:domain pwm:CoverageAssignment ; rdfs:range cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Coverage model" ] .

pwm:assignedRelationshipManager a owl:ObjectProperty ;
    rdfs:label "assigned relationship manager"@en ;
    skos:definition "Relationship manager named in a coverage assignment. Specialists are named with the parent property, assigned coverage."@en ;
    rdfs:subPropertyOf pwm:assignedCoverage ;
    rdfs:domain pwm:CoverageAssignment ; rdfs:range pwm:RelationshipManager ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "relationship-manager" ] .

pwm:coversRelationship a owl:ObjectProperty ;
    rdfs:label "covers relationship"@en ;
    skos:definition "Client relationship that a coverage assignment covers."@en ;
    rdfs:domain pwm:CoverageAssignment ; rdfs:range pwm:ClientRelationship ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "relationship-manager" ] .

pwm:coverageRole a owl:ObjectProperty ;
    rdfs:label "coverage role"@en ;
    skos:definition "Role of the assignee in a coverage assignment: primary, secondary or specialist."@en ;
    rdfs:domain pwm:CoverageAssignment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Coverage model" ] .

pwm:hasBeneficialOwner a owl:ObjectProperty ;
    rdfs:label "has beneficial owner"@en ;
    skos:definition "Beneficial owner of a client, entity or account."@en ;
    rdfs:range pwm:BeneficialOwner ;
    skos:closeMatch fibo-be-oac-cown:hasBeneficialOwner ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10, R.24, R.25" ] .

pwm:pepCategory a owl:ObjectProperty ;
    rdfs:label "PEP category"@en ;
    skos:definition "Kind of politically exposed person."@en ;
    rdfs:domain pwm:PoliticallyExposedPerson ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12" ] .

pwm:connectedTo a owl:ObjectProperty ;
    rdfs:label "connected to"@en ;
    skos:definition "Client or party that a connected party is linked to."@en ;
    rdfs:domain pwm:ConnectedParty ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12" ] .

pwm:residenceCountry a owl:DatatypeProperty ;
    rdfs:label "residence country"@en ;
    skos:definition "Country where a natural person resides, as an ISO 3166-1 alpha-2 code."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:ISO-3166 ; pwm:locator "Alpha-2 codes" ] , [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-domicile" ] .

pwm:domicileCountry a owl:DatatypeProperty ;
    rdfs:label "domicile country"@en ;
    skos:definition "Country of a party's domicile, as an ISO 3166-1 alpha-2 code. Drives cross-border rules."@en ;
    rdfs:range xsd:string ;
    skos:closeMatch cmns-org:isDomiciledIn ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:ISO-3166 ; pwm:locator "Alpha-2 codes" ] , [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-domicile: recognised domiciles" ] .

pwm:nationalityCountry a owl:DatatypeProperty ;
    rdfs:label "nationality country"@en ;
    skos:definition "Country of a natural person's nationality, as an ISO 3166-1 alpha-2 code."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleParties ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:ISO-3166 ; pwm:locator "Alpha-2 codes" ] .

pwm:jurisdictionCode a owl:DatatypeProperty ;
    rdfs:label "jurisdiction code"@en ;
    skos:definition "Jurisdiction of a booking centre, rule or use case, as an ISO 3166-1 alpha-2 code."@en ;
    rdfs:range xsd:string ;
    skos:closeMatch cmns-rga:hasJurisdiction ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:ISO-3166 ; pwm:locator "Alpha-2 codes" ] , [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "booking-centre, rm-location" ] .

pwm:legalEntityIdentifier a owl:DatatypeProperty ;
    rdfs:label "legal entity identifier"@en ;
    skos:altLabel "LEI"@en ;
    skos:definition "Twenty-character ISO 17442 identifier of a legal entity."@en ;
    rdfs:range xsd:string ;
    skos:closeMatch fibo-be-le-lei:LegalEntityIdentifier ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:ISO-17442 ; pwm:locator "LEI code structure" ] .

# --- Concept schemes ---------------------------------------------------------------

pwm:CoverageRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "coverage roles"@en ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Coverage model" ] .
pwm:CoveragePrimary a skos:Concept ; skos:inScheme pwm:CoverageRoleScheme ; skos:topConceptOf pwm:CoverageRoleScheme ;
    skos:prefLabel "primary"@en ; skos:definition "Lead relationship manager, accountable for the relationship."@en .
pwm:CoverageSecondary a skos:Concept ; skos:inScheme pwm:CoverageRoleScheme ; skos:topConceptOf pwm:CoverageRoleScheme ;
    skos:prefLabel "secondary"@en ; skos:definition "Backup relationship manager."@en .
pwm:CoverageSpecialist a skos:Concept ; skos:inScheme pwm:CoverageRoleScheme ; skos:topConceptOf pwm:CoverageRoleScheme ;
    skos:prefLabel "specialist"@en ; skos:definition "Product, credit, investment or planning specialist supporting the relationship."@en .

pwm:PEPCategoryScheme a skos:ConceptScheme ;
    skos:prefLabel "politically exposed person categories"@en ;
    pwm:inModule pwm:ModuleParties ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12; Glossary" ] .
pwm:ForeignPEP a skos:Concept ; skos:inScheme pwm:PEPCategoryScheme ; skos:topConceptOf pwm:PEPCategoryScheme ;
    skos:prefLabel "foreign PEP"@en ; skos:definition "Entrusted with a prominent public function by a foreign country."@en .
pwm:DomesticPEP a skos:Concept ; skos:inScheme pwm:PEPCategoryScheme ; skos:topConceptOf pwm:PEPCategoryScheme ;
    skos:prefLabel "domestic PEP"@en ; skos:definition "Entrusted domestically with a prominent public function."@en .
pwm:InternationalOrganisationPEP a skos:Concept ; skos:inScheme pwm:PEPCategoryScheme ; skos:topConceptOf pwm:PEPCategoryScheme ;
    skos:prefLabel "international organisation PEP"@en ; skos:definition "Entrusted with a prominent function by an international organisation."@en .
pwm:PEPFamilyMember a skos:Concept ; skos:inScheme pwm:PEPCategoryScheme ; skos:topConceptOf pwm:PEPCategoryScheme ;
    skos:prefLabel "family member of a PEP"@en ; skos:definition "Related to a PEP by blood or marriage."@en .
pwm:PEPCloseAssociate a skos:Concept ; skos:inScheme pwm:PEPCategoryScheme ; skos:topConceptOf pwm:PEPCategoryScheme ;
    skos:prefLabel "close associate of a PEP"@en ; skos:definition "Closely connected to a PEP, socially or professionally."@en .

# =============================================================================
#  Module 2: Due diligence, financial crime and tax
# =============================================================================

pwm:CustomerDueDiligence a owl:Class ;
    rdfs:label "customer due diligence"@en ;
    skos:altLabel "CDD"@en , "KYC"@en ;
    skos:definition "Assessment that identifies and verifies a client and its beneficial owners, and establishes the purpose and intended nature of the relationship."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10" ] , [ pwm:cites pwmref:MAS-626 ; pwm:locator "Customer due diligence" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "kyc-onboarding: prepared by the agent, approved by a person" ] .

pwm:EnhancedDueDiligence a owl:Class ;
    rdfs:label "enhanced due diligence"@en ;
    skos:altLabel "EDD"@en ;
    skos:definition "Customer due diligence with additional measures, applied where the client presents higher risk, such as a politically exposed person."@en ;
    rdfs:subClassOf pwm:CustomerDueDiligence ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10, R.12" ] , [ pwm:cites pwmref:MAS-626 ; pwm:locator "Enhanced customer due diligence" ] .

pwm:PeriodicReview a owl:Class ;
    rdfs:label "periodic review"@en ;
    skos:definition "Scheduled re-assessment of a client's due diligence, at a frequency set by the client's risk rating, or earlier on a trigger event."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.10: ongoing due diligence" ] .

pwm:CustomerRiskRating a owl:Class ;
    rdfs:label "customer risk rating"@en ;
    skos:definition "Assessment of the money-laundering and terrorist-financing risk a client presents, which sets due diligence depth and review frequency."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.1: risk-based approach; R.10" ] , [ pwm:cites pwmref:MAS-626 ; pwm:locator "Risk assessment" ] .

pwm:SourceOfWealthAssessment a owl:Class ;
    rdfs:label "source of wealth assessment"@en ;
    skos:definition "Assessment of how a client accumulated their total wealth, with the evidence relied on."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12: establish the source of wealth" ] , [ pwm:cites pwmref:MAS-626 ; pwm:locator "Source of wealth" ] .

pwm:SourceOfFundsAssessment a owl:Class ;
    rdfs:label "source of funds assessment"@en ;
    skos:definition "Assessment of where specific funds or assets entering the relationship come from."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.12: establish the source of funds" ] , [ pwm:cites pwmref:MAS-626 ; pwm:locator "Source of funds" ] .

pwm:ScreeningResult a owl:Class ;
    rdfs:label "screening result"@en ;
    skos:definition "Outcome of screening a party against sanctions, politically exposed person and adverse-media sources, with its disposition."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.6, R.7: targeted financial sanctions; R.12" ] .

pwm:TaxResidencySelfCertification a owl:Class ;
    rdfs:label "tax residency self-certification"@en ;
    skos:definition "Client's declaration of tax residence countries and taxpayer identification numbers, collected at account opening and on change of circumstances."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Sections IV and VI: self-certification for new accounts; Section VIII: definitions" ] .

pwm:amlRiskLevel a owl:ObjectProperty ;
    rdfs:label "AML risk level"@en ;
    skos:definition "Level of a customer risk rating."@en ;
    rdfs:domain pwm:CustomerRiskRating ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.1" ] .

pwm:screeningDisposition a owl:ObjectProperty ;
    rdfs:label "screening disposition"@en ;
    skos:definition "How a screening alert was resolved."@en ;
    rdfs:domain pwm:ScreeningResult ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Alert disposition" ] .

pwm:taxResidenceCountry a owl:DatatypeProperty ;
    rdfs:label "tax residence country"@en ;
    skos:definition "Country of tax residence declared in a self-certification, as an ISO 3166-1 alpha-2 code."@en ;
    rdfs:domain pwm:TaxResidencySelfCertification ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII" ] , [ pwm:cites pwmref:ISO-3166 ; pwm:locator "Alpha-2 codes" ] .

pwm:hasTaxIdentifier a owl:ObjectProperty ;
    rdfs:label "has tax identifier"@en ;
    skos:definition "Taxpayer identification number declared in a self-certification."@en ;
    rdfs:domain pwm:TaxResidencySelfCertification ; rdfs:range fibo-fnd-pty-pty:TaxIdentifier ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII: TIN" ] .

pwm:AMLRiskLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "AML risk levels"@en ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:FATF ; pwm:locator "R.1, R.10" ] .
pwm:AMLLow a skos:Concept ; skos:inScheme pwm:AMLRiskLevelScheme ; skos:topConceptOf pwm:AMLRiskLevelScheme ; skos:notation "L" ;
    skos:prefLabel "low"@en ; skos:definition "Simplified measures may apply where permitted."@en .
pwm:AMLMedium a skos:Concept ; skos:inScheme pwm:AMLRiskLevelScheme ; skos:topConceptOf pwm:AMLRiskLevelScheme ; skos:notation "M" ;
    skos:prefLabel "medium"@en ; skos:definition "Standard due diligence."@en .
pwm:AMLHigh a skos:Concept ; skos:inScheme pwm:AMLRiskLevelScheme ; skos:topConceptOf pwm:AMLRiskLevelScheme ; skos:notation "H" ;
    skos:prefLabel "high"@en ; skos:definition "Enhanced due diligence and senior approval."@en .
pwm:AMLOutsideAppetite a skos:Concept ; skos:inScheme pwm:AMLRiskLevelScheme ; skos:topConceptOf pwm:AMLRiskLevelScheme ; skos:notation "X" ;
    skos:prefLabel "outside risk appetite"@en ; skos:definition "Relationship declined or exited."@en .

pwm:ScreeningDispositionScheme a skos:ConceptScheme ;
    skos:prefLabel "screening dispositions"@en ;
    pwm:inModule pwm:ModuleCompliance ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Alert disposition" ] .
pwm:ScreeningPending a skos:Concept ; skos:inScheme pwm:ScreeningDispositionScheme ; skos:topConceptOf pwm:ScreeningDispositionScheme ;
    skos:prefLabel "pending review"@en ; skos:definition "Alert raised, not yet reviewed."@en .
pwm:ScreeningFalsePositive a skos:Concept ; skos:inScheme pwm:ScreeningDispositionScheme ; skos:topConceptOf pwm:ScreeningDispositionScheme ;
    skos:prefLabel "false positive"@en ; skos:definition "Reviewed; not the listed party."@en .
pwm:ScreeningTrueMatch a skos:Concept ; skos:inScheme pwm:ScreeningDispositionScheme ; skos:topConceptOf pwm:ScreeningDispositionScheme ;
    skos:prefLabel "true match"@en ; skos:definition "Reviewed; confirmed as the listed party."@en .
pwm:ScreeningEscalated a skos:Concept ; skos:inScheme pwm:ScreeningDispositionScheme ; skos:topConceptOf pwm:ScreeningDispositionScheme ;
    skos:prefLabel "escalated"@en ; skos:definition "Referred to compliance for decision."@en .

# =============================================================================
#  Module 3: Investor profile and suitability
# =============================================================================

pwm:InvestorClassification a owl:Class ;
    rdfs:label "investor classification"@en ;
    skos:definition "Regulatory categorisation of a client under one jurisdiction's rules, such as retail, professional or accredited, with any opt-in or opt-out recorded."@en ;
    skos:editorialNote "FIBO models qualified-investor and domicile restrictions on the instrument side (SecuritiesRestrictions). This class records the client side of the same test."@en ;
    rdfs:subClassOf pwm:Assessment ;
    skos:relatedMatch fibo-sec-sec-rst:QualifiedInvestorRestriction ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:SG-SFA ; pwm:locator "s4A; opt-in regime for accredited investors" ] ,
                 [ pwm:cites pwmref:HK-SFC-COC ; pwm:locator "para 15" ] , [ pwm:cites pwmref:HK-PI-RULES ; pwm:locator "Professional investor tests" ] ,
                 [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 4 (client segmentation), Art. 5 (opting out and opting in)" ] ,
                 [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Annex II (professional clients); Art. 30 (eligible counterparties)" ] ,
                 [ pwm:cites pwmref:UK-FCA-COBS ; pwm:locator "COBS 3" ] , [ pwm:cites pwmref:US-REG-D ; pwm:locator "Rule 501(a)" ] .

pwm:InvestorRiskProfile a owl:Class ;
    rdfs:label "investor risk profile"@en ;
    skos:definition "Versioned assessment of a client's risk tolerance, capacity for loss and investment horizon, expressed on the wealth manager's risk scale."@en ;
    skos:scopeNote "Each change produces a new version that supersedes the last. A suitability assessment cites the version in force at the time."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2): investment objectives including risk tolerance" ] ,
                 [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] , [ pwm:cites pwmref:HK-SFC-COC ; pwm:locator "para 5.2" ] ,
                 [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 10 to 14" ] , [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Know-your-customer information" ] ,
                 [ pwm:cites pwmref:ISO-22222 ; pwm:locator "Gathering client information" ] .

pwm:KnowledgeAndExperienceAssessment a owl:Class ;
    rdfs:label "knowledge and experience assessment"@en ;
    skos:definition "Assessment of whether a client understands the risks of a type of product or service, from education, work and past investments."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2), 25(3)" ] , [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 55" ] ,
                 [ pwm:cites pwmref:MAS-SFA04-N12 ; pwm:locator "Assessment of customer knowledge and experience for specified investment products" ] ,
                 [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Assessment of customer knowledge and experience for specified investment products" ] .

pwm:FinancialSituationAssessment a owl:Class ;
    rdfs:label "financial situation assessment"@en ;
    skos:definition "Assessment of a client's income, assets, liabilities and liquidity needs, including the ability to bear losses."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2): financial situation including ability to bear losses" ] ,
                 [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] .

pwm:InvestmentObjective a owl:Class ;
    rdfs:label "investment objective"@en ;
    skos:definition "Financial objective a client states for their investments, used to judge whether an investment is appropriate for them."@en ;
    rdfs:subClassOf fibo-fnd-gao-obj:InvestmentObjective ;
    skos:exactMatch fibo-fnd-gao-obj:InvestmentObjective ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2)" ] .

pwm:SuitabilityAssessment a owl:Class ;
    rdfs:label "suitability assessment"@en ;
    skos:definition "Determination, before a recommendation or a discretionary decision, that a product or transaction fits the client's objectives, including any sustainability preferences, financial situation, and knowledge and experience, within the mandate."@en ;
    skos:scopeNote "Origination records why a client or product was proposed. Suitability records why it was permitted. Keep them separate."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2)" ] , [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] ,
                 [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Know-your-customer and suitability of recommendations" ] , [ pwm:cites pwmref:HK-SFC-COC ; pwm:locator "para 5.2" ] ,
                 [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 10 to 14" ] , [ pwm:cites pwmref:US-REG-BI ; pwm:locator "Care obligation" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10: origination says why proposed; suitability says why permitted" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "suitability: the pack requires the flag and does not compute suitability" ] .

pwm:AppropriatenessAssessment a owl:Class ;
    rdfs:label "appropriateness assessment"@en ;
    skos:definition "Check, for services without advice, that a client has the knowledge and experience to understand the risks of the product."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(3)" ] , [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 56" ] ,
                 [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 10 to 14" ] , [ pwm:cites pwmref:UK-FCA-COBS ; pwm:locator "COBS 10A" ] .

pwm:SuitabilityReport a owl:Class ;
    rdfs:label "suitability report"@en ;
    skos:definition "Statement given to the client explaining how advice meets their preferences, objectives and other characteristics."@en ;
    rdfs:subClassOf cmns-doc:Document ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(6)" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "suitability-report: a draft from a meeting transcript needs a person before use" ] .

pwm:ClientAcknowledgement a owl:Class ;
    rdfs:label "client acknowledgement"@en ;
    skos:definition "Record that a client received, read or accepted a disclosure, risk warning or document, and when."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Evidence of disclosure" ] .

pwm:investorCategory a owl:ObjectProperty ;
    rdfs:label "investor category"@en ;
    skos:definition "Category assigned by an investor classification."@en ;
    rdfs:domain pwm:InvestorClassification ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:SG-SFA ; pwm:locator "s4A" ] , [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 4" ] .

pwm:optStatus a owl:ObjectProperty ;
    rdfs:label "opt status"@en ;
    skos:definition "Whether the classification is the default, or results from the client opting in or out."@en ;
    rdfs:domain pwm:InvestorClassification ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:SG-SFA ; pwm:locator "Opt-in regime" ] , [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 5" ] .

pwm:riskProfileLevel a owl:ObjectProperty ;
    rdfs:label "risk profile level"@en ;
    skos:definition "Point on the wealth manager's risk scale assigned by a risk profile."@en ;
    rdfs:domain pwm:InvestorRiskProfile ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] .

pwm:capacityForLoss a owl:ObjectProperty ;
    rdfs:label "capacity for loss"@en ;
    skos:definition "Client's ability to bear losses without a material change to their standard of living or objectives."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2): ability to bear losses" ] .

pwm:investmentHorizonYears a owl:DatatypeProperty ;
    rdfs:label "investment horizon (years)"@en ;
    skos:definition "Length of time, in years, the client intends to hold the investments."@en ;
    rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] .

pwm:suitabilityOutcome a owl:ObjectProperty ;
    rdfs:label "suitability outcome"@en ;
    skos:definition "Result of a suitability or appropriateness assessment."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2), 25(3)" ] .

pwm:assessesRecommendation a owl:ObjectProperty ;
    rdfs:label "assesses recommendation"@en ;
    skos:definition "Recommendation that a suitability assessment evaluates."@en ;
    rdfs:subPropertyOf pwm:assesses ;
    rdfs:domain pwm:SuitabilityAssessment ; rdfs:range pwm:Recommendation ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10" ] .

pwm:usesRiskProfile a owl:ObjectProperty ;
    rdfs:label "uses risk profile"@en ;
    skos:definition "Version of the client's risk profile in force when the assessment was made."@en ;
    rdfs:domain pwm:SuitabilityAssessment ; rdfs:range pwm:InvestorRiskProfile ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2-DR ; pwm:locator "Art. 54" ] .

pwm:usesMandate a owl:ObjectProperty ;
    rdfs:label "uses mandate"@en ;
    skos:definition "Mandate whose terms and restrictions the assessment was checked against."@en ;
    rdfs:domain pwm:SuitabilityAssessment ; rdfs:range pwm:Mandate ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "mandate" ] .

pwm:usesProductRiskRating a owl:ObjectProperty ;
    rdfs:label "uses product risk rating"@en ;
    skos:definition "Product risk rating in force when the assessment was made."@en ;
    rdfs:domain pwm:SuitabilityAssessment ; rdfs:range pwm:ProductRiskRating ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 24(2)" ] .

pwm:InvestorCategoryScheme a skos:ConceptScheme ;
    skos:prefLabel "investor categories"@en ;
    skos:scopeNote "Two generic top concepts, retail and non-retail, with jurisdiction-specific categories beneath them. Thresholds stay in each jurisdiction's rules, not in the ontology."@en ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:SG-SFA ; pwm:locator "s4A" ] , [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 4" ] ,
                 [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Annex II; Art. 30" ] , [ pwm:cites pwmref:UK-FCA-COBS ; pwm:locator "COBS 3" ] ,
                 [ pwm:cites pwmref:HK-PI-RULES ; pwm:locator "Professional investor" ] , [ pwm:cites pwmref:US-REG-D ; pwm:locator "Rule 501(a)" ] .
pwm:RetailCategory a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:topConceptOf pwm:InvestorCategoryScheme ;
    skos:prefLabel "retail"@en ; skos:definition "Client given the full protections of the jurisdiction's conduct rules."@en .
pwm:NonRetailCategory a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:topConceptOf pwm:InvestorCategoryScheme ;
    skos:prefLabel "non-retail"@en ; skos:definition "Client treated as able to bear more risk, with some protections relaxed."@en .
pwm:RetailInvestorSG a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:RetailCategory ;
    skos:prefLabel "retail investor (SG)"@en ; skos:definition "Not an accredited, expert or institutional investor under the Securities and Futures Act."@en .
pwm:AccreditedInvestorSG a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "accredited investor (SG)"@en ; skos:definition "Accredited investor under s4A of the Securities and Futures Act, subject to the opt-in regime."@en .
pwm:ExpertInvestorSG a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "expert investor (SG)"@en ; skos:definition "Expert investor under s4A of the Securities and Futures Act."@en .
pwm:InstitutionalInvestorSG a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "institutional investor (SG)"@en ; skos:definition "Institutional investor under s4A of the Securities and Futures Act."@en .
pwm:ProfessionalInvestorHK a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "professional investor (HK)"@en ; skos:definition "Professional investor under the Securities and Futures Ordinance and the Professional Investor Rules."@en .
pwm:PrivateClientCH a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:RetailCategory ;
    skos:prefLabel "private client (CH)"@en ; skos:definition "Private client under FinSA Art. 4."@en .
pwm:ProfessionalClientCH a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "professional client (CH)"@en ; skos:definition "Professional client under FinSA Art. 4."@en .
pwm:InstitutionalClientCH a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "institutional client (CH)"@en ; skos:definition "Institutional client under FinSA Art. 4."@en .
pwm:RetailClientEU a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:RetailCategory ;
    skos:prefLabel "retail client (EU)"@en ; skos:definition "Client that is not a professional client under MiFID II."@en .
pwm:ProfessionalClientEU a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "professional client (EU)"@en ; skos:definition "Professional client under MiFID II Annex II, per se or on request."@en .
pwm:EligibleCounterpartyEU a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "eligible counterparty (EU)"@en ; skos:definition "Eligible counterparty under MiFID II Art. 30."@en .
pwm:RetailClientUK a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:RetailCategory ;
    skos:prefLabel "retail client (UK)"@en ; skos:definition "Retail client under COBS 3."@en .
pwm:ProfessionalClientUK a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "professional client (UK)"@en ; skos:definition "Professional client under COBS 3."@en .
pwm:AccreditedInvestorUS a skos:Concept ; skos:inScheme pwm:InvestorCategoryScheme ; skos:broader pwm:NonRetailCategory ;
    skos:prefLabel "accredited investor (US)"@en ; skos:definition "Accredited investor under Regulation D, Rule 501(a)."@en .

pwm:OptStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "opt statuses"@en ;
    pwm:inModule pwm:ModuleSuitability ;
    skos:scopeNote "Directions differ by jurisdiction. In Singapore an eligible investor opts in to accredited-investor status and gives up some retail protections. Under FinSA a high-net-worth retail client opts out to be treated as a professional client, and some professional clients opt in to be treated as retail. Record the resulting category on the classification."@en ;
    pwm:citation [ pwm:cites pwmref:SG-SFA ; pwm:locator "Opt-in regime" ] , [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 5" ] .
pwm:OptDefault a skos:Concept ; skos:inScheme pwm:OptStatusScheme ; skos:topConceptOf pwm:OptStatusScheme ;
    skos:prefLabel "default"@en ; skos:definition "Category applies by default, with no election."@en .
pwm:OptedIn a skos:Concept ; skos:inScheme pwm:OptStatusScheme ; skos:topConceptOf pwm:OptStatusScheme ;
    skos:prefLabel "opted in"@en ; skos:definition "Client made an opt-in election under the jurisdiction's rules. Which category that moves the client into, and whether protection rises or falls, depends on the jurisdiction, so record the classification it produced."@en .
pwm:OptedOut a skos:Concept ; skos:inScheme pwm:OptStatusScheme ; skos:topConceptOf pwm:OptStatusScheme ;
    skos:prefLabel "opted out"@en ; skos:definition "Client made an opt-out election under the jurisdiction's rules. Which category that moves the client into, and whether protection rises or falls, depends on the jurisdiction, so record the classification it produced."@en .

pwm:SuitabilityOutcomeScheme a skos:ConceptScheme ;
    skos:prefLabel "suitability outcomes"@en ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(2), 25(3)" ] , [ pwm:cites pwmref:CH-FINSA ; pwm:locator "Art. 10 to 14" ] .
pwm:Suitable a skos:Concept ; skos:inScheme pwm:SuitabilityOutcomeScheme ; skos:topConceptOf pwm:SuitabilityOutcomeScheme ;
    skos:prefLabel "suitable"@en ; skos:definition "Fits the profile and mandate."@en .
pwm:SuitableWithConditions a skos:Concept ; skos:inScheme pwm:SuitabilityOutcomeScheme ; skos:topConceptOf pwm:SuitabilityOutcomeScheme ;
    skos:prefLabel "suitable with conditions"@en ; skos:definition "Fits if stated conditions are met, such as a size limit."@en .
pwm:NotSuitable a skos:Concept ; skos:inScheme pwm:SuitabilityOutcomeScheme ; skos:topConceptOf pwm:SuitabilityOutcomeScheme ;
    skos:prefLabel "not suitable"@en ; skos:definition "Does not fit; may not be recommended."@en .
pwm:InsufficientInformation a skos:Concept ; skos:inScheme pwm:SuitabilityOutcomeScheme ; skos:topConceptOf pwm:SuitabilityOutcomeScheme ;
    skos:prefLabel "insufficient information"@en ; skos:definition "Cannot be assessed; no recommendation may be made."@en .

pwm:IllustrativeRiskScale a skos:ConceptScheme ;
    skos:prefLabel "illustrative risk scale"@en ;
    skos:scopeNote "Placeholder five-point scale. An institution replaces it with its own scale in its extension."@en ;
    pwm:inModule pwm:ModuleSuitability ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Illustrative only" ] .
pwm:RP1 a skos:Concept ; skos:inScheme pwm:IllustrativeRiskScale ; skos:topConceptOf pwm:IllustrativeRiskScale ; skos:notation "RP1" ;
    skos:prefLabel "conservative"@en ; skos:definition "Capital preservation first."@en .
pwm:RP2 a skos:Concept ; skos:inScheme pwm:IllustrativeRiskScale ; skos:topConceptOf pwm:IllustrativeRiskScale ; skos:notation "RP2" ;
    skos:prefLabel "moderately conservative"@en ; skos:definition "Income with limited volatility."@en .
pwm:RP3 a skos:Concept ; skos:inScheme pwm:IllustrativeRiskScale ; skos:topConceptOf pwm:IllustrativeRiskScale ; skos:notation "RP3" ;
    skos:prefLabel "balanced"@en ; skos:definition "Growth and income in balance."@en .
pwm:RP4 a skos:Concept ; skos:inScheme pwm:IllustrativeRiskScale ; skos:topConceptOf pwm:IllustrativeRiskScale ; skos:notation "RP4" ;
    skos:prefLabel "growth"@en ; skos:definition "Growth with higher volatility."@en .
pwm:RP5 a skos:Concept ; skos:inScheme pwm:IllustrativeRiskScale ; skos:topConceptOf pwm:IllustrativeRiskScale ; skos:notation "RP5" ;
    skos:prefLabel "aggressive"@en ; skos:definition "Maximum growth; accepts large drawdowns."@en .

# Sustainability preferences: record the client's choice, including no preference.
pwm:SustainabilityPreference a owl:Class ;
    rdfs:label "sustainability preference"@en ;
    skos:definition "Versioned record of a client's choice of one or more sustainability categories, minimum proportions and PAI elements, or an explicit absence of preference."@en ;
    rdfs:subClassOf prov:Entity ; pwm:inModule pwm:ModuleSuitability ;
    pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    skos:scopeNote "Proportions are decimals from 0 to 1. Categories may be combined; no preference is exclusive. This records preferences and does not certify product sustainability or implement the full Article 54 assessment."@en ;
    pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:usesSustainabilityPreference a owl:ObjectProperty ;
    rdfs:label "uses sustainability preference"@en ;
    skos:definition "Version of the client sustainability preference considered by a suitability assessment."@en ;
    rdfs:domain pwm:SuitabilityAssessment ; rdfs:range pwm:SustainabilityPreference ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:sustainabilityPreferenceKind a owl:ObjectProperty ;
    rdfs:label "sustainability preference kind"@en ;
    skos:definition "One or more client-selected sustainability categories, or explicit no preference."@en ;
    rdfs:domain pwm:SustainabilityPreference ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:minimumTaxonomyAlignedProportion a owl:DatatypeProperty ;
    rdfs:label "minimum taxonomy aligned proportion"@en ;
    skos:definition "Client minimum proportion invested in environmentally sustainable investments under Regulation (EU) 2020/852 Article 2(1), as a fraction from 0 to 1."@en ;
    rdfs:domain pwm:SustainabilityPreference ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:minimumSFDRSustainableProportion a owl:DatatypeProperty ;
    rdfs:label "minimum SFDR sustainable proportion"@en ;
    skos:definition "Client minimum proportion invested in sustainable investments under Regulation (EU) 2019/2088 Article 2(17), as a fraction from 0 to 1."@en ;
    rdfs:domain pwm:SustainabilityPreference ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:paiConsiderationElements a owl:DatatypeProperty ;
    rdfs:label "PAI consideration elements"@en ;
    skos:definition "Client-determined qualitative or quantitative elements demonstrating consideration of principal adverse impacts on sustainability factors."@en ;
    rdfs:domain pwm:SustainabilityPreference ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:SustainabilityPreferenceScheme a skos:ConceptScheme ;
    skos:prefLabel "sustainability preference categories"@en ;
    skos:definition "Three categories under Article 2(7) of 2017/565, plus explicit no preference for recording."@en ;
    pwm:inModule pwm:ModuleSuitability ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:TaxonomyAlignedMinimum a skos:Concept ; skos:inScheme pwm:SustainabilityPreferenceScheme ;
    skos:topConceptOf pwm:SustainabilityPreferenceScheme ;
    skos:prefLabel "taxonomy aligned minimum"@en ; skos:definition "Article 2(7)(a): minimum proportion of environmentally sustainable investments."@en ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:SFDRSustainableMinimum a skos:Concept ; skos:inScheme pwm:SustainabilityPreferenceScheme ;
    skos:topConceptOf pwm:SustainabilityPreferenceScheme ;
    skos:prefLabel "SFDR sustainable minimum"@en ; skos:definition "Article 2(7)(b): minimum proportion of sustainable investments."@en ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:PAIConsideration a skos:Concept ; skos:inScheme pwm:SustainabilityPreferenceScheme ;
    skos:topConceptOf pwm:SustainabilityPreferenceScheme ;
    skos:prefLabel "PAI consideration"@en ; skos:definition "Article 2(7)(c): principal adverse impacts considered using client-determined elements."@en ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

pwm:NoSustainabilityPreference a skos:Concept ; skos:inScheme pwm:SustainabilityPreferenceScheme ;
    skos:topConceptOf pwm:SustainabilityPreferenceScheme ;
    skos:prefLabel "no sustainability preference"@en ; skos:definition "Explicit record that the client has no sustainability preference; not a fourth Article 2(7) category."@en ; pwm:citation [ pwm:cites pwmref:EU-SUSTAINABILITY ; pwm:locator "2021/1253 Art. 1(1), 1(6); 2017/565 Art. 2(7), 54(2)(a), (5), (10)" ] .

# =============================================================================
#  Module 4: Mandates, restrictions and fees
# =============================================================================

pwm:Mandate a owl:Class ;
    rdfs:label "mandate"@en ;
    skos:definition "Written agreement under which a wealth manager serves a client on a stated service model: advisory, discretionary, execution-only or custody-only. Investment restrictions apply where the service model calls for them."@en ;
    rdfs:subClassOf fibo-fnd-agr-ctr:WrittenContract ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(4), 4(1)(8), 25(4)" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "mandate: the discussion must sit inside the recorded mandate" ] .

pwm:AdvisoryMandate a owl:Class ;
    rdfs:label "advisory mandate"@en ;
    skos:definition "Mandate under which the wealth manager makes personal recommendations and the client takes each investment decision."@en ;
    rdfs:subClassOf pwm:Mandate ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(4): investment advice" ] , [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Recommendations" ] .

pwm:DiscretionaryMandate a owl:Class ;
    rdfs:label "discretionary mandate"@en ;
    skos:definition "Mandate under which the wealth manager takes investment decisions for the client within agreed guidelines."@en ;
    rdfs:subClassOf pwm:Mandate ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(8): portfolio management" ] .

pwm:ExecutionOnlyArrangement a owl:Class ;
    rdfs:label "execution-only arrangement"@en ;
    skos:definition "Arrangement under which the wealth manager executes client instructions without advice."@en ;
    rdfs:subClassOf pwm:Mandate ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(4)" ] .

pwm:CustodyOnlyArrangement a owl:Class ;
    rdfs:label "custody-only arrangement"@en ;
    skos:definition "Arrangement under which the wealth manager holds assets and services them, without advice or dealing."@en ;
    rdfs:subClassOf pwm:Mandate ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Custody-only service model" ] .

pwm:InvestmentRestriction a owl:Class ;
    rdfs:label "investment restriction"@en ;
    skos:definition "Provision of a mandate that limits what may be held or done: asset-class bands, concentration limits, excluded issuers or sectors, prohibited instruments, leverage limits."@en ;
    rdfs:subClassOf fibo-fnd-agr-ctr:ContractualCommitment ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "mandate; concentration" ] .

pwm:ConcentrationLimit a owl:Class ;
    rdfs:label "concentration limit"@en ;
    skos:definition "Investment restriction capping exposure to one issuer, sector, country, currency or product type as a share of the portfolio."@en ;
    rdfs:subClassOf pwm:InvestmentRestriction ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "concentration: inside the recorded concentration limit" ] .

pwm:ModelPortfolio a owl:Class ;
    rdfs:label "model portfolio"@en ;
    skos:definition "Target allocation, for a risk profile or strategy, from which client portfolios are built and against which drift is measured."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Model-based portfolio management" ] .

pwm:Benchmark a owl:Class ;
    rdfs:label "benchmark"@en ;
    skos:definition "Index or composite against which a portfolio's performance is evaluated."@en ;
    skos:closeMatch fibo-sec-fund-civ:PortfolioBenchmark ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "FIBO's PortfolioBenchmark is Provisional, so it is matched, not specialised" ] .

pwm:Fee a owl:Class ;
    rdfs:label "fee"@en ;
    skos:definition "Charge for services under a mandate or account, of a stated type."@en ;
    rdfs:subClassOf fibo-fbc-pas-caa:Fee ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 24(4): information on costs and charges" ] .

pwm:ThirdPartyPayment a owl:Class ;
    rdfs:label "third-party payment"@en ;
    skos:altLabel "inducement"@en , "retrocession"@en ;
    skos:definition "Payment or non-monetary benefit the wealth manager receives from a third party, such as a product provider, in connection with a client service. It is not a charge to the client."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 24(9)" ] .

pwm:governedByMandate a owl:ObjectProperty ;
    rdfs:label "governed by mandate"@en ;
    skos:definition "Mandate under which an account or portfolio is managed or advised."@en ;
    rdfs:range pwm:Mandate ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "mandate" ] .

pwm:hasRestriction a owl:ObjectProperty ;
    rdfs:label "has restriction"@en ;
    skos:definition "Investment restriction that forms part of a mandate."@en ;
    rdfs:domain pwm:Mandate ; rdfs:range pwm:InvestmentRestriction ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "mandate; concentration" ] .

pwm:limitValue a owl:DatatypeProperty ;
    rdfs:label "limit value"@en ;
    skos:definition "Numeric limit of a restriction, read together with its limit basis."@en ;
    rdfs:domain pwm:InvestmentRestriction ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "concentration" ] .

pwm:limitBasis a owl:DatatypeProperty ;
    rdfs:label "limit basis"@en ;
    skos:definition "What the limit value is measured against, such as percent of portfolio market value."@en ;
    rdfs:domain pwm:InvestmentRestriction ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Restriction definition" ] .

pwm:feeType a owl:ObjectProperty ;
    rdfs:label "fee type"@en ;
    skos:definition "Kind of fee."@en ;
    rdfs:domain pwm:Fee ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 24(4)" ] .

pwm:targetRiskProfile a owl:ObjectProperty ;
    rdfs:label "target risk profile"@en ;
    skos:definition "Risk profile level a model portfolio or product is designed for."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Model portfolio design" ] .

pwm:hasBenchmark a owl:ObjectProperty ;
    rdfs:label "has benchmark"@en ;
    skos:definition "Benchmark a mandate or portfolio is measured against."@en ;
    rdfs:range pwm:Benchmark ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Performance measurement" ] .

pwm:FeeTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "fee types"@en ;
    pwm:inModule pwm:ModuleMandates ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 24(4)" ] .
pwm:FeeManagement a skos:Concept ; skos:inScheme pwm:FeeTypeScheme ; skos:topConceptOf pwm:FeeTypeScheme ;
    skos:prefLabel "management fee"@en ; skos:definition "For discretionary portfolio management."@en .
pwm:FeeAdvisory a skos:Concept ; skos:inScheme pwm:FeeTypeScheme ; skos:topConceptOf pwm:FeeTypeScheme ;
    skos:prefLabel "advisory fee"@en ; skos:definition "For advice under an advisory mandate."@en .
pwm:FeeCustody a skos:Concept ; skos:inScheme pwm:FeeTypeScheme ; skos:topConceptOf pwm:FeeTypeScheme ;
    skos:prefLabel "custody fee"@en ; skos:definition "For safekeeping and servicing of assets."@en .
pwm:FeeTransaction a skos:Concept ; skos:inScheme pwm:FeeTypeScheme ; skos:topConceptOf pwm:FeeTypeScheme ;
    skos:prefLabel "transaction fee"@en ; skos:definition "Per transaction, such as brokerage."@en .
pwm:FeePerformance a skos:Concept ; skos:inScheme pwm:FeeTypeScheme ; skos:topConceptOf pwm:FeeTypeScheme ;
    skos:prefLabel "performance fee"@en ; skos:definition "Contingent on returns above a hurdle or high-water mark."@en .

# =============================================================================
#  Module 5: Accounts, portfolios and holdings
# =============================================================================

pwm:Account a owl:Class ;
    rdfs:label "account"@en ;
    skos:definition "Record of a business arrangement between a client and a wealth manager, in which balances and transactions are kept."@en ;
    rdfs:subClassOf fibo-fbc-pas-caa:Account ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:SG-BANKING-ACT ; pwm:locator "s47: customer information includes particulars of an account" ] .

pwm:InvestmentAccount a owl:Class ;
    rdfs:label "investment account"@en ;
    skos:definition "Account that records securities and cash held for investment."@en ;
    rdfs:subClassOf fibo-fbc-pas-caa:InvestmentAccount , pwm:Account ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Specialises FIBO InvestmentAccount within the PWM account hierarchy" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "FBC/ProductsAndServices/ClientsAndAccounts/InvestmentAccount, Release; master source verified 2026-11-03" ] .

pwm:CustodyAccount a owl:Class ;
    rdfs:label "custody account"@en ;
    skos:altLabel "securities account"@en ;
    skos:definition "Investment account in which the wealth manager holds a client's securities in safekeeping."@en ;
    rdfs:subClassOf pwm:InvestmentAccount ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "No FIBO class for custody accounts at the version checked" ] .

pwm:CashAccount a owl:Class ;
    rdfs:label "cash account"@en ;
    skos:definition "Current or deposit account in a single currency, linked to a client's investment activity."@en ;
    rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/DepositAccount> , <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/CustomerAccount> , pwm:Account ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:FastContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Cash account" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "FBC/ProductsAndServices/ClientsAndAccounts/DepositAccount, Release; master source verified 2026-11-03" ] .

pwm:JointAccount a owl:Class ;
    rdfs:label "joint account"@en ;
    skos:definition "Account held by two or more holders, operated under a stated signing rule."@en ;
    rdfs:subClassOf pwm:Account ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Joint holding and signing rules" ] .

pwm:AccountHolder a owl:Class ;
    rdfs:label "account holder"@en ;
    skos:definition "Role of a party that owns an account."@en ;
    rdfs:subClassOf fibo-fbc-pas-caa:AccountHolder ;
    skos:exactMatch fibo-fbc-pas-caa:AccountHolder ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII: account holder" ] .

pwm:Portfolio a owl:Class ;
    rdfs:label "portfolio"@en ;
    skos:definition "Collection of holdings managed or advised as a unit under one mandate."@en ;
    rdfs:subClassOf fibo-fnd-oac-own:Portfolio ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "review_portfolio tool under contact-frequency" ] .

pwm:Holding a owl:Class ;
    rdfs:label "holding"@en ;
    skos:definition "Quantity of a financial instrument or other asset held in a portfolio or account at a point in time."@en ;
    rdfs:subClassOf fibo-fnd-oac-own:Holding ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:FastContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 7: fast-moving facts are looked up live" ] .

pwm:Position a owl:Class ;
    rdfs:label "position"@en ;
    skos:definition "Financial exposure from owning, borrowing, shorting or contracting, including derivatives and credit."@en ;
    rdfs:subClassOf fibo-fbc-pas-fpas:Position ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:FastContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 7" ] .

pwm:Valuation a owl:Class ;
    rdfs:label "valuation"@en ;
    skos:definition "Monetary value of a portfolio, account or holding at a stated time, produced by a registered calculation service."@en ;
    skos:scopeNote "A figure presented as authoritative must cite its calculation service. A model may explain a valuation; it may not produce one."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:FastContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 6: calculation provenance" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 8: deterministic financial calculations" ] .

pwm:LombardFacility a owl:Class ;
    rdfs:label "Lombard facility"@en ;
    skos:altLabel "securities-backed loan"@en ;
    skos:definition "Credit extended to a client against a pledged portfolio of financial assets, with an advance rate per asset."@en ;
    rdfs:subClassOf fibo-loan-ln-ln:CollateralizedLoan ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:contextSpeed pwm:FastContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Portfolio-backed lending" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "LOAN/LoansGeneral/Loans/CollateralizedLoan, Release; master source verified 2026-11-03" ] .

pwm:accountHeldBy a owl:ObjectProperty ;
    rdfs:label "account held by"@en ;
    skos:definition "Account holder of an account."@en ;
    rdfs:domain pwm:Account ; rdfs:range pwm:AccountHolder ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:OECD-CRS ; pwm:locator "Section VIII" ] .

pwm:hasPortfolio a owl:ObjectProperty ;
    rdfs:label "has portfolio"@en ;
    skos:definition "Portfolio recorded in an account."@en ;
    rdfs:domain pwm:Account ; rdfs:range pwm:Portfolio ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Account and portfolio" ] .

pwm:hasHolding a owl:ObjectProperty ;
    skos:closeMatch <https://www.omg.org/spec/Commons/Collections/hasMember> ;
    pwm:citation [ pwm:cites pwmref:OMG-COMMONS ; pwm:locator "Collections/hasMember, verified in https://www.omg.org/spec/Commons/20250801/Collections.rdf; portfolio membership is narrower" ] ;
    rdfs:label "has holding"@en ;
    skos:definition "Holding that forms part of a portfolio."@en ;
    rdfs:domain pwm:Portfolio ; rdfs:range pwm:Holding ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Portfolio composition" ] .

pwm:inInstrument a owl:ObjectProperty ;
    rdfs:label "in instrument"@en ;
    skos:definition "Financial instrument a holding or position is in."@en ;
    rdfs:range fibo-fbc-fi-fi:FinancialInstrument ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Holding to instrument" ] .

pwm:valuationOf a owl:ObjectProperty ;
    rdfs:label "valuation of"@en ;
    skos:definition "Portfolio, account or holding a valuation measures."@en ;
    rdfs:domain pwm:Valuation ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 6" ] .

pwm:amount a owl:DatatypeProperty ;
    rdfs:label "amount"@en ;
    skos:definition "Numeric amount, read together with its currency."@en ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fibo-fnd-acc-cur:hasAmount ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Amount and currency pattern" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "FND/Accounting/CurrencyAmount/hasAmount, Release; master source verified 2026-11-03" ] .

pwm:currency a owl:DatatypeProperty ;
    rdfs:label "currency"@en ;
    skos:definition "Currency of an amount, as an ISO 4217 alphabetic code."@en ;
    rdfs:range xsd:string ;
    skos:closeMatch fibo-fnd-acc-cur:hasCurrency ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:ISO-4217 ; pwm:locator "Alphabetic codes" ] .

pwm:signingRule a owl:ObjectProperty ;
    rdfs:label "signing rule"@en ;
    skos:definition "Rule for who must sign instructions on a joint account or for an entity."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Signing authority" ] .

pwm:securedBy a owl:ObjectProperty ;
    rdfs:label "secured by"@en ;
    skos:definition "Portfolio pledged as collateral for a credit facility."@en ;
    rdfs:domain pwm:LombardFacility ; rdfs:range pwm:Portfolio ;
    skos:closeMatch <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/isCollateralizedBy> ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Pledge" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "FBC/DebtAndEquities/Debt/isCollateralizedBy, Release; master source verified 2026-11-03" ] .

pwm:SigningRuleScheme a skos:ConceptScheme ;
    skos:prefLabel "signing rules"@en ;
    pwm:inModule pwm:ModuleAccounts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Signing authority" ] .
pwm:SignAnyOne a skos:Concept ; skos:inScheme pwm:SigningRuleScheme ; skos:topConceptOf pwm:SigningRuleScheme ;
    skos:prefLabel "any one to sign"@en ; skos:definition "Any single authorised signatory may instruct."@en .
pwm:SignTwoJointly a skos:Concept ; skos:inScheme pwm:SigningRuleScheme ; skos:topConceptOf pwm:SigningRuleScheme ;
    skos:prefLabel "two to sign"@en ; skos:definition "Any two authorised signatories together."@en .
pwm:SignAllJointly a skos:Concept ; skos:inScheme pwm:SigningRuleScheme ; skos:topConceptOf pwm:SigningRuleScheme ;
    skos:prefLabel "all to sign"@en ; skos:definition "Every holder or signatory must sign."@en .

# =============================================================================
#  Module 6: Products, distribution and research
# =============================================================================

pwm:Product a owl:Class ;
    rdfs:label "product"@en ;
    skos:definition "Financial product on the wealth manager's shelf, such as a fund, structured note, bond, deposit or credit facility, linked to the instruments that underlie it."@en ;
    rdfs:subClassOf fibo-fbc-pas-fpas:FinancialProduct ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Product shelf" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "FBC/ProductsAndServices/FinancialProductsAndServices/FinancialProduct, Release; master source verified 2026-11-03" ] .

pwm:ProductRiskRating a owl:Class ;
    rdfs:label "product risk rating"@en ;
    skos:definition "Wealth manager's assessment of a product's risk on its own scale, used to match products to client risk profiles."@en ;
    rdfs:subClassOf pwm:Assessment ;
    skos:relatedMatch fibo-sec-fund-civ:RiskLevel ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 16(3), 24(2): product governance" ] .

pwm:productRiskLevel a owl:ObjectProperty ;
    rdfs:label "product risk level"@en ;
    skos:definition "Level a product risk rating assigns, on a scale that can be compared with client risk profile levels."@en ;
    skos:scopeNote "Use the same scale as the risk profile, or a published mapping between the two, so a suitability check can compare them."@en ;
    rdfs:domain pwm:ProductRiskRating ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 16(3), 24(2): product governance" ] , [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "suitability" ] .

pwm:TargetMarket a owl:Class ;
    rdfs:label "target market"@en ;
    skos:definition "Description of the clients a product is designed for, and those it is not, by category, knowledge, risk and objectives."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 16(3), 24(2)" ] .

pwm:ApprovedProductList a owl:Class ;
    rdfs:label "approved product list"@en ;
    skos:altLabel "product shelf"@en ;
    skos:definition "Versioned list of products approved for distribution from a booking centre."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "product-eligibility" ] , [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Shelf governance" ] .

pwm:CrossBorderRule a owl:Class ;
    rdfs:label "cross-border rule"@en ;
    skos:definition "Deterministic rule stating whether an activity, such as solicitation, advice or research distribution, is permitted for a client domicile, booking centre, investor category and product."@en ;
    skos:scopeNote "A rule table evaluated outside the model. It is not AI under MAS AIRG para 1.3 unless a model takes part in the decision. Activity, client domicile and booking centre are required; an absent investor category or product means all. When rules overlap, the most specific rule (most scope values set) decides; on a tie, not permitted wins; with no matching rule the activity is not permitted (fail closed)."@en ;
    rdfs:subClassOf pwm:PolicyRule ;
    skos:relatedMatch fibo-sec-sec-rst:InvestorsDomicileRestriction , fibo-sec-sec-rst:QualifiedInvestorRestriction ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-domicile, booking-centre, rm-location, cross-border-solicitation, research-distribution" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.3, fn 6: rule-based tools are not AI" ] .

pwm:ProductTermSheet a owl:Class ;
    rdfs:label "product term sheet"@en ;
    skos:definition "Offering document summarising a product's terms, payoff, risks and costs."@en ;
    skos:editorialNote "FIBO's TermSheet (FND/Agreements) is a non-binding deal agreement, a different concept, so it is not aligned."@en ;
    rdfs:subClassOf fibo-sec-sec-iss:OfferingDocument ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C0 ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Product documentation" ] ;
    pwm:citation [ pwm:cites pwmref:FIBO ; pwm:locator "SEC/Securities/SecuritiesIssuance/OfferingDocument, Release; master source verified 2026-11-03" ] .

pwm:KeyInformationDocument a owl:Class ;
    rdfs:label "key information document"@en ;
    skos:altLabel "KID"@en ;
    skos:definition "Short standardised disclosure of a packaged product's nature, risks, costs and potential returns."@en ;
    rdfs:subClassOf fibo-sec-sec-iss:OfferingDocument ;
    skos:closeMatch fibo-sec-fund-civ:KeyInvestorInformationDocument ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C0 ;
    pwm:citation [ pwm:cites pwmref:EU-PRIIPS ; pwm:locator "Key information document" ] .

pwm:ResearchPublication a owl:Class ;
    rdfs:label "research publication"@en ;
    skos:definition "Authored, dated and versioned investment research, with effective, last-reviewed, superseded and expiry dates and any distribution restrictions."@en ;
    rdfs:subClassOf cmns-doc:Document ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 2: research provenance and lifecycle" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "research-distribution" ] .

pwm:HouseView a owl:Class ;
    rdfs:label "house view"@en ;
    skos:altLabel "CIO view"@en ;
    skos:definition "Wealth manager's current official view on markets and asset allocation. When it changes, recommendations that depend on it are invalidated."@en ;
    rdfs:subClassOf pwm:ResearchPublication ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 4: house-view change propagation" ] ,
                 [ pwm:cites pwmref:EVOLVE ; pwm:locator "Define truth once: one source for policies" ] .

pwm:hasUnderlyingInstrument a owl:ObjectProperty ;
    rdfs:label "has underlying instrument"@en ;
    skos:definition "Financial instrument a product consists of or refers to."@en ;
    rdfs:domain pwm:Product ; rdfs:range fibo-fbc-fi-fi:FinancialInstrument ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "Product to instrument" ] .

pwm:productComplexity a owl:ObjectProperty ;
    rdfs:label "product complexity"@en ;
    skos:definition "Regulatory complexity class of a product."@en ;
    rdfs:domain pwm:Product ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(4)" ] , [ pwm:cites pwmref:MAS-SFA04-N12 ; pwm:locator "Specified and excluded investment products" ] .

pwm:isin a owl:DatatypeProperty ;
    rdfs:label "ISIN"@en ;
    skos:definition "Twelve-character ISO 6166 international securities identification number."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:ISO-6166 ; pwm:locator "ISIN structure" ] .

pwm:cfiCode a owl:DatatypeProperty ;
    rdfs:label "CFI code"@en ;
    skos:definition "Six-letter ISO 10962 classification of financial instruments code."@en ;
    rdfs:range xsd:string ;
    skos:closeMatch fibo-sec-sec-cls:FinancialInstrumentClassificationCode ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:ISO-10962 ; pwm:locator "CFI code" ] .

pwm:appliesToActivity a owl:ObjectProperty ;
    rdfs:label "applies to activity"@en ;
    skos:definition "Activity a cross-border rule decides on. Required: a rule without an activity is incomplete, not a rule for every activity."@en ;
    rdfs:domain pwm:CrossBorderRule ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "cross-border-solicitation, research-distribution" ] .

pwm:appliesToProduct a owl:ObjectProperty ;
    rdfs:label "applies to product"@en ;
    skos:definition "Product a rule covers. Absent when the rule covers all products."@en ;
    rdfs:range pwm:Product ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "product-eligibility" ] .

pwm:appliesToInvestorCategory a owl:ObjectProperty ;
    rdfs:label "applies to investor category"@en ;
    skos:definition "Investor category a rule covers. Absent when the rule covers all investor categories."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 16(3): target market" ] .

pwm:clientDomicileCode a owl:DatatypeProperty ;
    rdfs:label "client domicile code"@en ;
    skos:definition "Client domicile a rule covers, as an ISO 3166-1 alpha-2 code. Required: a rule without a domicile is incomplete, not a rule for every domicile."@en ;
    rdfs:domain pwm:CrossBorderRule ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-domicile" ] .

pwm:bookingCentreCode a owl:DatatypeProperty ;
    rdfs:label "booking centre code"@en ;
    skos:definition "Booking centre jurisdiction a rule covers, as an ISO 3166-1 alpha-2 code. Required: a rule without a booking centre is incomplete, not a rule for every booking centre."@en ;
    rdfs:domain pwm:CrossBorderRule ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "booking-centre" ] .

pwm:permitted a owl:DatatypeProperty ;
    rdfs:label "permitted"@en ;
    skos:definition "Whether the activity is permitted under the rule."@en ;
    rdfs:domain pwm:CrossBorderRule ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "cross-border-solicitation: the pack enforces the flag the bank recorded" ] .

pwm:ProductComplexityScheme a skos:ConceptScheme ;
    skos:prefLabel "product complexity classes"@en ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 25(4)" ] , [ pwm:cites pwmref:MAS-SFA04-N12 ; pwm:locator "Specified investment products" ] .
pwm:ComplexProduct a skos:Concept ; skos:inScheme pwm:ProductComplexityScheme ; skos:topConceptOf pwm:ProductComplexityScheme ;
    skos:prefLabel "complex"@en ; skos:definition "Requires an assessment of knowledge and experience before sale."@en .
pwm:NonComplexProduct a skos:Concept ; skos:inScheme pwm:ProductComplexityScheme ; skos:topConceptOf pwm:ProductComplexityScheme ;
    skos:prefLabel "non-complex"@en ; skos:definition "May be sold without an appropriateness check where the rules allow."@en .
pwm:SpecifiedInvestmentProductSG a skos:Concept ; skos:inScheme pwm:ProductComplexityScheme ; skos:broader pwm:ComplexProduct ;
    skos:prefLabel "specified investment product (SG)"@en ; skos:definition "Product that MAS requires a customer knowledge or account assessment for before sale to retail customers."@en .
pwm:ExcludedInvestmentProductSG a skos:Concept ; skos:inScheme pwm:ProductComplexityScheme ; skos:broader pwm:NonComplexProduct ;
    skos:prefLabel "excluded investment product (SG)"@en ; skos:definition "Product outside the specified-investment-product regime."@en .

pwm:CrossBorderActivityScheme a skos:ConceptScheme ;
    skos:prefLabel "cross-border activities"@en ;
    pwm:inModule pwm:ModuleProducts ;
    pwm:citation [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "cross-border-solicitation, research-distribution" ] .
pwm:ActivitySolicitation a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "solicitation"@en ; skos:definition "Approaching a client or prospect unprompted."@en .
pwm:ActivityReverseEnquiry a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "reverse enquiry"@en ; skos:definition "Responding to a request the client initiated."@en .
pwm:ActivityAdvice a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "advice"@en ; skos:definition "Giving a personal recommendation."@en .
pwm:ActivityExecution a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "execution"@en ; skos:definition "Executing a client instruction."@en .
pwm:ActivityMarketing a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "marketing"@en ; skos:definition "Promoting a product or service."@en .
pwm:ActivityResearchDistribution a skos:Concept ; skos:inScheme pwm:CrossBorderActivityScheme ; skos:topConceptOf pwm:CrossBorderActivityScheme ;
    skos:prefLabel "research distribution"@en ; skos:definition "Sending research to a client."@en .

# =============================================================================
#  Module 7: Interactions, advice and communication
# =============================================================================

pwm:ClientInteraction a owl:Class ;
    rdfs:label "client interaction"@en ;
    skos:definition "One client journey, from its trigger through retrieval, recommendation, review and decision to any communication, recorded under a single identifier."@en ;
    rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 9: interaction record" ] .

pwm:Origination a owl:Class ;
    rdfs:label "origination"@en ;
    skos:definition "Step that selects a client or product for attention, recorded with its trigger, selection criteria, candidate set and reasons, before anything is shown to a relationship manager."@en ;
    skos:scopeNote "An origination may conclude that no contact is recommended, with a reason."@en ;
    rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10: origination evidence; do not contact is a first-class outcome" ] .

pwm:Recommendation a owl:Class ;
    rdfs:label "recommendation"@en ;
    skos:definition "Personal recommendation to a client about a product, transaction or allocation, with structured rationale and cited sources."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(4): investment advice" ] , [ pwm:cites pwmref:MAS-FAA-N16 ; pwm:locator "Recommendations on investment products" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10: rationale as structured fields with citations" ] .

pwm:FinalDecision a owl:Class ;
    rdfs:label "final decision"@en ;
    skos:definition "Named person's decision on an AI-prepared recommendation or action, approving, modifying, rejecting or escalating it, with what they saw and what they changed."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11: RM review capture" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ] .

pwm:ClientCommunication a owl:Class ;
    rdfs:label "client communication"@en ;
    skos:definition "Message sent to a client through a channel, classified by communication level, carrying its content provenance and any AI disclosure, and traceable to the final decision it came from."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12: governed client communication" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.6: inform customers of AI use; channels for redress" ] ,
                 [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-communication (two signatures), client-communication-content, client-ai-disclosure" ] .

pwm:CommunicationChannel a owl:Class ;
    rdfs:label "communication channel"@en ;
    skos:definition "Means of reaching a client, registered as approved only if it meets archiving and supervision requirements."@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12: approved-channel register" ] .

pwm:Complaint a owl:Class ;
    rdfs:label "complaint"@en ;
    skos:definition "Expression of dissatisfaction by a client, linked to the interaction, output, model version and approver it concerns."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15: outcomes and near misses" ] ,
                 [ pwm:cites pwmref:MAS-FAIR-DEALING ; pwm:locator "Fair dealing outcomes" ] .

pwm:VulnerabilityIndicator a owl:Class ;
    rdfs:label "vulnerability indicator"@en ;
    skos:definition "Flag that a client may be vulnerable, raised for human review. AI may raise the flag; only a person may decide, and only a governed process may change treatment."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C3 ;
    pwm:citation [ pwm:cites pwmref:UK-FCA-FG21-1 ; pwm:locator "Fair treatment of vulnerable customers" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 10: vulnerable-client safeguards" ] .

pwm:Consent a owl:Class ;
    rdfs:label "consent"@en ;
    skos:definition "Record of a client's consent to a stated processing purpose, with its scope, date and withdrawal."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch dpv:Consent ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.4(f): consent for sensitive personal data used with AI" ] .

pwm:withClient a owl:ObjectProperty ;
    rdfs:label "with client"@en ;
    skos:definition "Client an interaction, recommendation or communication concerns."@en ;
    rdfs:range pwm:Client ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 9" ] .

pwm:partOfInteraction a owl:ObjectProperty ;
    rdfs:label "part of interaction"@en ;
    skos:definition "Client interaction an origination, recommendation, decision, communication or evidence record belongs to."@en ;
    rdfs:range pwm:ClientInteraction ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 9: one interaction_id spans a whole client journey" ] .

pwm:originationTrigger a owl:ObjectProperty ;
    rdfs:label "origination trigger"@en ;
    skos:definition "What started an origination."@en ;
    rdfs:domain pwm:Origination ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "origination.TRIGGERS" ] .

pwm:doNotContactReason a owl:ObjectProperty ;
    rdfs:label "do-not-contact reason"@en ;
    skos:definition "Why an origination concluded that no contact is recommended."@en ;
    rdfs:domain pwm:Origination ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "origination.DO_NOT_CONTACT_REASONS" ] .

pwm:originatedBy a owl:ObjectProperty ;
    rdfs:label "originated by"@en ;
    skos:definition "Origination that proposed a recommendation."@en ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain pwm:Recommendation ; rdfs:range pwm:Origination ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 10" ] .

pwm:recommendsProduct a owl:ObjectProperty ;
    rdfs:label "recommends product"@en ;
    skos:definition "Product a recommendation proposes."@en ;
    rdfs:domain pwm:Recommendation ; rdfs:range pwm:Product ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:EU-MIFID2 ; pwm:locator "Art. 4(1)(4)" ] .

pwm:decisionOn a owl:ObjectProperty ;
    rdfs:label "decision on"@en ;
    skos:definition "Recommendation or proposed action a final decision rules on."@en ;
    rdfs:domain pwm:FinalDecision ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11" ] .

pwm:decisionResult a owl:ObjectProperty ;
    rdfs:label "decision result"@en ;
    skos:definition "Approve, modify, reject or escalate."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11: outcomes are approve, modify, reject or escalate" ] .

pwm:derivedFromDecision a owl:ObjectProperty ;
    rdfs:label "derived from decision"@en ;
    skos:definition "Final decision a client communication traces back to. A communication without one is refused."@en ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain pwm:ClientCommunication ; rdfs:range pwm:FinalDecision ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12: a communication that does not trace back to a final decision is a DENY" ] .

pwm:communicationLevel a owl:ObjectProperty ;
    rdfs:label "communication level"@en ;
    skos:definition "How consequential a communication is, which sets the controls it must pass."@en ;
    rdfs:domain pwm:ClientCommunication ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.COMMUNICATION_LEVELS" ] .

pwm:viaChannel a owl:ObjectProperty ;
    rdfs:label "via channel"@en ;
    skos:definition "Channel a communication was sent through."@en ;
    rdfs:domain pwm:ClientCommunication ; rdfs:range pwm:CommunicationChannel ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12" ] .

pwm:isApprovedChannel a owl:DatatypeProperty ;
    rdfs:label "is approved channel"@en ;
    skos:definition "Whether a channel is registered as meeting archiving and supervision requirements."@en ;
    rdfs:domain pwm:CommunicationChannel ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12: approved-channel register" ] .

pwm:contentProvenance a owl:ObjectProperty ;
    rdfs:label "content provenance"@en ;
    skos:definition "Who produced content: a person, AI, AI then edited by a person, or a person with AI assistance. The label survives edits."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11: content provenance label" ] .

pwm:aiDisclosureGiven a owl:DatatypeProperty ;
    rdfs:label "AI disclosure given"@en ;
    skos:definition "Whether the communication told the client that AI was involved."@en ;
    rdfs:domain pwm:ClientCommunication ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.6" ] , [ pwm:cites pwmref:KOG-PB-PACK ; pwm:locator "client-ai-disclosure" ] .

pwm:disclosureTrigger a owl:ObjectProperty ;
    rdfs:label "disclosure trigger"@en ;
    skos:definition "Reason recorded for an AI disclosure: what the AI did that the disclosure describes. Whether disclosure is required is decided by the jurisdiction's disclosure rule and the content provenance."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.DISCLOSURE_TRIGGERS" ] .

pwm:contentHash a owl:DatatypeProperty ;
    rdfs:label "content hash"@en ;
    skos:definition "Cryptographic hash of content as rendered, sent or stored, so the content can be proved later without being copied into the record."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 items 11, 12: hash of the content as sent" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: version ID or content hash; keep the hash when content is deleted" ] .

pwm:CommunicationLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "communication levels"@en ;
    skos:scopeNote "Ordered least to most consequential. A higher level keeps every control of the levels below it."@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.COMMUNICATION_LEVELS" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 12" ] .
pwm:CommGeneralInformation a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "1" ;
    skos:prefLabel "general information"@en ; skos:definition "Information not specific to the client."@en .
pwm:CommHouseView a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "2" ;
    skos:prefLabel "house view"@en ; skos:definition "The institution's published view, unadapted."@en .
pwm:CommContextualisedInsight a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "3" ;
    skos:prefLabel "contextualised insight"@en ; skos:definition "Information related to the client's circumstances, without a recommendation."@en .
pwm:CommInvestmentDiscussion a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "4" ;
    skos:prefLabel "investment discussion"@en ; skos:definition "Discussion of options for the client's portfolio."@en .
pwm:CommProductRecommendation a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "5" ;
    skos:prefLabel "product recommendation"@en ; skos:definition "Personal recommendation of a product; triggers suitability checks and approval."@en .
pwm:CommTransaction a skos:Concept ; skos:inScheme pwm:CommunicationLevelScheme ; skos:topConceptOf pwm:CommunicationLevelScheme ; skos:notation "6" ;
    skos:prefLabel "transaction"@en ; skos:definition "Communication that confirms or effects a transaction."@en .

pwm:ContentProvenanceScheme a skos:ConceptScheme ;
    skos:prefLabel "content provenance labels"@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11" ] .
pwm:ProvenanceHuman a skos:Concept ; skos:inScheme pwm:ContentProvenanceScheme ; skos:topConceptOf pwm:ContentProvenanceScheme ;
    skos:prefLabel "human"@en ; skos:definition "Written by a person without AI."@en .
pwm:ProvenanceAI a skos:Concept ; skos:inScheme pwm:ContentProvenanceScheme ; skos:topConceptOf pwm:ContentProvenanceScheme ;
    skos:prefLabel "AI"@en ; skos:definition "Generated by AI."@en .
pwm:ProvenanceAIHumanEdited a skos:Concept ; skos:inScheme pwm:ContentProvenanceScheme ; skos:topConceptOf pwm:ContentProvenanceScheme ;
    skos:prefLabel "AI then human-edited"@en ; skos:definition "Generated by AI, then edited by a person; stays identifiable as AI-originated."@en .
pwm:ProvenanceHumanAIAssisted a skos:Concept ; skos:inScheme pwm:ContentProvenanceScheme ; skos:topConceptOf pwm:ContentProvenanceScheme ;
    skos:prefLabel "human with AI assistance"@en ; skos:definition "Written by a person with AI help."@en .

pwm:DisclosureTriggerScheme a skos:ConceptScheme ;
    skos:prefLabel "AI disclosure triggers"@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.DISCLOSURE_TRIGGERS" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.6" ] .
pwm:TriggerAIGeneratedContent a skos:Concept ; skos:inScheme pwm:DisclosureTriggerScheme ; skos:topConceptOf pwm:DisclosureTriggerScheme ;
    skos:prefLabel "AI generated content"@en ; skos:definition "The content was generated by AI."@en .
pwm:TriggerAssistedAnalysis a skos:Concept ; skos:inScheme pwm:DisclosureTriggerScheme ; skos:topConceptOf pwm:DisclosureTriggerScheme ;
    skos:prefLabel "assisted analysis"@en ; skos:definition "AI assisted the analysis behind the content."@en .
pwm:TriggerPowersChatbot a skos:Concept ; skos:inScheme pwm:DisclosureTriggerScheme ; skos:topConceptOf pwm:DisclosureTriggerScheme ;
    skos:prefLabel "powers a chatbot"@en ; skos:definition "The client is talking to an AI system."@en .
pwm:TriggerMaterialContribution a skos:Concept ; skos:inScheme pwm:DisclosureTriggerScheme ; skos:topConceptOf pwm:DisclosureTriggerScheme ;
    skos:prefLabel "materially contributed to a decision"@en ; skos:definition "AI materially contributed to a decision affecting the client."@en .

pwm:OriginationTriggerScheme a skos:ConceptScheme ;
    skos:prefLabel "origination triggers"@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "origination.TRIGGERS" ] .
pwm:OriginationEvent a skos:Concept ; skos:inScheme pwm:OriginationTriggerScheme ; skos:topConceptOf pwm:OriginationTriggerScheme ;
    skos:prefLabel "event"@en ; skos:definition "A client or market event, such as a maturity or a house-view change."@en .
pwm:OriginationSchedule a skos:Concept ; skos:inScheme pwm:OriginationTriggerScheme ; skos:topConceptOf pwm:OriginationTriggerScheme ;
    skos:prefLabel "schedule"@en ; skos:definition "A scheduled review."@en .
pwm:OriginationRMRequest a skos:Concept ; skos:inScheme pwm:OriginationTriggerScheme ; skos:topConceptOf pwm:OriginationTriggerScheme ;
    skos:prefLabel "RM request"@en ; skos:definition "A relationship manager asked for it."@en .

pwm:DoNotContactReasonScheme a skos:ConceptScheme ;
    skos:prefLabel "do-not-contact reasons"@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "origination.DO_NOT_CONTACT_REASONS" ] .
pwm:DNCLowRelevance a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "low relevance"@en ; skos:definition "Not relevant enough to the client."@en .
pwm:DNCPoorTiming a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "poor timing"@en ; skos:definition "Wrong moment for the client."@en .
pwm:DNCVulnerability a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "vulnerability"@en ; skos:definition "A vulnerability indicator is open."@en .
pwm:DNCExcessiveFrequency a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "excessive frequency"@en ; skos:definition "Contact-frequency limit reached."@en .
pwm:DNCRecentRejection a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "a recent rejection"@en ; skos:definition "The client recently declined a similar proposal."@en .
pwm:DNCRelationshipCircumstance a skos:Concept ; skos:inScheme pwm:DoNotContactReasonScheme ; skos:topConceptOf pwm:DoNotContactReasonScheme ;
    skos:prefLabel "a relationship circumstance"@en ; skos:definition "A circumstance in the relationship makes contact inappropriate."@en .

pwm:DecisionResultScheme a skos:ConceptScheme ;
    skos:prefLabel "final decision results"@en ;
    pwm:inModule pwm:ModuleInteractions ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11" ] .
pwm:DecisionApprove a skos:Concept ; skos:inScheme pwm:DecisionResultScheme ; skos:topConceptOf pwm:DecisionResultScheme ;
    skos:prefLabel "approve"@en ; skos:definition "Accepted as prepared."@en .
pwm:DecisionModify a skos:Concept ; skos:inScheme pwm:DecisionResultScheme ; skos:topConceptOf pwm:DecisionResultScheme ;
    skos:prefLabel "modify"@en ; skos:definition "Accepted with changes, recorded as a structured diff."@en .
pwm:DecisionReject a skos:Concept ; skos:inScheme pwm:DecisionResultScheme ; skos:topConceptOf pwm:DecisionResultScheme ;
    skos:prefLabel "reject"@en ; skos:definition "Not accepted."@en .
pwm:DecisionEscalate a skos:Concept ; skos:inScheme pwm:DecisionResultScheme ; skos:topConceptOf pwm:DecisionResultScheme ;
    skos:prefLabel "escalate"@en ; skos:definition "Referred to a more senior or specialist decision-maker."@en .

# =============================================================================
#  Module 8: AI use cases, authority and accountability
# =============================================================================

pwm:AIUseCase a owl:Class ;
    rdfs:label "AI use case"@en ;
    skos:definition "Specific real-world context that an AI model or system is applied to, registered as a versioned inventory entry with its purpose, approved scope including jurisdiction, data, dependencies, lifecycle status, risk materiality, review status and accountable people."@en ;
    skos:scopeNote "The use case, not the model, is the unit of risk assessment. Every policy decision cites the use case it was taken under; an unregistered or retired use case is refused."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.4(c) use case; 4.5 to 4.9 inventory; 4.7 attributes" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: use-case register" ] ,
                 [ pwm:cites pwmref:ISO-IEC-42001 ; pwm:locator "AI management system" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 19: an unregistered use case is refused" ] .

pwm:AISystem a owl:Class ;
    rdfs:label "AI system"@en ;
    skos:definition "Machine-based system of one or more models and other components that derives outputs, such as predictions, content, recommendations or decisions, from learned premises."@en ;
    skos:scopeNote "Tools whose outputs are fully determined by manually specified rules, and robotic process automation without learning, are not AI for this purpose."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch ai:AISystem ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.3 and fn 6 (definition and exclusions); 1.4(b) system" ] ,
                 [ pwm:cites pwmref:EU-AI-ACT ; pwm:locator "Art. 3(1)" ] , [ pwm:cites pwmref:ISO-IEC-22989 ; pwm:locator "AI system" ] .

pwm:AIModel a owl:Class ;
    rdfs:label "AI model"@en ;
    skos:definition "Method that converts assumptions and input data into outputs such as estimates, decisions or recommendations, pinned to a provider and version."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch ai:Model ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.4(a) model" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.3: pinned provider model version per call" ] .

pwm:AIAgent a owl:Class ;
    rdfs:label "AI agent"@en ;
    skos:definition "Software agent that plans and takes actions with tools on behalf of a person, holding its own credentials, a maximum autonomy level, a tool allow-list, guardrails and a deployment version that covers prompt, tools, permissions and data."@en ;
    skos:scopeNote "An agent can never hold an accountability role. Its entitlements are always narrower than those of the person it acts for."@en ;
    rdfs:subClassOf cmns-pts:SoftwareAgent , prov:SoftwareAgent ;
    skos:closeMatch ai:AIAgent ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.11 (agent risks); fn 25 (agent identifiers, tools, components, guardrails)" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 1: agent identity" ] ,
                 [ pwm:cites pwmref:IMDA-MGF-AGENTIC ; pwm:locator "Agentic AI governance" ] .

pwm:ThirdPartyAI a owl:Class ;
    rdfs:label "third-party AI"@en ;
    skos:definition "AI system, model, or service using AI, that an external party develops, owns, operates or provides and the institution procures, accesses or relies on, including AI embedded in software services."@en ;
    rdfs:subClassOf pwm:AISystem ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "fn 10 (definition); 4.2 and fn 21 (embedded AI); 5.10, 5.11 (management)" ] .

pwm:ModelProvider a owl:Class ;
    rdfs:label "model provider"@en ;
    skos:definition "Organisation that supplies AI models or AI services, tracked for concentration, change notification and exit."@en ;
    rdfs:subClassOf cmns-org:ServiceProvider ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.11(c) concentration; 5.11(d) change management" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.7: model-provider register" ] .

pwm:ModelCard a owl:Class ;
    rdfs:label "model card"@en ;
    skos:definition "Record of an approved model: provider, name and version, intended use, known limitations, the evaluation relied on, approval date and approver."@en ;
    rdfs:subClassOf cmns-doc:Document ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: model card per approved model" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.10: documentation of how third-party AI was tested" ] .

pwm:Tool a owl:Class ;
    rdfs:label "tool"@en ;
    skos:definition "Capability an agent can invoke, such as an MCP tool or API, declaring the action verb it performs, the autonomy level it requires and a maximum duration."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3 (per-verb permissions), item 5 (allow-lists), item 16 (maximum duration)" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.16(c): govern plugins and APIs" ] .

pwm:RiskMaterialityAssessment a owl:Class ;
    rdfs:label "risk materiality assessment"@en ;
    skos:definition "Assessment of an AI use case on impact, complexity and reliance, including the autonomy granted, recorded before controls (inherent) and after them (residual), and approved by the designated control function."@en ;
    skos:scopeNote "Residual materiality must be within risk appetite before deployment. Kognita's six axes (business criticality, client-impact class, decision consequence, data sensitivity, autonomy, complexity) roll up into the three MAS dimensions."@en ;
    rdfs:subClassOf pwm:Assessment ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.10 to 4.13" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: six axes; inherent and residual materiality" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Gaps 3 and 4" ] .

pwm:AIRiskAppetite a owl:Class ;
    rdfs:label "AI risk appetite"@en ;
    skos:definition "Board-approved statement of the AI uses the institution will and will not accept, with quantitative measures such as AI incident counts, material use cases depending on one provider, and use cases breaching performance thresholds."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "3.4(b) and fn 18" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: AI risk appetite as top-level policy; quantitative measures" ] .

pwm:AccountabilityRole a owl:Class ;
    rdfs:label "accountability role"@en ;
    skos:definition "Role of a named person accountable for an AI use case. Accountability can be supported by functions but cannot be delegated to an agent."@en ;
    rdfs:subClassOf cmns-pts:PartyRole ,
        [ a owl:Restriction ; owl:onProperty cmns-rlcmp:isPlayedBy ; owl:allValuesFrom [ a owl:Class ; owl:complementOf pwm:AIAgent ] ] ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "3.5(d): clear roles and responsibilities" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: an agent can never be named in an owner role" ] ,
                 [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 05: a name, not a forum" ] .

pwm:BusinessOwner a owl:Class ;
    rdfs:label "business owner"@en ;
    skos:altLabel "accountable owner"@en ;
    skos:definition "Accountability role answerable for an AI use case's business outcome and residual risk acceptance. Every decision under the use case cites this person."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: a use case with no current owner is a DENY" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(c): accountable person for monitoring and incidents" ] .

pwm:TechnologyOwner a owl:Class ;
    rdfs:label "technology owner"@en ;
    skos:definition "Accountability role for the technology that delivers an AI use case."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases._OWNER_ROLES" ] .

pwm:RiskOwner a owl:Class ;
    rdfs:label "risk owner"@en ;
    skos:definition "Accountability role for an AI use case's residual risk; receives fairness and drift findings."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases._OWNER_ROLES" ] .

pwm:ModelOwner a owl:Class ;
    rdfs:label "model owner"@en ;
    skos:definition "Accountability role for the models an AI use case relies on."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases._OWNER_ROLES" ] .

pwm:KnowledgeLead a owl:Class ;
    rdfs:label "Knowledge Lead"@en ;
    skos:definition "Named owner of an AI workflow's quality standard: defines the standard and primary metric, approves consequential outputs, receives escalations of ambiguity and exceptions, and approves changes to the standard, including those learned from operations."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: every AI-powered workflow needs a named Knowledge Lead" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: a tier 2+ use case with no current Knowledge Lead is a DENY" ] ,
                 [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 05: named owner" ] .

pwm:DesignatedControlFunction a owl:Class ;
    rdfs:label "designated control function"@en ;
    skos:definition "Control function, independent of a use case's business and technology owners, that is final arbiter of whether a use constitutes AI, owns inventory policy, and approves risk materiality ratings."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.3, 4.9, 4.13" ] , [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Gap 2" ] .

pwm:IndependentValidator a owl:Class ;
    rdfs:label "independent validator"@en ;
    skos:definition "Person or function, independent of development and deployment, that validates a high-materiality AI use case before deployment and periodically afterwards."@en ;
    rdfs:subClassOf pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.18 to 5.21 (pre-deployment review); 5.24 (re-validation)" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: independent validation as separation of duties" ] .

pwm:DelegatedAuthority a owl:Class ;
    rdfs:label "delegated authority"@en ;
    skos:definition "Authorisation that binds a person, an agent, a purpose, a client, permitted actions, permitted data, a period and limits. Specific, temporary, revocable, and ended by task completion as well as by time."@en ;
    skos:scopeNote "A request is allowed only if the person holds the entitlement and the agent holds a live delegation for it."@en ;
    rdfs:subClassOf cmns-bauth:Authorization ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2: delegated authority" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 2: explicit delegated authority" ] .

pwm:AutonomyPromotionGate a owl:Class ;
    rdfs:label "autonomy promotion gate"@en ;
    skos:definition "Evidence thresholds an agent must meet over a minimum sample and window before its autonomy level may rise, and below which it steps down automatically."@en ;
    skos:example "Quality at or above 95 percent, exception rate below 5 percent, every action in the window reconstructable."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: allow more autonomy only when quality metrics improve" ] ,
                 [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 04: autonomy is a licence, not a launch setting" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3: evidence gates for promotion; automatic step-down" ] .

pwm:OutcomeMetric a owl:Class ;
    rdfs:label "outcome metric"@en ;
    skos:definition "Primary metric of an AI use case, cycle time, decision quality or reliability, with a baseline and target computed from the institution's own records."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Measure what matters" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 7; item 8" ] .

pwm:Purpose a owl:Class ;
    rdfs:label "purpose"@en ;
    skos:definition "Declared reason for processing data or invoking AI. Access is bound to it; a request without a registered purpose is refused."@en ;
    skos:closeMatch dpv:Purpose ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7: purpose and description" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 3: purpose-bound access" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 11: who, why, what, where before retrieval" ] .

pwm:KillSwitch a owl:Class ;
    rdfs:label "kill switch"@en ;
    skos:definition "Mechanism that deactivates an AI system expeditiously when it exceeds risk tolerances, effective on the next decision, with a tested activation protocol and fallback."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.3 and fn 29; 5.23(b)" ] , [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 12" ] .

pwm:KillSwitchDrill a owl:Class ;
    rdfs:label "kill-switch drill"@en ;
    skos:definition "Test activation of a kill switch, recording who activated it, how long until the next decision was denied, and how the fallback was reached."@en ;
    rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.3: activation protocols tested regularly" ] , [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Gap 7" ] .

# --- Properties --------------------------------------------------------------------

pwm:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose"@en ;
    skos:definition "Registered purpose of a use case, delegation or request."@en ;
    rdfs:range pwm:Purpose ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7" ] .

pwm:approvedJurisdiction a owl:DatatypeProperty ;
    rdfs:label "approved jurisdiction"@en ;
    skos:definition "Jurisdiction in which a use case is approved for use, as an ISO 3166-1 alpha-2 code."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7: approved scope of use (e.g., jurisdiction)" ] .

pwm:modelType a owl:DatatypeProperty ;
    rdfs:label "model type"@en ;
    skos:definition "Kind of model a use case relies on, such as a classifier, ranking model or large language model."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7" ] .

pwm:usesDataClass a owl:ObjectProperty ;
    rdfs:label "uses data class"@en ;
    skos:definition "Data classification a use case is permitted to process."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7: data used; 5.4(d): data classification" ] .

pwm:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    skos:definition "AI system, model, provider or other use case that a use case relies on."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7: dependencies; fn 26" ] .

pwm:lifecycleStatus a owl:ObjectProperty ;
    rdfs:label "lifecycle status"@en ;
    skos:definition "Lifecycle status of a use case: pilot, live, suspended or retired."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7: lifecycle status" ] , [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.STATUSES" ] .

pwm:isMediated a owl:DatatypeProperty ;
    rdfs:label "is mediated"@en ;
    skos:definition "Whether a use case runs through the institution's AI control plane. Unmediated entries record the assurance gap and compensating control."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.2, 4.4: AI in third-party services and shadow AI" ] , [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Gap 1" ] .

pwm:riskTier a owl:ObjectProperty ;
    rdfs:label "risk tier"@en ;
    skos:definition "Risk tier derived from a use case's classification, which sets its minimum controls and maximum autonomy."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: risk tier 1 to 4" ] .

pwm:hasMaterialityAssessment a owl:ObjectProperty ;
    rdfs:label "has materiality assessment"@en ;
    skos:definition "Risk materiality assessment of a use case."@en ;
    rdfs:domain pwm:AIUseCase ; rdfs:range pwm:RiskMaterialityAssessment ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.10" ] .

pwm:impact a owl:ObjectProperty ;
    rdfs:label "impact"@en ;
    skos:definition "Impact rating: consequence of failure or poor performance for the institution, its customers and stakeholders, including the sensitivity of the data processed."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.12(a)" ] .

pwm:complexity a owl:ObjectProperty ;
    rdfs:label "complexity"@en ;
    skos:definition "Complexity rating: from the technology, novelty, data and explainability, and for third-party AI the visibility into it."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.12(b)" ] .

pwm:reliance a owl:ObjectProperty ;
    rdfs:label "reliance"@en ;
    skos:definition "Reliance rating: how far the decision or output rests on AI, including the autonomy granted and the degree of human oversight."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.12(c)" ] .

pwm:inherentMateriality a owl:ObjectProperty ;
    rdfs:label "inherent materiality"@en ;
    skos:definition "Materiality before controls are applied."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.11" ] .

pwm:residualMateriality a owl:ObjectProperty ;
    rdfs:label "residual materiality"@en ;
    skos:definition "Materiality after controls; must be within risk appetite before deployment."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.11" ] .

pwm:businessCriticality a owl:ObjectProperty ;
    rdfs:label "business criticality"@en ;
    skos:definition "Kognita classification axis: how critical the use case is to the business."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.BUSINESS_CRITICALITY" ] .

pwm:clientImpactClass a owl:ObjectProperty ;
    rdfs:label "client-impact class"@en ;
    skos:definition "Kognita classification axis: how directly the use case reaches clients."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.CLIENT_IMPACT" ] .

pwm:decisionConsequence a owl:ObjectProperty ;
    rdfs:label "decision consequence"@en ;
    skos:definition "Kognita classification axis: the kind of decision the use case informs or takes."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.DECISION_CONSEQUENCE" ] .

pwm:autonomyAxis a owl:ObjectProperty ;
    rdfs:label "autonomy axis"@en ;
    skos:definition "Kognita classification axis: autonomy granted to the use case."@en ;
    rdfs:domain pwm:RiskMaterialityAssessment ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.AUTONOMY_AXIS" ] .

pwm:hasAccountabilityRole a owl:ObjectProperty ;
    rdfs:label "has accountability role"@en ;
    skos:definition "Links a use case or agent to an accountability role held for it. The person holding the role is given on the role, with is played by."@en ;
    rdfs:range pwm:AccountabilityRole ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: owner roles; accountability matrix" ] .

pwm:registeredForUseCase a owl:ObjectProperty ;
    rdfs:label "registered for use case"@en ;
    skos:definition "Use case an agent is registered to act under."@en ;
    rdfs:domain pwm:AIAgent ; rdfs:range pwm:AIUseCase ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 1: linked use cases" ] .

pwm:agentIdentifier a owl:DatatypeProperty ;
    rdfs:label "agent identifier"@en ;
    skos:definition "Readable, unique identifier of an agent, such as AGENT-RM-PRECALL-01."@en ;
    rdfs:domain pwm:AIAgent ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "fn 25: agent-specific identifiers" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 1" ] .

pwm:deploymentVersion a owl:DatatypeProperty ;
    rdfs:label "deployment version"@en ;
    skos:definition "Hash over an agent's system prompt, instructions, tools, permissions, data sources, orchestration and memory behaviour. Any change needs re-approval before the agent can act."@en ;
    rdfs:domain pwm:AIAgent ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 1: deployment version covers behaviour" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.25: change management" ] .

pwm:maxAutonomyLevel a owl:ObjectProperty ;
    rdfs:label "maximum autonomy level"@en ;
    skos:definition "Highest autonomy level an agent may operate at, capped by its use case's risk tier."@en ;
    rdfs:domain pwm:AIAgent ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3" ] .

pwm:requiredAutonomyLevel a owl:ObjectProperty ;
    rdfs:label "required autonomy level"@en ;
    skos:definition "Autonomy level a tool requires. A call above the agent's level is refused; a call at L4 routes to human approval."@en ;
    rdfs:domain pwm:Tool ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3" ] .

pwm:actionVerb a owl:ObjectProperty ;
    rdfs:label "action verb"@en ;
    skos:definition "Action a tool performs, or a delegation permits."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3: action permissions are per verb" ] .

pwm:permittedTool a owl:ObjectProperty ;
    rdfs:label "permitted tool"@en ;
    skos:definition "Tool on an agent's allow-list."@en ;
    rdfs:domain pwm:AIAgent ; rdfs:range pwm:Tool ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "fn 25: tools and systems the agent can access" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 5" ] .

pwm:boundaryTier a owl:ObjectProperty ;
    rdfs:label "boundary tier"@en ;
    skos:definition "Whether an action is always permitted, needs asking first, or is never permitted for an agent."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: the three-tier boundary system" ] ,
                 [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 03: three-tier boundaries" ] .

pwm:delegatedBy a owl:ObjectProperty ;
    rdfs:label "delegated by"@en ;
    skos:definition "Person who grants a delegated authority. They must hold the entitlement themselves."@en ;
    rdfs:domain pwm:DelegatedAuthority ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2: dual check" ] .

pwm:delegatedTo a owl:ObjectProperty ;
    rdfs:label "delegated to"@en ;
    skos:definition "Agent that receives a delegated authority."@en ;
    rdfs:domain pwm:DelegatedAuthority ; rdfs:range pwm:AIAgent ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2" ] .

pwm:aboutClient a owl:ObjectProperty ;
    rdfs:label "about client"@en ;
    skos:definition "Client a delegation, claim or fact is about."@en ;
    rdfs:range pwm:Client ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2; 0.6 item 1" ] .

pwm:permitsDataClass a owl:ObjectProperty ;
    rdfs:label "permits data class"@en ;
    skos:definition "Highest data classification a delegation permits the agent to access."@en ;
    rdfs:domain pwm:DelegatedAuthority ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2: allowed data" ] .

pwm:endsOnTaskCompletion a owl:DatatypeProperty ;
    rdfs:label "ends on task completion"@en ;
    skos:definition "Whether a delegation is revoked when its task completes, not only when its period ends."@en ;
    rdfs:domain pwm:DelegatedAuthority ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2: authority ends when the task does" ] .

pwm:approvalThreshold a owl:DatatypeProperty ;
    rdfs:label "approval threshold"@en ;
    skos:definition "Statement of which actions under a delegation require human approval."@en ;
    rdfs:domain pwm:DelegatedAuthority ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2" ] .

pwm:qualityThreshold a owl:DatatypeProperty ;
    rdfs:label "quality threshold"@en ;
    skos:definition "Minimum share of outputs meeting the agreed standard, as a fraction from 0 to 1."@en ;
    rdfs:domain pwm:AutonomyPromotionGate ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Quality at least 95 percent" ] .

pwm:exceptionRateThreshold a owl:DatatypeProperty ;
    rdfs:label "exception rate threshold"@en ;
    skos:definition "Maximum share of runs that leave the always-do path, as a fraction from 0 to 1."@en ;
    rdfs:domain pwm:AutonomyPromotionGate ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Exception rate below 5 percent" ] .

pwm:requiresFullTraceability a owl:DatatypeProperty ;
    rdfs:label "requires full traceability"@en ;
    skos:definition "Whether every action in the evaluation window must be reconstructable for the gate to pass."@en ;
    rdfs:domain pwm:AutonomyPromotionGate ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Evidence fully traceable" ] .

pwm:primaryMetric a owl:ObjectProperty ;
    rdfs:label "primary metric"@en ;
    skos:definition "Kind of an outcome metric."@en ;
    rdfs:domain pwm:OutcomeMetric ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.PRIMARY_METRICS" ] .

pwm:baselineValue a owl:DatatypeProperty ;
    rdfs:label "baseline value"@en ;
    skos:definition "Measured value of an outcome metric before the use case."@en ;
    rdfs:domain pwm:OutcomeMetric ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Outcome baselines" ] .

pwm:targetValue a owl:DatatypeProperty ;
    rdfs:label "target value"@en ;
    skos:definition "Agreed target for an outcome metric."@en ;
    rdfs:domain pwm:OutcomeMetric ; rdfs:range xsd:decimal ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Targets agreed with the process owner" ] .

pwm:providedBy a owl:ObjectProperty ;
    rdfs:label "provided by"@en ;
    skos:definition "Model provider that supplies a model or AI service."@en ;
    rdfs:range pwm:ModelProvider ;
    skos:closeMatch cmns-org:isProvidedBy ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.11" ] .

# --- Concept schemes -----------------------------------------------------------------

pwm:AutonomyLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "agent autonomy levels"@en ;
    skos:scopeNote "Early private-banking deployments are expected at L1 to L4. Raising a level is a governed change needing the accountable owner and independent validation. The four-step gate in the Filing Cabinet talk (suggest, draft, act with approval, act alone) corresponds to L2, L3, L4 and L5 or above."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3: autonomy levels" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 12: reading is not the same as acting" ] .
pwm:L0Retrieve a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L0" ;
    skos:prefLabel "retrieve"@en ; skos:definition "Fetch authorised information."@en .
pwm:L1Explain a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L1" ;
    skos:prefLabel "explain"@en ; skos:definition "Summarise or explain retrieved information."@en .
pwm:L2Recommend a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L2" ;
    skos:prefLabel "recommend"@en ; skos:definition "Propose an option. Recommending never implies permission to execute."@en .
pwm:L3Draft a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L3" ;
    skos:prefLabel "draft"@en ; skos:definition "Prepare an artefact a person reviews before use."@en .
pwm:L4ActAfterApproval a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L4" ;
    skos:prefLabel "act after approval"@en ; skos:definition "Take an action once a named person, not the requester, has approved that exact action."@en .
pwm:L5BoundedAutonomy a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L5" ;
    skos:prefLabel "bounded autonomous action"@en ; skos:definition "Act without per-action approval inside explicit limits."@en .
pwm:L6BroadAutonomy a skos:Concept ; skos:inScheme pwm:AutonomyLevelScheme ; skos:topConceptOf pwm:AutonomyLevelScheme ; skos:notation "L6" ;
    skos:prefLabel "broad autonomy"@en ; skos:definition "Act across tasks with broad discretion."@en .

pwm:BoundaryTierScheme a skos:ConceptScheme ;
    skos:prefLabel "boundary tiers"@en ;
    skos:scopeNote "Set per action for each agent, independently of the autonomy-level scale. As a rule of thumb, internal work at L0 to L3 sits in always do, and L4 in ask first."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: the three-tier boundary system" ] ,
                 [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 03" ] .
pwm:AlwaysDo a skos:Concept ; skos:inScheme pwm:BoundaryTierScheme ; skos:topConceptOf pwm:BoundaryTierScheme ;
    skos:prefLabel "always do"@en ; skos:definition "Safe, reversible, inside the mandate and already authorised, such as retrieving authorised data or drafting an internal briefing."@en .
pwm:AskFirst a skos:Concept ; skos:inScheme pwm:BoundaryTierScheme ; skos:topConceptOf pwm:BoundaryTierScheme ;
    skos:prefLabel "ask first"@en ; skos:definition "Consequential or client-facing; the agent prepares and a person decides."@en .
pwm:NeverDo a skos:Concept ; skos:inScheme pwm:BoundaryTierScheme ; skos:topConceptOf pwm:BoundaryTierScheme ;
    skos:prefLabel "never do"@en ; skos:definition "Outside this agent's scope, whatever it is asked, enforced in its permissions rather than by asking. Which actions sit here is set per agent, for example sending client communications for an agent that only drafts."@en .

pwm:ActionVerbScheme a skos:ConceptScheme ;
    skos:prefLabel "action verbs"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 3: read, analyse, recommend, draft, queue, send and execute" ] .
pwm:VerbRead a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "read"@en ; skos:definition "Read information."@en .
pwm:VerbAnalyse a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "analyse"@en ; skos:definition "Derive insight from information."@en .
pwm:VerbRecommend a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "recommend"@en ; skos:definition "Propose an option."@en .
pwm:VerbDraft a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "draft"@en ; skos:definition "Prepare an artefact."@en .
pwm:VerbQueue a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "queue"@en ; skos:definition "Place an artefact for release by a person."@en .
pwm:VerbSend a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "send"@en ; skos:definition "Release an artefact outside the institution."@en .
pwm:VerbExecute a skos:Concept ; skos:inScheme pwm:ActionVerbScheme ; skos:topConceptOf pwm:ActionVerbScheme ; skos:prefLabel "execute"@en ; skos:definition "Change a system of record or move value."@en .

pwm:UseCaseStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "use-case lifecycle statuses"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.STATUSES" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.7; 5.2 fn 28 (pilots); 5.26 (decommissioning)" ] .
pwm:StatusPilot a skos:Concept ; skos:inScheme pwm:UseCaseStatusScheme ; skos:topConceptOf pwm:UseCaseStatusScheme ;
    skos:prefLabel "pilot"@en ; skos:definition "Limited by end date, named users and success criteria."@en ; skos:closeMatch ai:DeploymentStage .
pwm:StatusLive a skos:Concept ; skos:inScheme pwm:UseCaseStatusScheme ; skos:topConceptOf pwm:UseCaseStatusScheme ;
    skos:prefLabel "live"@en ; skos:definition "In production use."@en ; skos:closeMatch ai:OperationStage .
pwm:StatusSuspended a skos:Concept ; skos:inScheme pwm:UseCaseStatusScheme ; skos:topConceptOf pwm:UseCaseStatusScheme ;
    skos:prefLabel "suspended"@en ; skos:definition "Stopped pending review; decisions are refused."@en .
pwm:StatusRetired a skos:Concept ; skos:inScheme pwm:UseCaseStatusScheme ; skos:topConceptOf pwm:UseCaseStatusScheme ;
    skos:prefLabel "retired"@en ; skos:definition "Decommissioned; its agents are stopped and retention applies."@en ; skos:closeMatch ai:DecommissionStage .

pwm:RiskTierScheme a skos:ConceptScheme ;
    skos:prefLabel "use-case risk tiers"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: risk tier 1 to 4" ] .
pwm:Tier1 a skos:Concept ; skos:inScheme pwm:RiskTierScheme ; skos:topConceptOf pwm:RiskTierScheme ; skos:notation "1" ;
    skos:prefLabel "tier 1"@en ; skos:definition "Research summarisation."@en .
pwm:Tier2 a skos:Concept ; skos:inScheme pwm:RiskTierScheme ; skos:topConceptOf pwm:RiskTierScheme ; skos:notation "2" ;
    skos:prefLabel "tier 2"@en ; skos:definition "Client intelligence and meeting preparation."@en .
pwm:Tier3 a skos:Concept ; skos:inScheme pwm:RiskTierScheme ; skos:topConceptOf pwm:RiskTierScheme ; skos:notation "3" ;
    skos:prefLabel "tier 3"@en ; skos:definition "KYC, suitability and recommendations."@en .
pwm:Tier4 a skos:Concept ; skos:inScheme pwm:RiskTierScheme ; skos:topConceptOf pwm:RiskTierScheme ; skos:notation "4" ;
    skos:prefLabel "tier 4"@en ; skos:definition "Financial execution."@en .

pwm:RatingLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "rating levels"@en ;
    skos:scopeNote "Used for impact, complexity, reliance, inherent and residual materiality, business criticality and capacity for loss."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.MATERIALITY, BUSINESS_CRITICALITY" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.12" ] .
pwm:RatingLow a skos:Concept ; skos:inScheme pwm:RatingLevelScheme ; skos:topConceptOf pwm:RatingLevelScheme ; skos:notation "1" ; skos:prefLabel "low"@en ; skos:definition "Low."@en .
pwm:RatingMedium a skos:Concept ; skos:inScheme pwm:RatingLevelScheme ; skos:topConceptOf pwm:RatingLevelScheme ; skos:notation "2" ; skos:prefLabel "medium"@en ; skos:definition "Medium."@en .
pwm:RatingHigh a skos:Concept ; skos:inScheme pwm:RatingLevelScheme ; skos:topConceptOf pwm:RatingLevelScheme ; skos:notation "3" ; skos:prefLabel "high"@en ; skos:definition "High; material."@en .
pwm:RatingCritical a skos:Concept ; skos:inScheme pwm:RatingLevelScheme ; skos:topConceptOf pwm:RatingLevelScheme ; skos:notation "4" ; skos:prefLabel "critical"@en ; skos:definition "Critical; material."@en .

pwm:ClientImpactClassScheme a skos:ConceptScheme ;
    skos:prefLabel "client-impact classes"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.CLIENT_IMPACT" ] , [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Naming collisions: client-impact class" ] .
pwm:ImpactInternalProductivity a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "1" ; skos:prefLabel "internal productivity"@en ; skos:definition "Staff productivity with no client reach."@en .
pwm:ImpactRMAssistance a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "2" ; skos:prefLabel "RM assistance"@en ; skos:definition "Helps a relationship manager prepare."@en .
pwm:ImpactClientInfluence a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "3" ; skos:prefLabel "client influence"@en ; skos:definition "Shapes what a client is told or offered."@en .
pwm:ImpactClientCommunication a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "4" ; skos:prefLabel "client communication"@en ; skos:definition "Produces content that reaches a client."@en .
pwm:ImpactAdvice a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "5" ; skos:prefLabel "advice"@en ; skos:definition "Contributes to a personal recommendation."@en .
pwm:ImpactExecution a skos:Concept ; skos:inScheme pwm:ClientImpactClassScheme ; skos:topConceptOf pwm:ClientImpactClassScheme ; skos:notation "6" ; skos:prefLabel "execution"@en ; skos:definition "Contributes to executing a transaction."@en .

pwm:DecisionConsequenceScheme a skos:ConceptScheme ;
    skos:prefLabel "decision consequences"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.DECISION_CONSEQUENCE" ] .
pwm:ConsequenceInformational a skos:Concept ; skos:inScheme pwm:DecisionConsequenceScheme ; skos:topConceptOf pwm:DecisionConsequenceScheme ; skos:prefLabel "informational"@en ; skos:definition "Informs only."@en .
pwm:ConsequenceOperational a skos:Concept ; skos:inScheme pwm:DecisionConsequenceScheme ; skos:topConceptOf pwm:DecisionConsequenceScheme ; skos:prefLabel "operational"@en ; skos:definition "Changes an internal operation."@en .
pwm:ConsequenceClientCommunication a skos:Concept ; skos:inScheme pwm:DecisionConsequenceScheme ; skos:topConceptOf pwm:DecisionConsequenceScheme ; skos:prefLabel "client communication"@en ; skos:definition "Determines what reaches a client."@en .
pwm:ConsequenceSuitability a skos:Concept ; skos:inScheme pwm:DecisionConsequenceScheme ; skos:topConceptOf pwm:DecisionConsequenceScheme ; skos:prefLabel "suitability"@en ; skos:definition "Bears on whether advice is suitable."@en .
pwm:ConsequenceFinancialAction a skos:Concept ; skos:inScheme pwm:DecisionConsequenceScheme ; skos:topConceptOf pwm:DecisionConsequenceScheme ; skos:prefLabel "financial action"@en ; skos:definition "Moves value or changes a position."@en .

pwm:AutonomyAxisScheme a skos:ConceptScheme ;
    skos:prefLabel "use-case autonomy axis"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.AUTONOMY_AXIS" ] .
pwm:AutonomyNone a skos:Concept ; skos:inScheme pwm:AutonomyAxisScheme ; skos:topConceptOf pwm:AutonomyAxisScheme ; skos:prefLabel "none"@en ; skos:definition "No autonomous action."@en .
pwm:AutonomyAssisted a skos:Concept ; skos:inScheme pwm:AutonomyAxisScheme ; skos:topConceptOf pwm:AutonomyAxisScheme ; skos:prefLabel "assisted"@en ; skos:definition "Assists a person who acts."@en .
pwm:AutonomyConditional a skos:Concept ; skos:inScheme pwm:AutonomyAxisScheme ; skos:topConceptOf pwm:AutonomyAxisScheme ; skos:prefLabel "conditional"@en ; skos:definition "Acts under conditions or approval."@en .
pwm:AutonomyHigh a skos:Concept ; skos:inScheme pwm:AutonomyAxisScheme ; skos:topConceptOf pwm:AutonomyAxisScheme ; skos:prefLabel "high"@en ; skos:definition "Acts with little human involvement."@en .

pwm:PrimaryMetricScheme a skos:ConceptScheme ;
    skos:prefLabel "primary outcome metrics"@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "usecases.PRIMARY_METRICS" ] , [ pwm:cites pwmref:EVOLVE ; pwm:locator "Measure what matters" ] .
pwm:MetricCycleTime a skos:Concept ; skos:inScheme pwm:PrimaryMetricScheme ; skos:topConceptOf pwm:PrimaryMetricScheme ; skos:prefLabel "cycle time"@en ; skos:definition "Time to complete the workflow; breaches above target."@en .
pwm:MetricDecisionQuality a skos:Concept ; skos:inScheme pwm:PrimaryMetricScheme ; skos:topConceptOf pwm:PrimaryMetricScheme ; skos:prefLabel "decision quality"@en ; skos:definition "Share of outputs meeting the standard; breaches below target."@en .
pwm:MetricReliability a skos:Concept ; skos:inScheme pwm:PrimaryMetricScheme ; skos:topConceptOf pwm:PrimaryMetricScheme ; skos:prefLabel "reliability"@en ; skos:definition "Share of runs completing without failure; breaches below target."@en .
pwm:MetricKnowledgeRetention a skos:Concept ; skos:inScheme pwm:PrimaryMetricScheme ; skos:topConceptOf pwm:PrimaryMetricScheme ; skos:prefLabel "knowledge retention"@en ;
    skos:definition "Capability that remains when people leave. An EVOLVE measure; not a Kognita primary metric."@en .

pwm:GovernanceRiskScheme a skos:ConceptScheme ;
    skos:prefLabel "agentic governance risks"@en ;
    skos:scopeNote "Five risks that sit on top of model risk when AI moves from assistance to action."@en ;
    pwm:inModule pwm:ModuleGovernance ;
    pwm:citation [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 02: five risks" ] .
pwm:RiskAccess a skos:Concept ; skos:inScheme pwm:GovernanceRiskScheme ; skos:topConceptOf pwm:GovernanceRiskScheme ; skos:prefLabel "access"@en ; skos:definition "An agent inherits whatever its tools can reach."@en .
pwm:RiskEvidence a skos:Concept ; skos:inScheme pwm:GovernanceRiskScheme ; skos:topConceptOf pwm:GovernanceRiskScheme ; skos:prefLabel "evidence"@en ; skos:definition "The chain of retrievals, judgements and actions is not kept."@en .
pwm:RiskOperational a skos:Concept ; skos:inScheme pwm:GovernanceRiskScheme ; skos:topConceptOf pwm:GovernanceRiskScheme ; skos:prefLabel "operational"@en ; skos:definition "Agents loop, stall, call the wrong tool or keep moving when they should stop."@en .
pwm:RiskChange a skos:Concept ; skos:inScheme pwm:GovernanceRiskScheme ; skos:topConceptOf pwm:GovernanceRiskScheme ; skos:prefLabel "change"@en ; skos:definition "Behaviour changes with a prompt, tool, source or silent model update."@en .
pwm:RiskOwnership a skos:Concept ; skos:inScheme pwm:GovernanceRiskScheme ; skos:topConceptOf pwm:GovernanceRiskScheme ; skos:prefLabel "ownership"@en ; skos:definition "No named person is accountable for what the agent did."@en .

# Live control state is separate from cached governance configuration.
pwm:AuthorityLiveStatus a owl:Class ;
    rdfs:label "authority live status"@en ;
    skos:definition "Live observation of the revocation state of a DelegatedAuthority or the engaged state of a KillSwitch, effective from asOf until superseded. Read from the system of record at decision time, never from cache."@en ;
    skos:scopeNote "The single live-status vocabulary for delegation revocation and kill-switch state, retained for reuse in 0.5 without a parallel class or code list. DelegatedAuthority and KillSwitch definitions remain in SlowContext. For each subject, use the latest observation at or before the decision time. Conflicting observations at that time fail closed. SHACL checks recorded observations; runtime must obtain fresh state."@en ;
    rdfs:subClassOf prov:Entity ; pwm:contextSpeed pwm:FastContext ; pwm:defaultClassification pwm:C2 ;
    pwm:inModule pwm:ModuleGovernance ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14: circuit breaker and granular revocation; 0.3 item 2: policy evaluation boundaries" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:statusOf a owl:ObjectProperty ; rdfs:label "status of"@en ; skos:definition "Authority or kill switch whose live state is observed."@en ; rdfs:domain pwm:AuthorityLiveStatus ; rdfs:range [ a owl:Class ; owl:unionOf ( pwm:DelegatedAuthority pwm:KillSwitch ) ] ; pwm:inModule pwm:ModuleGovernance ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14: circuit breaker and granular revocation; 0.3 item 2: policy evaluation boundaries" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:observedBy a owl:ObjectProperty ; rdfs:label "observed by"@en ; skos:definition "Agent that obtained the live observation from the system of record."@en ; rdfs:domain pwm:AuthorityLiveStatus ; rdfs:range prov:Agent ; pwm:inModule pwm:ModuleGovernance ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14: circuit breaker and granular revocation; 0.3 item 2: policy evaluation boundaries" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:revoked a owl:DatatypeProperty ; rdfs:label "revoked"@en ; skos:definition "Whether the delegated authority is currently revoked."@en ; rdfs:domain pwm:AuthorityLiveStatus ; rdfs:range xsd:boolean ; pwm:inModule pwm:ModuleGovernance ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14: circuit breaker and granular revocation; 0.3 item 2: policy evaluation boundaries" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

pwm:engaged a owl:DatatypeProperty ; rdfs:label "engaged"@en ; skos:definition "Whether the kill switch is currently engaged."@en ; rdfs:domain pwm:AuthorityLiveStatus ; rdfs:range xsd:boolean ; pwm:inModule pwm:ModuleGovernance ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14: circuit breaker and granular revocation; 0.3 item 2: policy evaluation boundaries" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9: human oversight" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialised record or field; no exact standard term identified" ] .

# =============================================================================
#  Module 9: Information governance, claims and evidence
# =============================================================================

pwm:GovernedInformationAsset a owl:Class ;
    rdfs:label "governed information asset"@en ;
    skos:definition "Document, record or dataset carrying the minimum governance labels that make it safe to give to AI: owner, approval status, effective date, what it supersedes, classification per section, version identifier or content hash, and retention date."@en ;
    skos:scopeNote "When content is deleted, keep its hash and record the deletion."@en ;
    rdfs:subClassOf cmns-doc:Document ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: minimum labels" ] ,
                 [ pwm:cites pwmref:ISO-15489 ; pwm:locator "Records: authenticity, reliability, integrity, usability" ] ,
                 [ pwm:cites pwmref:DCMI-TERMS ; pwm:locator "dcterms:valid, dcterms:replaces" ] .

pwm:DocumentSection a owl:Class ;
    rdfs:label "document section"@en ;
    skos:definition "Section of a governed information asset with its own classification, so entitlements apply per section rather than per document."@en ;
    rdfs:subClassOf cmns-doc:Document ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: classification per section, not per document" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 1: per-section classification at ingestion" ] .

pwm:ApprovedSource a owl:Class ;
    rdfs:label "approved source"@en ;
    skos:definition "Source registered as approved for a use case's regulated claims, such as CIO research, product documentation, permitted market data or policy. A model's own knowledge is never an approved source."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 3: approved-source grounding" ] .

pwm:GovernedDefinition a owl:Class ;
    rdfs:label "governed definition"@en ;
    skos:definition "Authoritative, versioned definition of a business term, such as assets under management, net new money or concentration, with an owner. Figures using the term must cite it."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 5: define truth once (one definition of AUM)" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 12: governed business definitions" ] .

pwm:CalculationService a owl:Class ;
    rdfs:label "calculation service"@en ;
    skos:definition "Registered service that produces authoritative figures, such as performance, valuation, concentration, exposure or suitability scores. A model may explain a calculation; it may not invent one."@en ;
    rdfs:subClassOf prov:SoftwareAgent ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 6: calculation provenance" ] .

pwm:Fact a owl:Class ;
    rdfs:label "fact"@en ;
    skos:definition "Authoritative value from a system of record, carrying its source, owner, as-of time, classification, entitlement and freshness threshold. Stale facts are refreshed, suppressed or flagged, never silently used."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 2: fact contract and freshness" ] .

pwm:Claim a owl:Class ;
    rdfs:label "claim"@en ;
    skos:definition "Material statement an agent produces for a person or client, typed as verified fact, inference, conversation hypothesis or possible provider capability, with its sources, calculation method, model and prompt versions and validator status."@en ;
    skos:scopeNote "Unlabelled claims cannot be shown. An inference cannot be relabelled as fact without a cited source and verification."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 items 1, 5, 7: claim provenance, claim types, verification gate" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiables 6 and 7" ] .

pwm:PolicyRule a owl:Class ;
    rdfs:label "policy rule"@en ;
    skos:definition "Effective-dated, citable rule evaluated outside the model before data moves or an action runs. Rules are versioned, never edited in place."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:SlowContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Design rule: never rely on the LLM to enforce a control that can be enforced outside it" ] ,
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.25(b): change control and version control" ] .

pwm:PolicyDecision a owl:Class ;
    rdfs:label "policy decision"@en ;
    skos:definition "Deterministic outcome of evaluating every applicable rule for a request, allow, deny, escalate or hold for human approval, citing the deciding rule and its version, the use case and any delegation relied on. One failing rule denies."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 9: runtime policy enforcement outside the LLM" ] ,
                 [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.Outcome, OUTCOME_PRECEDENCE" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 14: the AI answer receipt, for approvals and denials" ] .

pwm:EvidenceRecord a owl:Class ;
    rdfs:label "evidence record"@en ;
    skos:definition "Append-only, hash-chained record of an event, such as a policy decision, model call, tool call, retrieval, approval or communication, holding hashes and references rather than content, from which an interaction can be reconstructed."@en ;
    skos:scopeNote "Record a model refusal separately from a policy denial. Otherwise the evidence shows only that the model usually behaves, not that the controls work."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): logging of prompts, responses, model versions; 5.17 reproducibility" ] ,
                 [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Non-negotiable 12: complete action audit trail" ] ,
                 [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 15: append-only, tamper-evident; log refusals and blocks separately" ] .

pwm:HumanReview a owl:Class ;
    rdfs:label "human review"@en ;
    skos:definition "Review of AI output or a proposed action by a competent person with authority to intervene, given a complete packet of action, reason, evidence, risks, alternatives and checks run."@en ;
    rdfs:subClassOf prov:Activity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(a) to (d): human oversight; automation bias and decision fatigue" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11 (approval packet); item 13 (risk-based review)" ] .

pwm:AIIncident a owl:Class ;
    rdfs:label "AI incident"@en ;
    skos:definition "Incident involving a failure, malfunction or poor performance of an AI system or model, escalated, tracked and linked to the clients affected."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "fn 20 (definition); 3.5(e) escalation; 5.23(b) incident management" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 14 (affected-client query); 0.7 (incident evidence and report)" ] .

pwm:NearMiss a owl:Class ;
    rdfs:label "near miss"@en ;
    skos:definition "Event where harm was avoided, such as a blocked action, a verifier block, a reviewer rejection, an unsafe draft or unusual agent behaviour, aggregated to find weak controls before harm occurs."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): review incidents and near misses" ] ,
                 [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15: near-miss register" ] .

pwm:MemoryRecord a owl:Class ;
    rdfs:label "memory record"@en ;
    skos:definition "Item an agent retains beyond a single step, scoped as working, relationship or institutional memory and typed like a claim, with retention, a correction path and expiry."@en ;
    skos:scopeNote "An inference becomes a relationship record only after verification by a person. Client data never enters institutional memory."@en ;
    rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:contextSpeed pwm:MediumContext ;
    pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 8: memory governance" ] ,
                 [ pwm:cites pwmref:EVOLVE ; pwm:locator "Closed-loop learning; human expertise becomes institutional capability" ] .

# --- Properties --------------------------------------------------------------------

pwm:informationOwner a owl:ObjectProperty ;
    rdfs:label "information owner"@en ;
    skos:definition "Role accountable for a governed information asset or definition."@en ;
    rdfs:range cmns-pts:PartyRole ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: owner" ] .

pwm:approvalStatus a owl:ObjectProperty ;
    rdfs:label "approval status"@en ;
    skos:definition "Approval status of a governed information asset: draft, current, superseded or withdrawn."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slides 8 and 9: approval status" ] .

pwm:versionId a owl:DatatypeProperty ;
    rdfs:label "version identifier"@en ;
    skos:definition "Version identifier of an asset, definition, rule, model or deployment."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: version ID or content hash" ] .

pwm:retentionUntil a owl:DatatypeProperty ;
    rdfs:label "retention until"@en ;
    skos:definition "Date until which a record must be kept. An AI record never expires before the regulatory record it supports."@en ;
    rdfs:range xsd:date ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8: retention date" ] , [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.7: retention by record class" ] .

pwm:hasSection a owl:ObjectProperty ;
    rdfs:label "has section"@en ;
    skos:definition "Section of a governed information asset."@en ;
    rdfs:domain pwm:GovernedInformationAsset ; rdfs:range pwm:DocumentSection ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 8" ] .

pwm:classification a owl:ObjectProperty ;
    rdfs:label "classification"@en ;
    skos:definition "Data classification of an asset, section, fact or record."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.4(d)" ] , [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.Classification" ] .

pwm:approvedForUseCase a owl:ObjectProperty ;
    rdfs:label "approved for use case"@en ;
    skos:definition "Use case for which a source is approved."@en ;
    rdfs:domain pwm:ApprovedSource ; rdfs:range pwm:AIUseCase ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 3: each use case has a register of approved sources" ] .

pwm:definesTerm a owl:DatatypeProperty ;
    rdfs:label "defines term"@en ;
    skos:definition "Business term a governed definition defines."@en ;
    rdfs:domain pwm:GovernedDefinition ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 12" ] .

pwm:claimType a owl:ObjectProperty ;
    rdfs:label "claim type"@en ;
    skos:definition "Epistemic type of a claim or memory record."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "claims: VERIFIED_FACT, INFERENCE, CONVERSATION_HYPOTHESIS, POSSIBLE_BANK_CAPABILITY" ] .

pwm:validatorStatus a owl:ObjectProperty ;
    rdfs:label "validator status"@en ;
    skos:definition "Verdict of an independent verifier on a claim. Policy decides what each status may reach."@en ;
    rdfs:domain pwm:Claim ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 7: verification gate" ] .

pwm:citesSource a owl:ObjectProperty ;
    rdfs:label "cites source"@en ;
    skos:definition "Approved source, governed asset or fact a claim relies on."@en ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 items 1, 3" ] .

pwm:usesDefinition a owl:ObjectProperty ;
    rdfs:label "uses definition"@en ;
    skos:definition "Governed definition, at a version, that a claim or figure uses."@en ;
    rdfs:range pwm:GovernedDefinition ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 12" ] .

pwm:calculatedBy a owl:ObjectProperty ;
    rdfs:label "calculated by"@en ;
    skos:definition "Calculation service that produced a figure."@en ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:range pwm:CalculationService ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 6: calculation_method" ] .

pwm:asOf a owl:DatatypeProperty ;
    rdfs:label "as of"@en ;
    skos:definition "Time at which a fact, valuation or live authority status was true in its system of record."@en ;
    rdfs:range xsd:dateTime ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 2: as-of date" ] .

pwm:freshnessThreshold a owl:DatatypeProperty ;
    rdfs:label "freshness threshold"@en ;
    skos:definition "Maximum age at which a fact may still be used, as an xsd:duration."@en ;
    rdfs:domain pwm:Fact ; rdfs:range xsd:duration ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 2: freshness thresholds per data type" ] .

pwm:staleAction a owl:ObjectProperty ;
    rdfs:label "stale action"@en ;
    skos:definition "What happens when a fact is older than its threshold."@en ;
    rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.StaleAction" ] .

pwm:ruleCitation a owl:DatatypeProperty ;
    rdfs:label "rule citation"@en ;
    skos:definition "Text citing the policy, regulation or standard a rule implements."@en ;
    rdfs:domain pwm:PolicyRule ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Every decision citable to policy" ] .

pwm:decisionOutcome a owl:ObjectProperty ;
    rdfs:label "decision outcome"@en ;
    skos:definition "Outcome of a policy decision."@en ;
    rdfs:domain pwm:PolicyDecision ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.Outcome" ] .

pwm:decidedByRule a owl:ObjectProperty ;
    rdfs:label "decided by rule"@en ;
    skos:definition "Rule, at its version, that determined a policy decision."@en ;
    rdfs:domain pwm:PolicyDecision ; rdfs:range pwm:PolicyRule ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 14: the rule and rule version that decided it" ] .

pwm:underUseCase a owl:ObjectProperty ;
    rdfs:label "under use case"@en ;
    skos:definition "Registered use case a decision, claim or event was produced under."@en ;
    rdfs:range pwm:AIUseCase ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: every decision must reference a registered use case" ] .

pwm:reliesOnDelegation a owl:ObjectProperty ;
    rdfs:label "relies on delegation"@en ;
    skos:definition "Delegated authority a decision or action relied on."@en ;
    rdfs:range pwm:DelegatedAuthority ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.5 item 2: every decision references the delegation it relied on" ] .

pwm:eventType a owl:ObjectProperty ;
    rdfs:label "event type"@en ;
    skos:definition "Kind of event an evidence record captures."@en ;
    rdfs:domain pwm:EvidenceRecord ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.EventType" ] .

pwm:evidenceFor a owl:ObjectProperty ;
    rdfs:label "evidence for"@en ;
    skos:definition "Decision, action, communication or other record that an evidence record documents. The record points to it by identifier and hash and does not copy its content."@en ;
    rdfs:domain pwm:EvidenceRecord ;
    rdfs:subPropertyOf dcterms:references ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Hash-chained evidence" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d)" ] .

pwm:recordHash a owl:DatatypeProperty ;
    rdfs:label "record hash"@en ;
    skos:definition "Hash of an evidence record, chained to the previous record so deletion or alteration is detectable."@en ;
    rdfs:domain pwm:EvidenceRecord ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Hash-chained evidence" ] .

pwm:previousRecordHash a owl:DatatypeProperty ;
    rdfs:label "previous record hash"@en ;
    skos:definition "Hash of the record that precedes this one in the chain. Required on every record except the first in a chain."@en ;
    rdfs:domain pwm:EvidenceRecord ; rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Hash-chained evidence" ] .

pwm:chainStart a owl:DatatypeProperty ;
    rdfs:label "chain start"@en ;
    skos:definition "True on the first record of an evidence chain, the only record without a previous record hash."@en ;
    rdfs:domain pwm:EvidenceRecord ; rdfs:range xsd:boolean ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-CONTROLS ; pwm:locator "Hash-chained evidence" ] .

pwm:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version"@en ;
    skos:definition "Provider model version as served for a model call, claim or evaluation."@en ;
    rdfs:range xsd:string ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.23(d): applicable model versions" ] .

pwm:memoryScope a owl:ObjectProperty ;
    rdfs:label "memory scope"@en ;
    skos:definition "Scope of a memory record."@en ;
    rdfs:domain pwm:MemoryRecord ; rdfs:range skos:Concept ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "memory.MemoryScope" ] .

# --- Concept schemes -------------------------------------------------------------------

pwm:DataClassificationScheme a skos:ConceptScheme ;
    skos:prefLabel "data classifications"@en ;
    skos:scopeNote "Ordered by sensitivity. Compare by rank, never by label: entitlement filtering and egress control depend on the order."@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.Classification" ] , [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.4(d)" ] .
pwm:C0 a skos:Concept ; skos:inScheme pwm:DataClassificationScheme ; skos:topConceptOf pwm:DataClassificationScheme ; skos:notation "C0" ;
    skos:prefLabel "public"@en ; skos:definition "Approved for public release."@en .
pwm:C1 a skos:Concept ; skos:inScheme pwm:DataClassificationScheme ; skos:topConceptOf pwm:DataClassificationScheme ; skos:notation "C1" ;
    skos:prefLabel "internal"@en ; skos:definition "For staff; no client identity."@en .
pwm:C2 a skos:Concept ; skos:inScheme pwm:DataClassificationScheme ; skos:topConceptOf pwm:DataClassificationScheme ; skos:notation "C2" ;
    skos:prefLabel "confidential"@en ; skos:altLabel "client-identifying"@en ;
    skos:definition "Identifies a client; within banking secrecy where it applies."@en ; skos:closeMatch dpv:PersonalData .
pwm:C3 a skos:Concept ; skos:inScheme pwm:DataClassificationScheme ; skos:topConceptOf pwm:DataClassificationScheme ; skos:notation "C3" ;
    skos:prefLabel "restricted"@en ; skos:altLabel "need-to-know"@en , "highly sensitive"@en ;
    skos:definition "Need-to-know only, such as screening hits, investigations, special-category data and material non-public information."@en ;
    skos:closeMatch dpv:SpecialCategoryPersonalData .

pwm:DecisionOutcomeScheme a skos:ConceptScheme ;
    skos:prefLabel "policy decision outcomes"@en ;
    skos:scopeNote "Resolution is fail-closed: the most severe outcome present decides, in the order deny, escalate, human approval, allow."@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.Outcome, OUTCOME_PRECEDENCE" ] .
pwm:OutcomeDeny a skos:Concept ; skos:inScheme pwm:DecisionOutcomeScheme ; skos:topConceptOf pwm:DecisionOutcomeScheme ; skos:notation "DENY" ;
    skos:prefLabel "deny"@en ; skos:definition "Refused; nothing moves."@en .
pwm:OutcomeEscalate a skos:Concept ; skos:inScheme pwm:DecisionOutcomeScheme ; skos:topConceptOf pwm:DecisionOutcomeScheme ; skos:notation "ESCALATE" ;
    skos:prefLabel "escalate"@en ; skos:definition "Uncertain; referred to a person."@en .
pwm:OutcomeHumanApproval a skos:Concept ; skos:inScheme pwm:DecisionOutcomeScheme ; skos:topConceptOf pwm:DecisionOutcomeScheme ; skos:notation "HUMAN_APPROVAL" ;
    skos:prefLabel "human approval"@en ; skos:definition "Held until a named person approves this exact action."@en .
pwm:OutcomeAllow a skos:Concept ; skos:inScheme pwm:DecisionOutcomeScheme ; skos:topConceptOf pwm:DecisionOutcomeScheme ; skos:notation "ALLOW" ;
    skos:prefLabel "allow"@en ; skos:definition "Every rule passed."@en .
pwm:OutcomeObserve a skos:Concept ; skos:inScheme pwm:DecisionOutcomeScheme ; skos:topConceptOf pwm:DecisionOutcomeScheme ; skos:notation "OBSERVE" ;
    skos:prefLabel "observe"@en ; skos:definition "Recorded without gating, in monitor-only deployments."@en .

pwm:ClaimTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "claim types"@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 5" ] , [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "claims.ClaimType" ] .
pwm:VerifiedFact a skos:Concept ; skos:inScheme pwm:ClaimTypeScheme ; skos:topConceptOf pwm:ClaimTypeScheme ;
    skos:prefLabel "verified fact"@en ; skos:definition "Backed by a cited source and verification."@en .
pwm:Inference a skos:Concept ; skos:inScheme pwm:ClaimTypeScheme ; skos:topConceptOf pwm:ClaimTypeScheme ;
    skos:prefLabel "inference"@en ; skos:definition "Reasoned from facts; not itself verified."@en .
pwm:ConversationHypothesis a skos:Concept ; skos:inScheme pwm:ClaimTypeScheme ; skos:topConceptOf pwm:ClaimTypeScheme ;
    skos:prefLabel "conversation hypothesis"@en ; skos:definition "Something worth raising with the client, to be tested in conversation."@en .
pwm:PossibleProviderCapability a skos:Concept ; skos:inScheme pwm:ClaimTypeScheme ; skos:topConceptOf pwm:ClaimTypeScheme ;
    skos:prefLabel "possible provider capability"@en ; skos:altLabel "possible bank capability"@en ;
    skos:definition "Something the institution might be able to offer, not yet confirmed."@en .

pwm:ValidatorStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "validator statuses"@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.6 item 7" ] , [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "claims.ValidatorStatus" ] .
pwm:ValidatorVerified a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "verified"@en ; skos:definition "Verifier confirmed it."@en .
pwm:ValidatorInferred a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "inferred"@en ; skos:definition "Supported only by inference."@en .
pwm:ValidatorUnverified a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "unverified"@en ; skos:definition "Not yet checked."@en .
pwm:ValidatorConflicting a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "conflicting"@en ; skos:definition "Sources disagree."@en .
pwm:ValidatorStale a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "stale"@en ; skos:definition "Relies on data past its freshness threshold."@en .
pwm:ValidatorBlocked a skos:Concept ; skos:inScheme pwm:ValidatorStatusScheme ; skos:topConceptOf pwm:ValidatorStatusScheme ; skos:prefLabel "blocked"@en ; skos:definition "May not be released."@en .

pwm:AssetStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "information asset statuses"@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 9: superseded, current, draft" ] .
pwm:AssetDraft a skos:Concept ; skos:inScheme pwm:AssetStatusScheme ; skos:topConceptOf pwm:AssetStatusScheme ; skos:prefLabel "draft"@en ; skos:definition "Not approved; never given to AI as authoritative."@en .
pwm:AssetCurrent a skos:Concept ; skos:inScheme pwm:AssetStatusScheme ; skos:topConceptOf pwm:AssetStatusScheme ; skos:prefLabel "current"@en ; skos:definition "Approved and in force."@en .
pwm:AssetSuperseded a skos:Concept ; skos:inScheme pwm:AssetStatusScheme ; skos:topConceptOf pwm:AssetStatusScheme ; skos:prefLabel "superseded"@en ; skos:definition "Replaced by a later version; kept for reconstruction only."@en .
pwm:AssetWithdrawn a skos:Concept ; skos:inScheme pwm:AssetStatusScheme ; skos:topConceptOf pwm:AssetStatusScheme ; skos:prefLabel "withdrawn"@en ; skos:definition "Withdrawn without replacement."@en .

pwm:StaleActionScheme a skos:ConceptScheme ;
    skos:prefLabel "stale-data actions"@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.StaleAction" ] .
pwm:StaleRefresh a skos:Concept ; skos:inScheme pwm:StaleActionScheme ; skos:topConceptOf pwm:StaleActionScheme ; skos:prefLabel "refresh"@en ; skos:definition "Fetch a current value before use."@en .
pwm:StaleSuppress a skos:Concept ; skos:inScheme pwm:StaleActionScheme ; skos:topConceptOf pwm:StaleActionScheme ; skos:prefLabel "suppress"@en ; skos:definition "Do not use the value."@en .
pwm:StaleWarn a skos:Concept ; skos:inScheme pwm:StaleActionScheme ; skos:topConceptOf pwm:StaleActionScheme ; skos:prefLabel "warn"@en ; skos:definition "Use with a visible staleness warning."@en .

pwm:MemoryScopeScheme a skos:ConceptScheme ;
    skos:prefLabel "memory scopes"@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "memory.MemoryScope" ] .
pwm:MemoryWorking a skos:Concept ; skos:inScheme pwm:MemoryScopeScheme ; skos:topConceptOf pwm:MemoryScopeScheme ; skos:prefLabel "working"@en ; skos:definition "Temporary context; expires with the run."@en .
pwm:MemoryRelationship a skos:Concept ; skos:inScheme pwm:MemoryScopeScheme ; skos:topConceptOf pwm:MemoryScopeScheme ; skos:prefLabel "relationship"@en ; skos:definition "Durable client information, governed like any bank record."@en .
pwm:MemoryInstitutional a skos:Concept ; skos:inScheme pwm:MemoryScopeScheme ; skos:topConceptOf pwm:MemoryScopeScheme ; skos:prefLabel "institutional"@en ; skos:definition "What the organisation learns across clients; no client data."@en .

pwm:EvidenceEventTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "evidence event types"@en ;
    skos:scopeNote "Notations match Kognita EventType values. Model refusal is added from the Filing Cabinet talk so refusals and policy denials are logged apart."@en ;
    pwm:inModule pwm:ModuleEvidence ;
    pwm:citation [ pwm:cites pwmref:KOG-VOCAB ; pwm:locator "vocabulary.EventType" ] , [ pwm:cites pwmref:AM-FILING-CABINET ; pwm:locator "Slide 15" ] .
pwm:EventPolicyDecision a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "POLICY_DECISION" ; skos:prefLabel "policy decision"@en ; skos:definition "A decision was taken."@en .
pwm:EventModelCall a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "MODEL_CALL" ; skos:prefLabel "model call"@en ; skos:definition "A model was called; provider, version and prompt and response hashes recorded."@en .
pwm:EventToolCall a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "TOOL_CALL" ; skos:prefLabel "tool call"@en ; skos:definition "A tool was invoked; arguments recorded as hashes."@en .
pwm:EventRetrieval a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "RETRIEVAL" ; skos:prefLabel "retrieval"@en ; skos:definition "Content was retrieved, with item hashes."@en .
pwm:EventApproval a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "APPROVAL" ; skos:prefLabel "approval"@en ; skos:definition "A person signed an approval."@en .
pwm:EventEgress a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "EGRESS" ; skos:prefLabel "egress"@en ; skos:definition "Data left for a provider, allowed, redacted or denied."@en .
pwm:EventPolicyChange a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "POLICY_CHANGE" ; skos:prefLabel "policy change"@en ; skos:definition "A rule or register entry changed."@en .
pwm:EventOrigination a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "ORIGINATION" ; skos:prefLabel "origination"@en ; skos:definition "A client or product was selected."@en .
pwm:EventFinalDecision a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "FINAL_DECISION" ; skos:prefLabel "final decision"@en ; skos:definition "A person decided."@en .
pwm:EventClientCommunication a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "CLIENT_COMMUNICATION" ; skos:prefLabel "client communication"@en ; skos:definition "Something was sent to a client."@en .
pwm:EventIntervention a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "INTERVENTION" ; skos:prefLabel "intervention"@en ; skos:definition "A person paused, overrode, restricted, revoked or recovered a live run."@en .
pwm:EventOutcome a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "OUTCOME" ; skos:prefLabel "outcome"@en ; skos:definition "A complaint, correction or other outcome was linked to the interaction."@en .
pwm:EventNearMiss a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "NEAR_MISS" ; skos:prefLabel "near miss"@en ; skos:definition "A near miss was recorded."@en .
pwm:EventClaim a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "CLAIM" ; skos:prefLabel "claim"@en ; skos:definition "A claim was recorded."@en .
pwm:EventIncidentOpened a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "INCIDENT_OPENED" ; skos:prefLabel "incident opened"@en ; skos:definition "An AI incident was opened."@en .
pwm:EventErasure a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "ERASURE" ; skos:prefLabel "erasure"@en ; skos:definition "Content was erased; the chain stays verifiable."@en .
pwm:EventModelRefusal a skos:Concept ; skos:inScheme pwm:EvidenceEventTypeScheme ; skos:topConceptOf pwm:EvidenceEventTypeScheme ; skos:notation "MODEL_REFUSAL" ; skos:prefLabel "model refusal"@en ;
    skos:definition "The model declined, as distinct from a policy denial."@en .

# -----------------------------------------------------------------------------
#  Code-list bindings
#
#  Which code list each coded property takes its values from. The ranges above
#  say only skos:Concept; these annotations name the scheme. An extension may
#  bind a property to its own scheme instead, for example a firm's risk scale
#  in place of the illustrative one.
# -----------------------------------------------------------------------------

pwm:actionVerb pwm:valuesFrom pwm:ActionVerbScheme .
pwm:amlRiskLevel pwm:valuesFrom pwm:AMLRiskLevelScheme .
