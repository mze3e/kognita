    pwm:sourceType pwm:SourceStandardOntology ;
    pwm:jurisdiction "Global" ;
    pwm:verificationStatus "instrument-level" .

pwmref:DCMI-TERMS a pwm:Reference ;
    dcterms:alternative "DCMI Terms" ;
    dcterms:title "DCMI Metadata Terms" ;
    dcterms:publisher "Dublin Core Metadata Initiative" ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> ;
