# =============================================================================
#  PWM 0.5 SHACL shapes
#
#  The rules from the ontology that can be checked on data. Each shape names
#  the references it enforces (dcterms:source) and each message gives the
#  paragraph or item. Validate data together with pwm.ttl, with RDFS
#  inference on, so that subclass targets and sub-properties resolve:
#
#    pyshacl -s pwm-shapes.ttl -e pwm.ttl -i rdfs data.ttl
# =============================================================================

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix fibo-fnd-aap-ppl: <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/> .
@prefix pwm:      <https://ahmedmuzammil.com/ontology/pwm#> .
@prefix pwmref:   <https://ahmedmuzammil.com/ontology/pwm#ref-> .
@prefix pwmsh:    <https://ahmedmuzammil.com/ontology/pwm/shapes#> .

<https://ahmedmuzammil.com/ontology/pwm/shapes>
    a owl:Ontology ;
    owl:versionIRI <https://ahmedmuzammil.com/ontology/pwm/0.5/pwm-shapes.ttl> ;
    owl:versionInfo "0.5 (draft)" ;
    owl:priorVersion <https://ahmedmuzammil.com/ontology/pwm/0.4/pwm-shapes.ttl> ;
    dcterms:created "2026-11-02"^^xsd:date ;
    dcterms:modified "2026-11-04"^^xsd:date ;
    dcterms:title "Private Wealth Management Ontology: SHACL shapes"@en ;
    dcterms:description "Data rules for the Private Wealth Management Ontology 0.5. Shapes stay generic; a firm adds its own thresholds and jurisdiction rules in a separate shapes graph."@en ;
    dcterms:creator "Ahmed Muzammil" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:requires <https://ahmedmuzammil.com/ontology/pwm/0.5> ;
    sh:declare [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ;
    sh:declare
        [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "pwm" ; sh:namespace "https://ahmedmuzammil.com/ontology/pwm#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "cmns-rlcmp" ; sh:namespace "https://www.omg.org/spec/Commons/RolesAndCompositions/"^^xsd:anyURI ] .

# --- Accountability: a named person, never an agent --------------------------------------

pwmsh:AccountabilityRoleShape a sh:NodeShape ;
    rdfs:label "Accountability role"@en ;
    sh:targetClass pwm:AccountabilityRole ;
    dcterms:source pwmref:KOG-ROADMAP , pwmref:MAS-AIRG ;
    sh:property [
        sh:path cmns-rlcmp:isPlayedBy ;
        sh:minCount 1 ;
        sh:class fibo-fnd-aap-ppl:Person ;
        sh:message "An accountability role must be held by a named person (Kognita 0.4 item 8; MAS AIRG 4.7 key roles)." ;
    ] ;
    sh:property [
        sh:path cmns-rlcmp:isPlayedBy ;
        sh:not [ sh:class pwm:AIAgent ] ;
        sh:message "An AI agent can never be named in an accountability role (Kognita 0.4 item 8)." ;
    ] .

# --- AI use case register ----------------------------------------------------------------

pwmsh:AIUseCaseShape a sh:NodeShape ;
    rdfs:label "AI use case"@en ;
    sh:targetClass pwm:AIUseCase ;
    dcterms:source pwmref:MAS-AIRG , pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:hasPurpose ; sh:minCount 1 ;
        sh:message "A use case records its purpose (MAS AIRG 4.7)." ] ;
    sh:property [ sh:path pwm:approvedJurisdiction ; sh:minCount 1 ; sh:pattern "^[A-Z]{2}$" ;
        sh:message "A use case records its approved jurisdiction as an ISO 3166-1 alpha-2 code (MAS AIRG 4.7 approved scope of use)." ] ;
    sh:property [ sh:path pwm:lifecycleStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:StatusPilot pwm:StatusLive pwm:StatusSuspended pwm:StatusRetired ) ;
        sh:message "A use case has one lifecycle status: pilot, live, suspended or retired (MAS AIRG 4.7; Kognita 0.4 item 8)." ] ;
    sh:property [ sh:path pwm:riskTier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:Tier1 pwm:Tier2 pwm:Tier3 pwm:Tier4 ) ;
        sh:message "A use case has one risk tier, 1 to 4 (Kognita 0.4 item 8)." ] ;
    sh:property [ sh:path pwm:isMediated ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "A use case states whether the control plane mediates it. Embedded vendor AI is registered too, marked unmediated (Kognita 0.4 item 8; MAS AIRG 4.2)." ] ;
    sh:property [ sh:path pwm:nextReviewDate ; sh:minCount 1 ; sh:datatype xsd:date ;
        sh:message "A use case carries a review date set by its tier; past it, the use case is refused (Kognita 0.4 item 8)." ] ;
    sh:property [ sh:path pwm:hasAccountabilityRole ;
        sh:qualifiedValueShape [ sh:class pwm:BusinessOwner ] ; sh:qualifiedMinCount 1 ;
        sh:message "A use case with no business owner is refused (Kognita 0.4 item 8; MAS AIRG 4.7)." ] ;
    sh:or (
        [ sh:property [ sh:path pwm:riskTier ; sh:hasValue pwm:Tier1  ; sh:message "riskTier: required value Tier1." ] ]
        [ sh:property [ sh:path pwm:hasAccountabilityRole ;
            sh:qualifiedValueShape [ sh:class pwm:KnowledgeLead ] ; sh:qualifiedMinCount 1  ; sh:message "hasAccountabilityRole: satisfy the stated field restrictions." ] ]
    ) ;
    sh:message "A use case at tier 2 or above with no named Knowledge Lead is refused (Kognita 0.4 item 8)." .

pwmsh:LiveUseCaseShape a sh:NodeShape ;
    rdfs:label "Live use case"@en ;
    sh:targetClass pwm:AIUseCase ;
    dcterms:source pwmref:MAS-AIRG , pwmref:KOG-ROADMAP ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pwm:lifecycleStatus ; sh:hasValue pwm:StatusLive  ; sh:message "lifecycleStatus: required value StatusLive." ] ] ]
        [ sh:property [ sh:path pwm:hasMaterialityAssessment ;
            sh:qualifiedValueShape pwmsh:ApprovedMaterialityShape ; sh:qualifiedMinCount 1  ; sh:message "hasMaterialityAssessment: satisfy the stated field restrictions." ] ]
    ) ;
    sh:message "A live use case needs a materiality assessment with inherent and residual ratings, approved by the designated control function (MAS AIRG 4.11, 4.13; Kognita 0.4 item 8)." .

pwmsh:ApprovedMaterialityShape a sh:NodeShape ;
    rdfs:label "Approved materiality assessment"@en ;
    rdfs:comment "Used inside LiveUseCaseShape. Has no target of its own."@en ;
    sh:property [ sh:path pwm:approvedBy ; sh:minCount 1 ; sh:class pwm:DesignatedControlFunction  ; sh:message "approvedBy: minimum count 1; class DesignatedControlFunction." ] ;
    sh:property [ sh:path pwm:inherentMateriality ; sh:minCount 1  ; sh:message "inherentMateriality: minimum count 1." ] ;
    sh:property [ sh:path pwm:residualMateriality ; sh:minCount 1  ; sh:message "residualMateriality: minimum count 1." ] .

pwmsh:ControlFunctionSeparationShape a sh:NodeShape ;
    rdfs:label "Control function separation"@en ;
    sh:targetClass pwm:AIUseCase ;
    dcterms:source pwmref:KOG-ROADMAP , pwmref:MAS-AIRG ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The person who approves a use case's materiality rating for the control function cannot also be its business or technology owner (Kognita 0.4 item 8; MAS AIRG 4.13 independent oversight)." ;
        sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this pwm:hasMaterialityAssessment/pwm:approvedBy/cmns-rlcmp:isPlayedBy ?value .
                $this pwm:hasAccountabilityRole ?owner .
                ?owner cmns-rlcmp:isPlayedBy ?value .
                { ?owner a pwm:BusinessOwner } UNION { ?owner a pwm:TechnologyOwner }
            }
        """ ;
    ] .

pwmsh:RiskMaterialityAssessmentShape a sh:NodeShape ;
    rdfs:label "Risk materiality assessment"@en ;
    sh:targetClass pwm:RiskMaterialityAssessment ;
    dcterms:source pwmref:MAS-AIRG ;
    sh:property [ sh:path pwm:impact ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:RatingLow pwm:RatingMedium pwm:RatingHigh pwm:RatingCritical ) ;
        sh:message "Rate impact, low to critical (MAS AIRG 4.12(a))." ] ;
    sh:property [ sh:path pwm:complexity ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:RatingLow pwm:RatingMedium pwm:RatingHigh pwm:RatingCritical ) ;
        sh:message "Rate complexity, low to critical (MAS AIRG 4.12(b))." ] ;
    sh:property [ sh:path pwm:reliance ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:RatingLow pwm:RatingMedium pwm:RatingHigh pwm:RatingCritical ) ;
        sh:message "Rate reliance, including the autonomy granted, low to critical (MAS AIRG 4.12(c))." ] ;
    sh:property [ sh:path pwm:inherentMateriality ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Record materiality before controls (MAS AIRG 4.11)." ] ;
    sh:property [ sh:path pwm:residualMateriality ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Record materiality after controls (MAS AIRG 4.11)." ] .

# --- Agents, tools and delegated authority -------------------------------------------------

pwmsh:AIAgentShape a sh:NodeShape ;
    rdfs:label "AI agent"@en ;
    sh:targetClass pwm:AIAgent ;
    dcterms:source pwmref:MAS-AIRG , pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:agentIdentifier ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An agent has one identifier (MAS AIRG footnote 25; Kognita 0.5 item 1)." ] ;
    sh:property [ sh:path pwm:maxAutonomyLevel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:L0Retrieve pwm:L1Explain pwm:L2Recommend pwm:L3Draft pwm:L4ActAfterApproval pwm:L5BoundedAutonomy pwm:L6BroadAutonomy ) ;
        sh:message "An agent carries one maximum autonomy level, L0 to L6 (Kognita 0.5 item 3)." ] ;
    sh:property [ sh:path pwm:registeredForUseCase ; sh:minCount 1 ;
        sh:message "An agent is linked to at least one registered use case (Kognita 0.5 item 1)." ] ;
    sh:property [ sh:path pwm:deploymentVersion ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An agent's deployment version covers prompt, tools, permissions and data sources, not only code (Kognita 0.5 item 1; MAS AIRG 5.25(b))." ] ;
    sh:property [ sh:path pwm:nextReviewDate ; sh:minCount 1 ; sh:datatype xsd:date ;
        sh:message "An agent past its review date is refused, so it needs one (Kognita 0.5 item 1)." ] .

pwmsh:AgentToolLevelShape a sh:NodeShape ;
    rdfs:label "Agent tool level"@en ;
    sh:targetClass pwm:AIAgent ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An agent is permitted a tool that needs a higher autonomy level than the agent's maximum. A call above the agent's level is refused (Kognita 0.5 item 3)." ;
        sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        rdfs:comment "The level order is written into the query, so the check does not depend on the ontology's concept data being loaded with the data graph. An unknown level fails closed."@en ;
        sh:select """
            SELECT $this ?value WHERE {
                $this pwm:maxAutonomyLevel ?agentLevel ;
                      pwm:permittedTool ?value .
                ?value pwm:requiredAutonomyLevel ?toolLevel .
                BIND (IF(?agentLevel = pwm:L0Retrieve, 0, IF(?agentLevel = pwm:L1Explain, 1,
                      IF(?agentLevel = pwm:L2Recommend, 2, IF(?agentLevel = pwm:L3Draft, 3,
                      IF(?agentLevel = pwm:L4ActAfterApproval, 4, IF(?agentLevel = pwm:L5BoundedAutonomy, 5,
                      IF(?agentLevel = pwm:L6BroadAutonomy, 6, -1))))))) AS ?agentRank)
                BIND (IF(?toolLevel = pwm:L0Retrieve, 0, IF(?toolLevel = pwm:L1Explain, 1,
                      IF(?toolLevel = pwm:L2Recommend, 2, IF(?toolLevel = pwm:L3Draft, 3,
                      IF(?toolLevel = pwm:L4ActAfterApproval, 4, IF(?toolLevel = pwm:L5BoundedAutonomy, 5,
                      IF(?toolLevel = pwm:L6BroadAutonomy, 6, 99))))))) AS ?toolRank)
                FILTER (?toolRank > ?agentRank)
            }
        """ ;
    ] .

pwmsh:ToolShape a sh:NodeShape ;
    rdfs:label "Tool"@en ;
    sh:targetClass pwm:Tool ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:requiredAutonomyLevel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every tool declares the autonomy level it requires (Kognita 0.5 item 3)." ] ;
    sh:property [ sh:path pwm:actionVerb ; sh:minCount 1 ;
        sh:message "A tool declares the verbs it performs, because action permissions are per verb (Kognita 0.5 item 3)." ] .

pwmsh:DelegatedAuthorityShape a sh:NodeShape ;
    rdfs:label "Delegated authority"@en ;
    sh:targetClass pwm:DelegatedAuthority ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:delegatedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person ;
        sh:message "A delegation is granted by one named person (Kognita 0.5 item 2)." ] ;
    sh:property [ sh:path pwm:delegatedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIAgent ;
        sh:message "A delegation is granted to one registered agent (Kognita 0.5 item 2)." ] ;
    sh:property [ sh:path pwm:hasPurpose ; sh:minCount 1 ;
        sh:message "A delegation is bound to a purpose (Kognita 0.5 item 2)." ] ;
    sh:property [ sh:path pwm:actionVerb ; sh:minCount 1 ;
        sh:message "A delegation names the actions it allows (Kognita 0.5 item 2)." ] ;
    sh:property [ sh:path pwm:validUntil ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A delegation must expire even when it also ends on task completion (Kognita 0.5 item 2)." ] .

# --- Client communication ------------------------------------------------------------------

pwmsh:ClientCommunicationShape a sh:NodeShape ;
    rdfs:label "Client communication"@en ;
    sh:targetClass pwm:ClientCommunication ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:derivedFromDecision ; sh:minCount 1 ;
        sh:message "A communication that does not trace back to a final decision is refused (Kognita 0.4 item 12)." ] ;
    sh:property [ sh:path pwm:communicationLevel ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every communication is classified by communication level (Kognita 0.4 item 12)." ] ;
    sh:property [ sh:path pwm:contentProvenance ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Every communication carries its content provenance label (Kognita 0.4 item 11)." ] ;
    sh:property [ sh:path pwm:viaChannel ; sh:minCount 1 ;
        sh:node [ sh:property [ sh:path pwm:isApprovedChannel ; sh:hasValue true  ; sh:message "isApprovedChannel: required value true." ] ] ;
        sh:message "Client communication goes only through a registered, approved channel (Kognita 0.4 item 12)." ] .

pwmsh:AIDisclosureShape a sh:NodeShape ;
    rdfs:label "AI disclosure"@en ;
    rdfs:comment "Kognita's private-banking pack applies this rule in SG, HK, CH and AE. Where no disclosure rule applies, a firm can switch the shape off in its own shapes graph with sh:deactivated true."@en ;
    sh:targetClass pwm:ClientCommunication ;
    dcterms:source pwmref:KOG-PB-PACK , pwmref:MAS-AIRG ;
    sh:or (
        [ sh:property [ sh:path pwm:contentProvenance ; sh:in ( pwm:ProvenanceHuman pwm:ProvenanceHumanAIAssisted )  ; sh:message "contentProvenance: allowed values ProvenanceHuman, ProvenanceHumanAIAssisted." ] ]
        [ sh:property [ sh:path pwm:aiDisclosureGiven ; sh:hasValue true  ; sh:message "aiDisclosureGiven: required value true." ] ]
    ) ;
    sh:message "When AI generated the content, the client communication must say so (Kognita private-banking pack, client-ai-disclosure; MAS AIRG 5.6)." .

# --- Claims, facts and figures --------------------------------------------------------------

pwmsh:ClaimShape a sh:NodeShape ;
    rdfs:label "Claim"@en ;
    sh:targetClass pwm:Claim ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:claimType ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Unlabelled claims cannot be shown to an RM or sent to a client (Kognita 0.6 item 5)." ] ;
    sh:property [ sh:path pwm:validatorStatus ; sh:maxCount 1  ; sh:message "validatorStatus: maximum count 1." ] ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pwm:claimType ; sh:hasValue pwm:VerifiedFact  ; sh:message "claimType: required value VerifiedFact." ] ] ]
        [ sh:property [ sh:path pwm:citesSource ; sh:minCount 1  ; sh:message "citesSource: minimum count 1." ] ;
          sh:property [ sh:path pwm:validatorStatus ; sh:hasValue pwm:ValidatorVerified  ; sh:message "validatorStatus: required value ValidatorVerified." ] ]
    ) ;
    sh:message "A claim typed as verified fact must cite a source and carry the validator status verified. The model's own knowledge is never a source, and an inference cannot become a fact without verification (Kognita 0.6 items 3, 5 and 7)." .

pwmsh:FactShape a sh:NodeShape ;
    rdfs:label "Fact"@en ;
    sh:targetClass pwm:Fact ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:asOf ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "A fact carries its as-of time (Kognita 0.6 item 2)." ] ;
    sh:property [ sh:path pwm:freshnessThreshold ; sh:minCount 1 ; sh:datatype xsd:duration ;
        sh:message "A fact carries a freshness threshold (Kognita 0.6 item 2)." ] ;
    sh:property [ sh:path pwm:classification ; sh:minCount 1 ;
        sh:message "A fact carries its classification (Kognita 0.6 item 2)." ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ;
        sh:message "A fact names its source system (Kognita 0.6 item 2)." ] .

pwmsh:ValuationShape a sh:NodeShape ;
    rdfs:label "Valuation"@en ;
    sh:targetClass pwm:Valuation ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:amount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal  ; sh:message "amount: minimum count 1; maximum count 1; datatype decimal." ] ;
    sh:property [ sh:path pwm:currency ; sh:minCount 1 ; sh:maxCount 1  ; sh:message "currency: minimum count 1; maximum count 1." ] ;
    sh:property [ sh:path pwm:asOf ; sh:minCount 1 ; sh:datatype xsd:dateTime  ; sh:message "asOf: minimum count 1; datatype dateTime." ] ;
    sh:property [ sh:path pwm:calculatedBy ; sh:minCount 1 ;
        sh:message "A figure presented as authoritative must cite a registered calculation service (Kognita 0.6 item 6)." ] .

# --- Suitability ---------------------------------------------------------------------------

pwmsh:SuitabilityAssessmentShape a sh:NodeShape ;
    rdfs:label "Suitability assessment"@en ;
    sh:targetClass pwm:SuitabilityAssessment ;
    dcterms:source pwmref:EU-MIFID2 , pwmref:EU-MIFID2-DR , pwmref:KOG-PB-PACK ;
    sh:property [ sh:path pwm:assessesRecommendation ; sh:minCount 1 ;
        sh:message "Name the recommendation being assessed." ] ;
    sh:property [ sh:path pwm:usesRiskProfile ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Cite the one risk profile in force when the assessment was made (MiFID II Art. 25(2); Delegated Regulation (EU) 2017/565 Art. 54)." ] ;
    sh:property [ sh:path pwm:usesMandate ; sh:minCount 1 ;
        sh:message "Check the recommendation against the recorded mandate (Kognita private-banking pack, mandate)." ] ;
    sh:property [ sh:path pwm:suitabilityOutcome ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:Suitable pwm:SuitableWithConditions pwm:NotSuitable pwm:InsufficientInformation )  ; sh:message "suitabilityOutcome: minimum count 1; maximum count 1; allowed values Suitable, SuitableWithConditions, NotSuitable, InsufficientInformation." ] ;
    sh:property [ sh:path pwm:rationale ; sh:minCount 1 ;
        sh:message "Record how the recommendation meets the client's objectives and characteristics, not a bare score (MiFID II Art. 25(6))." ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ;
        sh:message "Record who made the assessment." ] .

pwmsh:InvestorRiskProfileShape a sh:NodeShape ;
    rdfs:label "Investor risk profile"@en ;
    sh:targetClass pwm:InvestorRiskProfile ;
    dcterms:source pwmref:EU-MIFID2-DR ;
    sh:property [ sh:path pwm:riskProfileLevel ; sh:minCount 1 ; sh:maxCount 1  ; sh:message "riskProfileLevel: minimum count 1; maximum count 1." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ; sh:datatype xsd:dateTime  ; sh:message "validFrom: minimum count 1; datatype dateTime." ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1  ; sh:message "wasAttributedTo: minimum count 1." ] .

pwmsh:InvestorClassificationShape a sh:NodeShape ;
    rdfs:label "Investor classification"@en ;
    sh:targetClass pwm:InvestorClassification ;
    dcterms:source pwmref:SG-SFA , pwmref:CH-FINSA , pwmref:EU-MIFID2 ;
    sh:property [ sh:path pwm:investorCategory ; sh:minCount 1 ; sh:maxCount 1  ; sh:message "investorCategory: minimum count 1; maximum count 1." ] ;
    sh:property [ sh:path pwm:jurisdictionCode ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A classification is made under one jurisdiction's rules." ] ;
    sh:property [ sh:path pwm:optStatus ; sh:maxCount 1  ; sh:message "optStatus: maximum count 1." ] .

# --- Information governance and evidence ---------------------------------------------------

pwmsh:GovernedInformationAssetShape a sh:NodeShape ;
    rdfs:label "Governed information asset"@en ;
    sh:targetClass pwm:GovernedInformationAsset ;
    dcterms:source pwmref:AM-FILING-CABINET ;
    sh:property [ sh:path pwm:informationOwner ; sh:minCount 1 ; sh:message "Minimum label: owner (Filing Cabinet, slide 8)." ] ;
    sh:property [ sh:path pwm:approvalStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Minimum label: approval status (Filing Cabinet, slide 8)." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ; sh:message "Minimum label: effective date (Filing Cabinet, slide 8)." ] ;
    sh:property [ sh:path pwm:retentionUntil ; sh:minCount 1 ; sh:message "Minimum label: retention date (Filing Cabinet, slide 8)." ] ;
    sh:or (
        [ sh:property [ sh:path pwm:versionId ; sh:minCount 1  ; sh:message "versionId: minimum count 1." ] ]
        [ sh:property [ sh:path pwm:contentHash ; sh:minCount 1  ; sh:message "contentHash: minimum count 1." ] ]
    ) ;
    sh:message "Minimum label: version identifier or content hash (Filing Cabinet, slide 8)." .

pwmsh:DocumentSectionShape a sh:NodeShape ;
    rdfs:label "Document section"@en ;
    sh:targetClass pwm:DocumentSection ;
    dcterms:source pwmref:AM-FILING-CABINET ;
    sh:property [ sh:path pwm:classification ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Classify per section, not per document (Filing Cabinet, slide 8)." ] .

pwmsh:PolicyRuleShape a sh:NodeShape ;
    rdfs:label "Policy rule"@en ;
    sh:targetClass pwm:PolicyRule ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:ruleCitation ; sh:minCount 1 ;
        sh:message "Every rule carries a citation to what it implements (Kognita 0.4 item 3)." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ;
        sh:message "Rules are effective-dated (Kognita 0.3 item 7)." ] ;
    sh:property [ sh:path pwm:versionId ; sh:minCount 1 ;
        sh:message "A change to a rule is a new version, never an edit in place (Kognita 0.3 item 7)." ] .

pwmsh:CrossBorderRuleShape a sh:NodeShape ;
    rdfs:label "Cross-border rule"@en ;
    sh:targetClass pwm:CrossBorderRule ;
    dcterms:source pwmref:KOG-PB-PACK ;
    sh:property [ sh:path pwm:appliesToActivity ; sh:minCount 1  ; sh:message "appliesToActivity: minimum count 1." ] ;
    sh:property [ sh:path pwm:permitted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean  ; sh:message "permitted: minimum count 1; maximum count 1; datatype boolean." ] ;
    sh:property [ sh:path pwm:clientDomicileCode ; sh:minCount 1 ; sh:pattern "^[A-Z]{2}$" ;
        sh:message "Client domicile is an ISO 3166-1 alpha-2 code." ] ;
    sh:property [ sh:path pwm:bookingCentreCode ; sh:minCount 1 ; sh:pattern "^[A-Z]{2}$" ;
        sh:message "Booking centre is an ISO 3166-1 alpha-2 code." ] .

pwmsh:PolicyDecisionShape a sh:NodeShape ;
    rdfs:label "Policy decision"@en ;
    sh:targetClass pwm:PolicyDecision ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "Record exactly one decision timestamp." ] ;
    dcterms:source pwmref:KOG-ROADMAP , pwmref:AM-FILING-CABINET ;
    sh:property [ sh:path pwm:decisionOutcome ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( pwm:OutcomeDeny pwm:OutcomeEscalate pwm:OutcomeHumanApproval pwm:OutcomeAllow pwm:OutcomeObserve )  ; sh:message "decisionOutcome: minimum count 1; maximum count 1; allowed values OutcomeDeny, OutcomeEscalate, OutcomeHumanApproval, OutcomeAllow, OutcomeObserve." ] ;
    sh:property [ sh:path pwm:decidedByRule ; sh:minCount 1 ;
        sh:message "Every decision names the rule and rule version that decided it (Filing Cabinet, slide 14)." ] ;
    sh:property [ sh:path pwm:underUseCase ; sh:minCount 1 ;
        sh:message "Every decision references a registered use case (Kognita 0.4 item 8)." ] .

pwmsh:EvidenceRecordShape a sh:NodeShape ;
    rdfs:label "Evidence record"@en ;
    sh:targetClass pwm:EvidenceRecord ;
    dcterms:source pwmref:KOG-CONTROLS , pwmref:MAS-AIRG ;
    sh:property [ sh:path pwm:eventType ; sh:minCount 1 ; sh:maxCount 1  ; sh:message "eventType: minimum count 1; maximum count 1." ] ;
    sh:property [ sh:path pwm:recordHash ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Evidence records are hash-chained (Kognita control frameworks)." ] ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "An evidence record states when the event happened (MAS AIRG 5.23(d))." ] ;
    sh:property [ sh:path pwm:previousRecordHash ; sh:maxCount 1  ; sh:message "previousRecordHash: maximum count 1." ] ;
    sh:xone (
        [ sh:property [ sh:path pwm:previousRecordHash ; sh:minCount 1  ; sh:message "previousRecordHash: minimum count 1." ] ]
        [ sh:property [ sh:path pwm:chainStart ; sh:hasValue true  ; sh:message "chainStart: required value true." ] ]
    ) ;
    sh:message "Every evidence record names the hash of the record before it, except the first record of a chain, which is marked chain start (Kognita control frameworks: hash-chained evidence)." .

# --- Identifier and code formats (ISO) -----------------------------------------------------

pwmsh:CurrencyCodeShape a sh:NodeShape ;
    rdfs:label "Currency code"@en ;
    sh:targetSubjectsOf pwm:currency ;
    dcterms:source pwmref:ISO-4217 ;
    sh:property [ sh:path pwm:currency ; sh:pattern "^[A-Z]{3}$" ;
        sh:message "Currency is an ISO 4217 alphabetic code, such as SGD." ] .

pwmsh:CountryCodeShape a sh:NodeShape ;
    rdfs:label "Country code"@en ;
    sh:targetSubjectsOf pwm:residenceCountry , pwm:domicileCountry , pwm:nationalityCountry , pwm:jurisdictionCode , pwm:taxResidenceCountry ;
    dcterms:source pwmref:ISO-3166 ;
    sh:property [ sh:path pwm:residenceCountry ; sh:pattern "^[A-Z]{2}$" ; sh:message "Residence is an ISO 3166-1 alpha-2 code, such as SG." ] ;
    sh:property [ sh:path pwm:domicileCountry ; sh:pattern "^[A-Z]{2}$" ; sh:message "Domicile is an ISO 3166-1 alpha-2 code, such as SG." ] ;
    sh:property [ sh:path pwm:nationalityCountry ; sh:pattern "^[A-Z]{2}$" ; sh:message "Nationality is an ISO 3166-1 alpha-2 code, such as SG." ] ;
    sh:property [ sh:path pwm:jurisdictionCode ; sh:pattern "^[A-Z]{2}$" ; sh:message "Jurisdiction is an ISO 3166-1 alpha-2 code, such as SG." ] ;
    sh:property [ sh:path pwm:taxResidenceCountry ; sh:pattern "^[A-Z]{2}$" ; sh:message "Tax residence is an ISO 3166-1 alpha-2 code, such as SG." ] .

pwmsh:LEIShape a sh:NodeShape ;
    rdfs:label "Legal Entity Identifier"@en ;
    sh:targetSubjectsOf pwm:legalEntityIdentifier ;
    dcterms:source pwmref:ISO-17442 ;
    sh:property [ sh:path pwm:legalEntityIdentifier ; sh:pattern "^[A-Z0-9]{18}[0-9]{2}$" ;
        sh:message "An LEI is 18 letters or digits followed by two check digits (ISO 17442)." ] .

pwmsh:ISINShape a sh:NodeShape ;
    rdfs:label "ISIN"@en ;
    sh:targetSubjectsOf pwm:isin ;
    dcterms:source pwmref:ISO-6166 ;
    sh:property [ sh:path pwm:isin ; sh:pattern "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" ;
        sh:message "An ISIN is a two-letter prefix, nine letters or digits and a check digit (ISO 6166)." ] .

pwmsh:CFIShape a sh:NodeShape ;
    rdfs:label "CFI code"@en ;
    sh:targetSubjectsOf pwm:cfiCode ;
    dcterms:source pwmref:ISO-10962 ;
    sh:property [ sh:path pwm:cfiCode ; sh:pattern "^[A-Z]{6}$" ;
        sh:message "A CFI code is six letters (ISO 10962)." ] .


# Article 54 is jurisdiction-specific. A firm records EU applicability explicitly.
pwmsh:EUSustainabilityAssessmentShape a sh:NodeShape ;
    rdfs:label "EU sustainability assessment"@en ;
    sh:targetClass pwm:SuitabilityAssessment ;
    dcterms:source pwmref:EU-SUSTAINABILITY ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pwm:jurisdictionCode ; sh:hasValue "EU"  ; sh:message "jurisdictionCode: required value EU." ] ] ]
        [ sh:property [ sh:path pwm:usesSustainabilityPreference ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class pwm:SustainabilityPreference  ; sh:message "usesSustainabilityPreference: minimum count 1; maximum count 1; class SustainabilityPreference." ] ]
    ) ;
    sh:message "EU suitability cites one recorded sustainability preference, including explicit no preference (2017/565 Art. 54(2)(a), (5), as amended by 2021/1253 Art. 1(6))." .

pwmsh:SustainabilityPreferenceShape a sh:NodeShape ;
    rdfs:label "Sustainability preference"@en ;
    sh:targetClass pwm:SustainabilityPreference ;
    dcterms:source pwmref:EU-SUSTAINABILITY ;
    sh:property [ sh:path pwm:sustainabilityPreferenceKind ; sh:minCount 1  ; sh:message "sustainabilityPreferenceKind: minimum count 1." ] ;
    sh:property [ sh:path pwm:minimumTaxonomyAlignedProportion ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0  ; sh:message "minimumTaxonomyAlignedProportion: maximum count 1; datatype decimal; minimum inclusive 0.0; maximum inclusive 1.0." ] ;
    sh:property [ sh:path pwm:minimumSFDRSustainableProportion ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0  ; sh:message "minimumSFDRSustainableProportion: maximum count 1; datatype decimal; minimum inclusive 0.0; maximum inclusive 1.0." ] ;
    sh:property [ sh:path pwm:paiConsiderationElements ; sh:datatype xsd:string ; sh:minLength 1  ; sh:message "paiConsiderationElements: datatype string." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:message "Record the minimum proportion for each selected category and client-determined PAI elements; no preference is exclusive and has no category details (2017/565 Art. 2(7)(a)-(c))." ;
        sh:select """
          SELECT $this WHERE {
            FILTER (
              (EXISTS { $this pwm:sustainabilityPreferenceKind pwm:TaxonomyAlignedMinimum }
               != EXISTS { $this pwm:minimumTaxonomyAlignedProportion ?tax }) ||
              (EXISTS { $this pwm:sustainabilityPreferenceKind pwm:SFDRSustainableMinimum }
               != EXISTS { $this pwm:minimumSFDRSustainableProportion ?sfdr }) ||
              (EXISTS { $this pwm:sustainabilityPreferenceKind pwm:PAIConsideration }
               != EXISTS { $this pwm:paiConsiderationElements ?pai }) ||
              (EXISTS { $this pwm:sustainabilityPreferenceKind pwm:NoSustainabilityPreference }
               && EXISTS { $this pwm:sustainabilityPreferenceKind ?other .
                           FILTER (?other != pwm:NoSustainabilityPreference) })
            )
          }
        """
    ] .

pwmsh:RunShape a sh:NodeShape ; rdfs:label "RunShape"@en ; sh:targetClass pwm:Run ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 1."@en ;
    sh:property [ sh:path pwm:hasBudget ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RunBudget ; sh:message "Record hasBudget (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:runState ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record runState (roadmap milestone 0.3)." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:message "A resumed run must have a resumption referencing a resolved approval (0.3 item 2)." ;
        sh:select """SELECT $this WHERE {
          $this pwm:runState pwm:RunResumed . FILTER NOT EXISTS {
            ?resumption a pwm:RunResumption ; pwm:inRun $this ; pwm:resolvedApproval ?resolution .
            ?resolution pwm:approvalResolution ?result .
            FILTER (?result IN (pwm:ApprovalApproved,pwm:ApprovalDenied))
          }
        }""" ] .


pwmsh:RunBudgetShape a sh:NodeShape ; rdfs:label "RunBudgetShape"@en ; sh:targetClass pwm:RunBudget ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 1."@en ;
    sh:property [ sh:path pwm:maxCalls ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record maxCalls (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:maxTokens ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record maxTokens (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:maxCostUSD ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:message "Record maxCostUSD (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:wallClockSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:message "Record wallClockSeconds (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:consumedCalls ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record consumedCalls (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:consumedTokens ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record consumedTokens (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:consumedCostUSD ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:message "Record consumedCostUSD (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:elapsedSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:message "Record elapsedSeconds (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:classificationCeiling ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record classificationCeiling (roadmap milestone 0.3)." ] .


pwmsh:BudgetExceededDenialShape a sh:NodeShape ; rdfs:label "BudgetExceededDenialShape"@en ; sh:targetClass pwm:BudgetExceededDenial ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 1."@en ;
    sh:property [ sh:path pwm:exceededBudget ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RunBudget ; sh:message "Record exceededBudget (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:budgetDimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record budgetDimension (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:decisionOutcome ; sh:hasValue pwm:OutcomeDeny  ; sh:message "decisionOutcome: required value OutcomeDeny." ] .


pwmsh:CheckpointShape a sh:NodeShape ; rdfs:label "CheckpointShape"@en ; sh:targetClass pwm:RunCheckpoint ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 2."@en ;
    sh:property [ sh:path pwm:inRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Run ; sh:message "Record inRun (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record contentHash (roadmap milestone 0.3)." ] .


pwmsh:ApprovalRequestShape a sh:NodeShape ; rdfs:label "ApprovalRequestShape"@en ; sh:targetClass pwm:ApprovalRequest ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 2."@en ;
    sh:property [ sh:path pwm:requestsDecision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:PolicyDecision ; sh:message "Record requestsDecision (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:atCheckpoint ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RunCheckpoint ; sh:message "Record atCheckpoint (roadmap milestone 0.3)." ] .


pwmsh:ApprovalResolutionShape a sh:NodeShape ; rdfs:label "ApprovalResolutionShape"@en ; sh:targetClass pwm:ApprovalResolution ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 2."@en ;
    sh:property [ sh:path pwm:resolvesApproval ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ApprovalRequest ; sh:message "Record resolvesApproval (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:approvalResolution ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record approvalResolution (roadmap milestone 0.3)." ] ; sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person  ; sh:message "wasAttributedTo: minimum count 1; maximum count 1; class Person." ] ; sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime  ; sh:message "generatedAtTime: minimum count 1; maximum count 1; datatype dateTime." ] .


pwmsh:RunResumptionShape a sh:NodeShape ; rdfs:label "RunResumptionShape"@en ; sh:targetClass pwm:RunResumption ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 2."@en ;
    sh:property [ sh:path pwm:inRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Run ; sh:message "Record inRun (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:resumedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RunCheckpoint ; sh:message "Record resumedFrom (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:resolvedApproval ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ApprovalResolution ; sh:message "Record resolvedApproval (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Resumption must cite a resolved approval for its run checkpoint (0.3 item 2)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:inRun ?run ; pwm:resumedFrom ?cp ; pwm:resolvedApproval ?resolution . FILTER NOT EXISTS { ?cp pwm:inRun ?run . ?resolution pwm:resolvesApproval ?request ; pwm:approvalResolution ?result . ?request pwm:atCheckpoint ?cp . FILTER (?result IN (pwm:ApprovalApproved, pwm:ApprovalDenied)) } }""" ] .


pwmsh:ModelCallShape a sh:NodeShape ; rdfs:label "ModelCallShape"@en ; sh:targetClass pwm:ModelCall ;
    sh:property [ sh:path pwm:usesModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIModel ; sh:message "Record usesModel (Kognita 0.4 item 8)." ] ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 7."@en ;
    sh:property [ sh:path pwm:modelName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record modelName (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:modelVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record modelVersion (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:promptTemplateVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record promptTemplateVersion (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:promptHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record promptHash (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:responseHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record responseHash (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:providedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ModelProvider ; sh:message "Record providedBy (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:inputTokens ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record inputTokens (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:outputTokens ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record outputTokens (roadmap milestone 0.3)." ] .


pwmsh:ToolCallShape a sh:NodeShape ; rdfs:label "ToolCallShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 7."@en ;
    sh:property [ sh:path pwm:responseHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record responseHash (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:invokedTool ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Tool ; sh:message "Record invokedTool (roadmap milestone 0.3)." ] .


pwmsh:MCPProxiedCallShape a sh:NodeShape ; rdfs:label "MCPProxiedCallShape"@en ; sh:targetClass pwm:MCPProxiedCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 5."@en ;
    sh:property [ sh:path pwm:mcpBackend ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record mcpBackend (roadmap milestone 0.3)." ] .


pwmsh:ClassifierOutputShape a sh:NodeShape ; rdfs:label "ClassifierOutputShape"@en ; sh:targetClass pwm:ClassifierOutput ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 4."@en ;
    sh:property [ sh:path pwm:classifierModelId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record classifierModelId (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:classifierVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record classifierVersion (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:classifierLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record classifierLabel (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:inputHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record inputHash (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:message "Record confidence (roadmap milestone 0.3)." ] .


pwmsh:EnvelopeAttributeShape a sh:NodeShape ; rdfs:label "EnvelopeAttributeShape"@en ; sh:targetClass pwm:EnvelopeAttribute ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 4."@en ;
    sh:property [ sh:path pwm:attributeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record attributeName (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:attributeValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record attributeValue (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:attributeSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record attributeSource (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Classifier-derived attribute needs calibrated confidence and classifier version (0.3 item 4)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:attributeSource pwm:AttributeClassifierDerived . FILTER NOT EXISTS { $this pwm:derivedFromClassifier ?c . ?c pwm:confidence ?confidence ; pwm:classifierVersion ?version } }""" ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
      sh:message "Identity attributes come from authentication, never classifier text (0.3 item 4 and Tier 0)." ;
      sh:select """SELECT $this WHERE { $this pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:attributeName ?name .
        FILTER (?name IN ("principal", "agent", "agent_name", "system_trigger", "client_configuration")) }""" ] .

pwmsh:ClassifierThresholdShape a sh:NodeShape ; rdfs:label "ClassifierThresholdShape"@en ; sh:targetSubjectsOf pwm:hasAttribute , pwm:escalationThreshold ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 4."@en ;
    sh:property [ sh:path pwm:escalationThreshold ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0  ; sh:message "escalationThreshold: maximum count 1; datatype decimal; minimum inclusive 0.0; maximum inclusive 1.0." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Below-threshold or missing-threshold classifier evidence cannot yield ALLOW (0.3 item 4)." ; sh:select """SELECT DISTINCT $this WHERE { { $this pwm:decisionOutcome pwm:OutcomeAllow . BIND($this AS ?decision) } UNION { $this pwm:governedByDecision ?decision . ?decision pwm:decisionOutcome pwm:OutcomeAllow } $this pwm:hasAttribute ?a . ?a pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:derivedFromClassifier ?c . ?c pwm:confidence ?confidence . FILTER NOT EXISTS { ?decision pwm:escalationThreshold ?t . FILTER (?confidence >= ?t) } }""" ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
      sh:message "Classifier fills gaps only; a typed attribute remains authoritative (0.3 item 4)." ;
      sh:select """SELECT DISTINCT $this WHERE {
        $this pwm:hasAttribute ?typed, ?derived .
        ?typed pwm:attributeSource pwm:AttributeTyped ; pwm:attributeName ?name .
        ?derived pwm:attributeSource pwm:AttributeClassifierDerived ; pwm:attributeName ?name .
      }""" ] .

pwmsh:PolicyCheckShape a sh:NodeShape ; rdfs:label "PolicyCheckShape"@en ; sh:targetClass pwm:PolicyCheck ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 7."@en ;
    sh:property [ sh:path pwm:checkedRule ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:PolicyRule ; sh:message "Record checkedRule (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:policyContentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record policyContentHash (roadmap milestone 0.3)." ] .


pwmsh:RetrievedItemShape a sh:NodeShape ; rdfs:label "RetrievedItemShape"@en ; sh:targetClass pwm:RetrievedItem ;
