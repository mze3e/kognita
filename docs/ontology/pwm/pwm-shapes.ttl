    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "prov:generatedAtTime: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:rationale: minimum count 1, maximum count 1, datatype xsd:string." ] .

pwmsh:SandboxConstraintsShape a sh:NodeShape ; rdfs:label "SandboxConstraintsShape"@en ; sh:targetClass pwm:SandboxConstraints ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 12. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:filesystemScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:filesystemScope: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:permitsExport ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:permitsExport: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:permitsPersistence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:permitsPersistence: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:autoStopSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:autoStopSeconds: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:cpuSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:cpuSeconds: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:memoryBytes ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "pwm:memoryBytes: minimum count 1, maximum count 1, datatype xsd:nonNegativeInteger." ] ;
    sh:property [ sh:path pwm:diskBytes ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "pwm:diskBytes: minimum count 1, maximum count 1, datatype xsd:nonNegativeInteger." ] ;
    sh:property [ sh:path pwm:autoStopSeconds ; sh:minExclusive 0 ; sh:message "pwm:autoStopSeconds: minimum exclusive 0." ] ;
    sh:property [ sh:path pwm:cpuSeconds ; sh:minExclusive 0 ; sh:message "pwm:cpuSeconds: minimum exclusive 0." ] .

pwmsh:ReversibilityShape a sh:NodeShape ; rdfs:label "ReversibilityShape"@en ; sh:targetClass pwm:Tool ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 13. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:reversibilityClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "pwm:reversibilityClass: minimum count 1, maximum count 1." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Reversible and compensatable tools register a compensating action (Kognita 0.5 item 13)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:reversibilityClass ?r . FILTER(?r IN (pwm:Reversible,pwm:Compensatable)) FILTER NOT EXISTS { $this pwm:compensatingAction ?action . ?action a pwm:CompensatingAction } }""" ] .

pwmsh:IrreversibleApprovalShape a sh:NodeShape ; rdfs:label "IrreversibleApprovalShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 13. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "High-autonomy irreversible action requires human approval resolving a held HUMAN_APPROVAL decision at a suspended checkpoint in the call's run, strictly before the call (Kognita 0.5 item 13)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:invokedTool ?t ; pwm:callAgent ?a ; pwm:governedByDecision ?d . ?t pwm:reversibilityClass pwm:Irreversible . ?a pwm:maxAutonomyLevel ?max . OPTIONAL { ?a pwm:effectiveAutonomyLevel ?effective } BIND(COALESCE(?effective, ?max) AS ?l) FILTER(?l IN (pwm:L5BoundedAutonomy,pwm:L6BroadAutonomy)) ?d pwm:decisionOutcome pwm:OutcomeAllow . FILTER NOT EXISTS { ?d pwm:humanApproval ?approval . ?approval pwm:approvalResolution pwm:ApprovalApproved ; pwm:resolvesApproval ?request . ?request a pwm:ApprovalRequest ; pwm:requestsDecision ?held ; pwm:atCheckpoint ?checkpoint . ?held pwm:decisionOutcome pwm:OutcomeHumanApproval ; pwm:inRun ?run ; pwm:underUseCase ?approvalUseCase ; pwm:decidedByRule ?approvalRule . ?checkpoint pwm:inRun ?run ; pwm:runState pwm:RunSuspended . ?d pwm:inRun ?run ; pwm:underUseCase ?approvalUseCase ; pwm:decidedByRule ?approvalRule . $this pwm:inRun ?run . ?approval prov:generatedAtTime ?approvedAt . $this prov:generatedAtTime ?calledAt . FILTER(?approvedAt < ?calledAt) } }""" ] .

pwmsh:AdversarialTestShape a sh:NodeShape ; rdfs:label "AdversarialTestShape"@en ; sh:targetClass pwm:AdversarialTestCase ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 14. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:threatModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ThreatModel ; sh:message "pwm:threatModel: minimum count 1, maximum count 1, class pwm:ThreatModel." ] ;
    sh:property [ sh:path pwm:attackKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:attackKind: minimum count 1, maximum count 1, datatype xsd:string." ] .

