pwmsh:BreakerScopeShape a sh:NodeShape ; rdfs:label "BreakerScopeShape"@en ; sh:targetClass pwm:CircuitBreakerTrip ; sh:targetClass pwm:CircuitBreaker ; sh:targetClass pwm:AffectedClientQuery ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A breaker, trip or affected-client query requires a use-case, model, policy or prompt-version scope (Kognita 0.4 item 14)." ; sh:select """SELECT DISTINCT $this WHERE { FILTER NOT EXISTS { $this (pwm:scopeUseCase|pwm:scopeModel|pwm:scopePolicy|pwm:scopePromptVersion) ?scope } }""" ] .

pwmsh:TwoSignatureShape a sh:NodeShape ; rdfs:label "TwoSignatureShape"@en ; sh:targetSubjectsOf pwm:requiresTwoSignatures ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A communication requiring two signatures must name two distinct human signers (Kognita 0.4 item 12)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:requiresTwoSignatures true . FILTER NOT EXISTS { $this pwm:communicationSigner ?a, ?b . ?a a <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> . ?b a <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> . FILTER (?a != ?b) } }""" ] .

# The review date remains valid through its final day. Normalize unspecified
# timezones to UTC before typed comparisons; preserve explicit offsets.
pwmsh:PastReviewDecisionShape a sh:NodeShape ;
    rdfs:label "PastReviewDecisionShape"@en ;
    sh:targetClass pwm:PolicyDecision ;
    dcterms:source pwmref:KOG-ROADMAP ;
    sh:sparql [
        sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:message "A decision made after the use-case review date expires must be DENY (Kognita 0.4 item 8)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this pwm:underUseCase ?uc ; pwm:decisionOutcome ?out ;
                    <http://www.w3.org/ns/prov#generatedAtTime> ?at .
                ?uc pwm:nextReviewDate ?due .
                FILTER(DATATYPE(?at) = xsd:dateTime && DATATYPE(?due) = xsd:date)
                BIND(IF(REGEX(STR(?due), "(Z|[+-][0-9]{2}:[0-9]{2})$"),
                    STR(?due), CONCAT(STR(?due), "Z")) AS ?dueWithZone)
                BIND(xsd:dateTime(REPLACE(?dueWithZone,
                    "^([0-9]{4}-[0-9]{2}-[0-9]{2})(.*)$", "$1T00:00:00$2"))
                    + "P1D"^^xsd:dayTimeDuration AS ?expires)
                BIND(xsd:dateTime(IF(REGEX(STR(?at), "(Z|[+-][0-9]{2}:[0-9]{2})$"),
                    STR(?at), CONCAT(STR(?at), "Z"))) AS ?decisionAt)
                FILTER(?decisionAt >= ?expires && ?out != pwm:OutcomeDeny)
            }
        """
    ] .

pwmsh:RiskAppetiteDecisionShape a sh:NodeShape ; rdfs:label "RiskAppetiteDecisionShape"@en ; sh:targetClass pwm:PolicyDecision ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A decision outside the recorded risk appetite must be DENY (Kognita 0.4 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:underUseCase ?uc ; pwm:decisionOutcome ?out . ?uc pwm:appetitePermits false . FILTER (?out != pwm:OutcomeDeny) }""" ] .

pwmsh:CoverageCountsShape a sh:NodeShape ; rdfs:label "CoverageCountsShape"@en ; sh:targetClass pwm:ReviewCoverageReport ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Coverage counts must satisfy reviewed <= queued <= screened <= eligible (Kognita 0.4 item 13)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:eligibleCount ?e ; pwm:screenedCount ?s ; pwm:queuedCount ?q ; pwm:reviewedCount ?r . FILTER (?s > ?e || ?q > ?s || ?r > ?q) }""" ] .

pwmsh:CircuitBreakerConfigurationShape a sh:NodeShape ; rdfs:label "CircuitBreakerConfigurationShape"@en ; sh:targetClass pwm:CircuitBreaker ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:flagThreshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:message "Record flagThreshold (Kognita 0.4 item 14)." ] ; sh:property [ sh:path pwm:windowStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:lessThan pwm:windowEnd ; sh:message "Record windowStart (Kognita 0.4 item 14)." ] ; sh:property [ sh:path pwm:windowEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "Record windowEnd (Kognita 0.4 item 14)." ] .

pwmsh:FlightRecorderSessionShape a sh:NodeShape ; rdfs:label "FlightRecorderSessionShape"@en ; sh:targetClass pwm:FlightRecorderSession ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:recordedRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Run ; sh:message "Record recordedRun (Kognita 0.4 item 7)." ] ; sh:property [ sh:path pwm:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record contentHash (Kognita 0.4 item 7)." ] .

pwmsh:ReplayShape a sh:NodeShape ; rdfs:label "ReplayShape"@en ; sh:targetClass pwm:Replay ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:replaysSession ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:FlightRecorderSession ; sh:message "Record replaysSession (Kognita 0.4 item 7)." ] ; sh:property [ sh:path pwm:replayReport ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ReconstructionReport ; sh:message "Record replayReport (Kognita 0.4 item 7)." ] .

pwmsh:PolicyChangeShape a sh:NodeShape ; rdfs:label "PolicyChangeShape"@en ; sh:targetClass pwm:PolicyChange ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:changesPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:DeclarativePolicy ; sh:message "Record changesPolicy (Kognita 0.4 item 3)." ] ; sh:property [ sh:path pwm:deltaText ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record deltaText (Kognita 0.4 item 3)." ] ; sh:property [ sh:path pwm:changeStage ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "propose" "review" "validated" "applied" ) ; sh:message "Record changeStage (Kognita 0.4 item 3)." ] .

pwmsh:NearMissClassificationShape a sh:NodeShape ; rdfs:label "NearMissClassificationShape"@en ; sh:targetClass pwm:NearMiss ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:nearMissKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record nearMissKind (Kognita 0.4 item 15)." ] ; sh:property [ sh:path pwm:partOfInteraction ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ClientInteraction ; sh:message "Record partOfInteraction (Kognita 0.4 item 15)." ] .

pwmsh:ReviewSamplingRateShape a sh:NodeShape ; rdfs:label "ReviewSamplingRateShape"@en ; sh:targetSubjectsOf pwm:lowRiskSamplingRate ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:lowRiskSamplingRate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:message "Record lowRiskSamplingRate (Kognita 0.4 item 13)." ] .

pwmsh:AffectedClientResultShape a sh:NodeShape ; rdfs:label "AffectedClientResultShape"@en ; sh:targetClass pwm:AffectedClientResult ; dcterms:source pwmref:KOG-ROADMAP ; sh:property [ sh:path pwm:resultCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record resultCount (Kognita 0.4 item 14)." ] .

pwmsh:AffectedClientCountShape a sh:NodeShape ; rdfs:label "AffectedClientCountShape"@en ; sh:targetClass pwm:AffectedClientResult ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Affected-client count must equal distinct recipients of the returned communications (0.4 item 14)." ; sh:select """SELECT DISTINCT $this WHERE {  $this pwm:resultCount ?n . { SELECT $this (COUNT(DISTINCT ?client) AS ?actual) WHERE { $this a pwm:AffectedClientResult . OPTIONAL { $this pwm:affectedCommunication ?comm . ?comm pwm:withClient ?client } } GROUP BY $this } FILTER (?n != ?actual)  }""" ]  ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Each affected communication must record withClient (Kognita 0.4 item 14)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:affectedCommunication ?comm . FILTER NOT EXISTS { ?comm pwm:withClient ?client } }""" ] .

pwmsh:ModelCallCardShape a sh:NodeShape ; rdfs:label "ModelCallCardShape"@en ; sh:targetClass pwm:ModelCall ; dcterms:source pwmref:KOG-ROADMAP ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Pinned model calls must link to their approved model card and exact version (0.4 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:usesModel ?model ; pwm:modelVersion ?version . FILTER NOT EXISTS { $this pwm:hasModelCard ?card . ?model pwm:hasModelCard ?card . ?card pwm:modelVersion ?version } }""" ] .

pwmsh:LiveRiskAppetiteShape a sh:NodeShape ;
    rdfs:label "Live use case risk appetite"@en ;
    sh:targetClass pwm:AIUseCase ; dcterms:source pwmref:KOG-ROADMAP, pwmref:MAS-AIRG ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:message "An explicit failed risk-appetite evaluation prevents activation (Kognita 0.4 item 8; MAS AIRG 4.11)." ;
        sh:select """SELECT $this WHERE { $this pwm:lifecycleStatus pwm:StatusLive ; pwm:appetitePermits false . }""" ] .

# Written 0.5 rules

pwmsh:AgentIdentityShape a sh:NodeShape ; rdfs:label "AgentIdentityShape"@en ; sh:targetClass pwm:AIAgent ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 1. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:workloadIdentity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:WorkloadIdentity ; sh:message "pwm:workloadIdentity: minimum count 1, maximum count 1, class pwm:WorkloadIdentity." ] ;
    sh:property [ sh:path pwm:agentOwner ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person ; sh:message "pwm:agentOwner: minimum count 1, maximum count 1, class fibo-fnd-aap-ppl:Person." ] ;
    sh:property [ sh:path pwm:operatesFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person ; sh:message "pwm:operatesFor: minimum count 1, maximum count 1, class fibo-fnd-aap-ppl:Person." ] ;
    sh:property [ sh:path pwm:hasPurpose ; sh:minCount 1 ; sh:class pwm:Purpose ; sh:message "pwm:hasPurpose: minimum count 1, class pwm:Purpose." ] ;
    sh:property [ sh:path pwm:deploymentDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:deploymentDate: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:deploymentModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIModel ; sh:message "pwm:deploymentModel: minimum count 1, maximum count 1, class pwm:AIModel." ] ;
    sh:property [ sh:path pwm:deploymentEnvironment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:deploymentEnvironment: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:agentStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "pwm:agentStatus: minimum count 1, maximum count 1." ] ;
    sh:property [ sh:path pwm:approvedDeploymentVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:approvedDeploymentVersion: minimum count 1, maximum count 1, datatype xsd:string." ] .

pwmsh:WorkloadIdentityShape a sh:NodeShape ; rdfs:label "WorkloadIdentityShape"@en ; sh:targetClass pwm:WorkloadIdentity ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 1. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:credentialReference ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; sh:message "pwm:credentialReference: minimum count 1, maximum count 1, datatype xsd:anyURI." ] ;
    sh:property [ sh:path pwm:credentialIssuer ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; sh:message "pwm:credentialIssuer: minimum count 1, maximum count 1, datatype xsd:anyURI." ] ;
    sh:property [ sh:path pwm:workloadSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:workloadSubject: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:deploymentEnvironment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:deploymentEnvironment: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Workload subjects must not be shared (Kognita 0.5 item 1)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:workloadSubject ?s . ?other pwm:workloadSubject ?s . FILTER(?other != $this) }""" ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Credential references must not be shared by distinct workload identities (Kognita 0.5 item 1)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:credentialReference ?credential . ?other a pwm:WorkloadIdentity ; pwm:credentialReference ?credential . FILTER(?other != $this) }""" ] .

pwmsh:AgentDecisionShape a sh:NodeShape ; rdfs:label "AgentDecisionShape"@en ; sh:targetClass pwm:GovernedCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 1. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Agent calls require live approved deployment, current review and unrevoked own workload identity (Kognita 0.5 item 1)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?agent ; pwm:governedByDecision ?decision . ?decision pwm:decisionOutcome ?out . FILTER (?out != pwm:OutcomeDeny)
 FILTER NOT EXISTS { ?agent pwm:deploymentVersion ?v ; pwm:approvedDeploymentVersion ?v ; pwm:agentStatus pwm:StatusLive ; pwm:nextReviewDate ?due ; pwm:workloadIdentity ?identity .
 $this pwm:workloadIdentity ?identity . ?decision <http://www.w3.org/ns/prov#generatedAtTime> ?at .
 BIND(IF(REGEX(STR(?due), "(Z|[+-][0-9]{2}:[0-9]{2})$"), STR(?due), CONCAT(STR(?due), "Z")) AS ?dueZone)
 BIND(xsd:dateTime(REPLACE(?dueZone, "^([0-9]{4}-[0-9]{2}-[0-9]{2})(.*)$", "$1T00:00:00$2")) + "P1D"^^xsd:dayTimeDuration AS ?expires)
 BIND(xsd:dateTime(IF(REGEX(STR(?at), "(Z|[+-][0-9]{2}:[0-9]{2})$"), STR(?at), CONCAT(STR(?at), "Z"))) AS ?decisionAt)
 FILTER(?decisionAt < ?expires)
 FILTER NOT EXISTS { ?rev pwm:revokedAuthority ?identity ; pwm:revokedAt ?rt . FILTER(?rt <= ?at) } } }""" ] .

pwmsh:AuthorityScopeShape a sh:NodeShape ; rdfs:label "AuthorityScopeShape"@en ; sh:targetClass pwm:AuthorityScope ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:aboutClient ; sh:minCount 1 ; sh:class pwm:Client ; sh:message "pwm:aboutClient: minimum count 1, class pwm:Client." ] ;
    sh:property [ sh:path pwm:hasPurpose ; sh:minCount 1 ; sh:class pwm:Purpose ; sh:message "pwm:hasPurpose: minimum count 1, class pwm:Purpose." ] ;
    sh:property [ sh:path pwm:actionVerb ; sh:minCount 1 ; sh:message "pwm:actionVerb: minimum count 1." ] ;
    sh:property [ sh:path pwm:classification ; sh:minCount 1 ; sh:message "pwm:classification: minimum count 1." ] ;
    sh:property [ sh:path pwm:scopeTool ; sh:minCount 1 ; sh:class pwm:Tool ; sh:message "pwm:scopeTool: minimum count 1, class pwm:Tool." ] ;
    sh:property [ sh:path pwm:scopeField ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "pwm:scopeField: minimum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:jurisdictionCode ; sh:minCount 1 ; sh:datatype xsd:string ; sh:message "pwm:jurisdictionCode: minimum count 1, datatype xsd:string." ]  ;
    sh:property [ sh:path pwm:scopeAutonomyLevel ; sh:minCount 1 ; sh:maxCount 1  ; sh:message "scopeAutonomyLevel: minimum count 1; maximum count 1." ] .

pwmsh:HumanEntitlementShape a sh:NodeShape ; rdfs:label "HumanEntitlementShape"@en ; sh:targetClass pwm:HumanEntitlement ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:authorityScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AuthorityScope ; sh:message "pwm:authorityScope: minimum count 1, maximum count 1, class pwm:AuthorityScope." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:validFrom: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:validUntil ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:validUntil: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:lessThan pwm:validUntil ; sh:message "validFrom must be earlier than validUntil (Kognita 0.5 item 2)." ] .

pwmsh:DelegationScopeShape a sh:NodeShape ; rdfs:label "DelegationScopeShape"@en ; sh:targetClass pwm:DelegatedAuthority ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:authorityScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AuthorityScope ; sh:message "pwm:authorityScope: minimum count 1, maximum count 1, class pwm:AuthorityScope." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:validFrom: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:delegationDepth ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "pwm:delegationDepth: minimum count 1, maximum count 1, datatype xsd:nonNegativeInteger." ] ;
    sh:property [ sh:path pwm:maxDelegationDepth ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "pwm:maxDelegationDepth: minimum count 1, maximum count 1, datatype xsd:nonNegativeInteger." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:lessThan pwm:validUntil ; sh:message "validFrom must be earlier than validUntil (Kognita 0.5 item 2)." ] ;
    sh:property [ sh:path pwm:delegationDepth ; sh:lessThanOrEquals pwm:maxDelegationDepth ; sh:message "delegationDepth must not exceed maxDelegationDepth (Kognita 0.5 item 2)." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Grantor must hold an entitlement covering the complete explicit delegation scope and time (Kognita 0.5 item 2)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:delegatedBy ?human ; pwm:authorityScope ?scope ; pwm:validFrom ?start ; pwm:validUntil ?end .
 FILTER NOT EXISTS { ?human pwm:holdsEntitlement ?e . ?e pwm:authorityScope ?hs ; pwm:validFrom ?es ; pwm:validUntil ?ee . FILTER (?es <= ?start && ?ee >= ?end)

 ?scope pwm:classification ?childClass . ?hs pwm:classification ?parentClass .
 BIND(IF(?childClass = pwm:C0,0,IF(?childClass = pwm:C1,1,IF(?childClass = pwm:C2,2,3))) AS ?childRank)
 BIND(IF(?parentClass = pwm:C0,0,IF(?parentClass = pwm:C1,1,IF(?parentClass = pwm:C2,2,3))) AS ?parentRank)
 FILTER(?childRank <= ?parentRank)
 FILTER NOT EXISTS { ?scope ?dim ?value . FILTER (?dim IN (pwm:aboutClient,pwm:hasPurpose,pwm:actionVerb,pwm:scopeTool,pwm:scopeField,pwm:scopeSystem,pwm:scopeProduct,pwm:jurisdictionCode)) FILTER NOT EXISTS { ?hs ?dim ?value } }
 } }""" ] .

pwmsh:AuthorityRevocationShape a sh:NodeShape ; rdfs:label "AuthorityRevocationShape"@en ; sh:targetClass pwm:AuthorityRevocation ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:revokedAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "pwm:revokedAuthority: minimum count 1, maximum count 1." ] ;
    sh:property [ sh:path pwm:revokedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:revokedAt: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:rationale: minimum count 1, maximum count 1, datatype xsd:string." ] .

pwmsh:LiveAuthorityDecisionShape a sh:NodeShape ; rdfs:label "LiveAuthorityDecisionShape"@en ; sh:targetClass pwm:GovernedCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Both call and decision must cite the same live delegation to this agent and a live, unrevoked human entitlement covering the complete delegation scope (Kognita 0.5 item 2)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?a ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER (?out != pwm:OutcomeDeny)
 FILTER NOT EXISTS { $this pwm:reliesOnDelegation ?auth . ?d pwm:reliesOnDelegation ?auth ; <http://www.w3.org/ns/prov#generatedAtTime> ?at .
 ?auth pwm:delegatedTo ?a ; pwm:delegatedBy ?h ; pwm:authorityScope ?s ; pwm:validFrom ?start ; pwm:validUntil ?end .
 FILTER(?at >= ?start && ?at < ?end)
 ?h pwm:holdsEntitlement ?e . ?e pwm:validFrom ?es ; pwm:validUntil ?ee ; pwm:authorityScope ?hs . FILTER (?at >= ?es && ?at < ?ee)

 ?s pwm:classification ?childClass . ?hs pwm:classification ?parentClass .
 BIND(IF(?childClass = pwm:C0,0,IF(?childClass = pwm:C1,1,IF(?childClass = pwm:C2,2,3))) AS ?childRank)
 BIND(IF(?parentClass = pwm:C0,0,IF(?parentClass = pwm:C1,1,IF(?parentClass = pwm:C2,2,3))) AS ?parentRank)
 FILTER(?childRank <= ?parentRank)
 FILTER NOT EXISTS { ?s ?dim ?v . FILTER (?dim IN (pwm:aboutClient,pwm:hasPurpose,pwm:actionVerb,pwm:scopeTool,pwm:scopeField,pwm:scopeSystem,pwm:scopeProduct,pwm:jurisdictionCode)) FILTER NOT EXISTS { ?hs ?dim ?v } }
 FILTER NOT EXISTS { ?rev pwm:revokedAuthority ?e ; pwm:revokedAt ?et . FILTER(?et <= ?at) }
 FILTER NOT EXISTS { ?auth pwm:parentDelegation* ?ancestor . ?rev pwm:revokedAuthority ?ancestor ; pwm:revokedAt ?rt . FILTER(?rt <= ?at) }
 FILTER NOT EXISTS { ?auth pwm:parentDelegation+ ?ancestor . ?ancestor pwm:validUntil ?ae . FILTER(?at >= ?ae) }
 } }""" ] .

pwmsh:SubDelegationShape a sh:NodeShape ; rdfs:label "SubDelegationShape"@en ; sh:targetSubjectsOf pwm:parentDelegation ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 9. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Sub-delegation must be acyclic, narrow every explicit scope set and period, and respect depth (Kognita 0.5 item 9)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:parentDelegation ?parent .
 FILTER (EXISTS { $this pwm:parentDelegation+ $this } || NOT EXISTS {
 $this pwm:authorityScope ?s ; pwm:delegationDepth ?depth ; pwm:maxDelegationDepth ?max ; pwm:validFrom ?start ; pwm:validUntil ?end ; pwm:delegatedBy ?human .
 ?parent pwm:authorityScope ?ps ; pwm:delegationDepth ?pd ; pwm:maxDelegationDepth ?pm ; pwm:validFrom ?pstart ; pwm:validUntil ?pend ; pwm:delegatedBy ?human .
 FILTER(?depth = ?pd + 1 && ?depth <= ?max && ?max <= ?pm && ?start >= ?pstart && ?end <= ?pend)

 ?s pwm:classification ?childClass . ?ps pwm:classification ?parentClass .
 BIND(IF(?childClass = pwm:C0,0,IF(?childClass = pwm:C1,1,IF(?childClass = pwm:C2,2,3))) AS ?childRank)
 BIND(IF(?parentClass = pwm:C0,0,IF(?parentClass = pwm:C1,1,IF(?parentClass = pwm:C2,2,3))) AS ?parentRank)
 FILTER(?childRank <= ?parentRank)
 FILTER NOT EXISTS { ?s ?dim ?v . FILTER (?dim IN (pwm:aboutClient,pwm:hasPurpose,pwm:actionVerb,pwm:scopeTool,pwm:scopeField,pwm:scopeSystem,pwm:scopeProduct,pwm:jurisdictionCode)) FILTER NOT EXISTS { ?ps ?dim ?v } }
 }) }""" ]  ;
    sh:property [ sh:path pwm:parentDelegation ; sh:maxCount 1 ; sh:class pwm:DelegatedAuthority  ; sh:message "parentDelegation: maximum count 1; class DelegatedAuthority." ] .

pwmsh:PromotionGateShape a sh:NodeShape ; rdfs:label "PromotionGateShape"@en ; sh:targetClass pwm:AutonomyPromotionGate ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 3. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:minimumSample ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:message "pwm:minimumSample: minimum count 1, maximum count 1, datatype xsd:positiveInteger." ] ;
    sh:property [ sh:path pwm:minimumWindowSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:minimumWindowSeconds: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:qualityThreshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:qualityThreshold: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:exceptionRateThreshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:exceptionRateThreshold: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:requiresFullTraceability ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:requiresFullTraceability: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:stepDownThreshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:stepDownThreshold: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:qualityThreshold ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:message "pwm:qualityThreshold: minimum inclusive 0, maximum inclusive 1." ] ;
    sh:property [ sh:path pwm:exceptionRateThreshold ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:message "pwm:exceptionRateThreshold: minimum inclusive 0, maximum inclusive 1." ] ;
    sh:property [ sh:path pwm:stepDownThreshold ; sh:minInclusive 0 ; sh:lessThan pwm:qualityThreshold ; sh:message "pwm:stepDownThreshold: minimum inclusive 0, must be earlier or lower than pwm:qualityThreshold." ] ;
    sh:property [ sh:path pwm:minimumWindowSeconds ; sh:minExclusive 0 ; sh:message "pwm:minimumWindowSeconds: minimum exclusive 0." ] .

pwmsh:AutonomyTransitionShape a sh:NodeShape ; rdfs:label "AutonomyTransitionShape"@en ; sh:targetClass pwm:AutonomyTransition ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 3. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:transitionAgent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIAgent ; sh:message "pwm:transitionAgent: minimum count 1, maximum count 1, class pwm:AIAgent." ] ;
    sh:property [ sh:path pwm:promotionGate ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AutonomyPromotionGate ; sh:message "pwm:promotionGate: minimum count 1, maximum count 1, class pwm:AutonomyPromotionGate." ] ;
    sh:property [ sh:path pwm:fromAutonomyLevel ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "pwm:fromAutonomyLevel: minimum count 1, maximum count 1." ] ;
    sh:property [ sh:path pwm:toAutonomyLevel ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "pwm:toAutonomyLevel: minimum count 1, maximum count 1." ] ;
    sh:property [ sh:path pwm:sampleCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "pwm:sampleCount: minimum count 1, maximum count 1, datatype xsd:nonNegativeInteger." ] ;
    sh:property [ sh:path pwm:observedQuality ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:observedQuality: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:observedExceptionRate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:observedExceptionRate: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:fullyReconstructable ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:fullyReconstructable: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:transitionApproved ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:transitionApproved: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:windowStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:windowStart: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:windowEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:windowEnd: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:windowStart ; sh:lessThan pwm:windowEnd ; sh:message "pwm:windowStart: must be earlier or lower than pwm:windowEnd." ] ;
    sh:property [ sh:path pwm:observedQuality ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:message "pwm:observedQuality: minimum inclusive 0, maximum inclusive 1." ] ;
    sh:property [ sh:path pwm:observedExceptionRate ; sh:minInclusive 0 ; sh:maxInclusive 1 ; sh:message "pwm:observedExceptionRate: minimum inclusive 0, maximum inclusive 1." ] .

pwmsh:AutonomyEvidenceShape a sh:NodeShape ; rdfs:label "AutonomyEvidenceShape"@en ; sh:targetClass pwm:AutonomyTransition ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 3. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Promotion requires evidence thresholds, sample/window, owner and independent validation; step-down is one level and alerts owners (Kognita 0.5 item 3)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:fromAutonomyLevel ?from ; pwm:toAutonomyLevel ?to ; pwm:promotionGate ?g ; pwm:transitionAgent ?a ; pwm:observedQuality ?q .
 BIND(IF(?from = pwm:L0Retrieve, 0, IF(?from = pwm:L1Explain, 1, IF(?from = pwm:L2Recommend, 2, IF(?from = pwm:L3Draft, 3, IF(?from = pwm:L4ActAfterApproval, 4, IF(?from = pwm:L5BoundedAutonomy, 5, IF(?from = pwm:L6BroadAutonomy, 6, 99))))))) AS ?fr) BIND(IF(?to = pwm:L0Retrieve, 0, IF(?to = pwm:L1Explain, 1, IF(?to = pwm:L2Recommend, 2, IF(?to = pwm:L3Draft, 3, IF(?to = pwm:L4ActAfterApproval, 4, IF(?to = pwm:L5BoundedAutonomy, 5, IF(?to = pwm:L6BroadAutonomy, 6, 99))))))) AS ?tr)
 FILTER ((?tr > ?fr && EXISTS { $this pwm:transitionApproved true } && NOT EXISTS {
 $this pwm:sampleCount ?n ; pwm:observedExceptionRate ?ex ; pwm:fullyReconstructable ?trace ; pwm:windowStart ?start ; pwm:windowEnd ?end ; pwm:ownerApproval ?owner ; pwm:independentValidation ?validator .
 ?a pwm:agentOwner ?owner . ?validator cmns-rlcmp:isPlayedBy ?person . FILTER(?person != ?owner)
 ?g pwm:minimumSample ?min ; pwm:qualityThreshold ?qt ; pwm:exceptionRateThreshold ?et ; pwm:requiresFullTraceability ?req ; pwm:minimumWindowSeconds ?seconds .
 FILTER(?n >= ?min && ?q >= ?qt && ?ex < ?et && (!?req || ?trace))
 BIND(STR(?end - ?start) AS ?span)
 BIND(IF(REGEX(?span, "[0-9]+D"), <http://www.w3.org/2001/XMLSchema#decimal>(REPLACE(?span, "^P([0-9]+)D.*$", "$1")), 0) AS ?days)
 BIND(IF(REGEX(?span, "[0-9]+H"), <http://www.w3.org/2001/XMLSchema#decimal>(REPLACE(?span, "^.*T([0-9]+)H.*$", "$1")), 0) AS ?hours)
 BIND(IF(REGEX(?span, "T.*[0-9]+M"), <http://www.w3.org/2001/XMLSchema#decimal>(REPLACE(?span, "^.*[TH]([0-9]+)M.*$", "$1")), 0) AS ?minutes)
 BIND(IF(REGEX(?span, "[0-9.]+S"), <http://www.w3.org/2001/XMLSchema#decimal>(REPLACE(?span, "^.*[THM]([0-9.]+)S$", "$1")), 0) AS ?secs)
 FILTER(?days * 86400 + ?hours * 3600 + ?minutes * 60 + ?secs >= ?seconds)
 }) || (?tr < ?fr && (?tr != ?fr - 1 || NOT EXISTS { ?g pwm:stepDownThreshold ?st . FILTER(?q < ?st || EXISTS { $this pwm:qualityDrift true }) $this pwm:notifiedRole ?ownerRole, ?kl . ?ownerRole a pwm:BusinessOwner . ?kl a pwm:KnowledgeLead . }))) }""" ] .

pwmsh:BlastRadiusLimitShape a sh:NodeShape ; rdfs:label "BlastRadiusLimitShape"@en ; sh:targetClass pwm:BlastRadiusLimit ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 4. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:limitDimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:limitDimension: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:limitWindowBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:limitWindowBasis: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:limitUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:limitUnit: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:limitMaximum ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:limitMaximum: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:limitMaximum ; sh:minInclusive 0 ; sh:message "pwm:limitMaximum: minimum inclusive 0." ] ;
    sh:property [ sh:path pwm:limitDimension ; sh:in ( "records" "clients" "value" "actions" "transactions" "clients-contacted" ) ; sh:message "pwm:limitDimension: allowed values ( 'records' 'clients' 'value' 'actions' 'transactions' 'clients-contacted' )." ] ;
    sh:property [ sh:path pwm:limitWindowBasis ; sh:in ( "action" "run" "minute" "hour" "UTC-day" ) ; sh:message "pwm:limitWindowBasis: allowed values ( 'action' 'run' 'minute' 'hour' 'UTC-day' )." ] .

pwmsh:BlastRadiusObservationShape a sh:NodeShape ; rdfs:label "BlastRadiusObservationShape"@en ; sh:targetClass pwm:BlastRadiusObservation ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 4. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:observedLimit ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:BlastRadiusLimit ; sh:message "pwm:observedLimit: minimum count 1, maximum count 1, class pwm:BlastRadiusLimit." ] ;
    sh:property [ sh:path pwm:projectedConsumption ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:projectedConsumption: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:projectedConsumption ; sh:minInclusive 0 ; sh:message "pwm:projectedConsumption: minimum inclusive 0." ] .

pwmsh:BlastRadiusDecisionShape a sh:NodeShape ; rdfs:label "BlastRadiusDecisionShape"@en ; sh:targetClass pwm:PolicyDecision ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 4. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Projected consumption exceeding any agent blast-radius cap cannot be ALLOW (Kognita 0.5 item 4)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:decisionOutcome pwm:OutcomeAllow ; pwm:limitObservation ?o . ?o pwm:observedLimit/pwm:limitMaximum ?max ; pwm:projectedConsumption ?n . FILTER (?n > ?max) }""" ]  ;
 sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "ALLOW requires exactly one observation for each calling agent limit and no unrelated limits." ; sh:select """SELECT DISTINCT $this WHERE {
 $this pwm:decisionOutcome pwm:OutcomeAllow . ?call pwm:governedByDecision $this ; pwm:callAgent ?agent . ?agent pwm:hasBlastRadiusLimit ?limit .
 FILTER (NOT EXISTS { $this pwm:limitObservation ?obs . ?obs pwm:observedLimit ?limit } ||
 EXISTS { $this pwm:limitObservation ?obs1, ?obs2 . ?obs1 pwm:observedLimit ?limit . ?obs2 pwm:observedLimit ?limit . FILTER(?obs1 != ?obs2) } ||
 EXISTS { $this pwm:limitObservation/pwm:observedLimit ?other . FILTER NOT EXISTS { ?agent pwm:hasBlastRadiusLimit ?other } })
 }""" ] .

pwmsh:ToolAllowListShape a sh:NodeShape ; rdfs:label "ToolAllowListShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 5. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A tool outside the agent allow-list must be DENY (Kognita 0.5 item 5)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?agent ; pwm:invokedTool ?tool ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER (?out != pwm:OutcomeDeny) FILTER NOT EXISTS { ?agent pwm:permittedTool ?tool } }""" ] .

pwmsh:FieldMinimizationShape a sh:NodeShape ; rdfs:label "FieldMinimizationShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 5. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Requested fields outside purpose-specific agent permissions must be DENY (Kognita 0.5 item 5)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?agent ; pwm:requestedField ?field ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER (?out != pwm:OutcomeDeny) FILTER NOT EXISTS { ?agent pwm:permittedField ?field } }""" ] .

pwmsh:ExternalContentShape a sh:NodeShape ; rdfs:label "ExternalContentShape"@en ; sh:targetClass pwm:ExternalContent ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 6. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:trustLabel ; sh:minCount 1 ; sh:message "pwm:trustLabel: minimum count 1." ] ;
    sh:property [ sh:path pwm:trustLabel ; sh:hasValue pwm:TrustExternal ; sh:message "pwm:trustLabel: required value pwm:TrustExternal." ] ;
    sh:property [ sh:path pwm:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:contentHash: minimum count 1, maximum count 1, datatype xsd:string." ] .

pwmsh:ContentIsolationShape a sh:NodeShape ; rdfs:label "ContentIsolationShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 6. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Externally tainted runs cannot write; client-data taint cannot reach public-content tools (Kognita 0.5 item 6)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:governedByDecision ?d ; pwm:invokedTool ?t . ?d pwm:decisionOutcome ?out . FILTER(?out != pwm:OutcomeDeny)
 { $this (pwm:inputContent|pwm:inRun/pwm:inputContent)/pwm:trustLabel pwm:TrustExternal . ?t pwm:actionVerb ?v . FILTER (?v IN (pwm:VerbDraft,pwm:VerbQueue,pwm:VerbSend,pwm:VerbExecute)) }
 UNION { $this (pwm:inputContent|pwm:inRun/pwm:inputContent)/pwm:trustLabel pwm:TrustClientData . ?t pwm:publicContentTool true } }""" ] .

pwmsh:AuthenticatedInstructionShape a sh:NodeShape ; rdfs:label "AuthenticatedInstructionShape"@en ; sh:targetClass pwm:AuthenticatedInstruction ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 7. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:instructionSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; sh:message "pwm:instructionSource: minimum count 1, maximum count 1, datatype xsd:anyURI." ] ;
    sh:property [ sh:path pwm:instructionPrincipal ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person ; sh:message "pwm:instructionPrincipal: minimum count 1, maximum count 1, class fibo-fnd-aap-ppl:Person." ] ;
    sh:property [ sh:path pwm:assuranceLevel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:assuranceLevel: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:assuranceLevel ; sh:in ( "channel-only" "authenticated" "step-up" ) ; sh:message "pwm:assuranceLevel: allowed values ( 'channel-only' 'authenticated' 'step-up' )." ] ;
    sh:property [ sh:path pwm:transactionContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:transactionContext: minimum count 1, maximum count 1, datatype xsd:string." ] .

pwmsh:InstructionAssuranceShape a sh:NodeShape ; rdfs:label "InstructionAssuranceShape"@en ; sh:targetSubjectsOf pwm:requiresStepUp ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 7. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Allowed high-risk instructions require signed step-up evidence and a completed approval of a held decision in the same run, strictly before the allowed decision (Kognita 0.5 item 7)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:requiresStepUp true ; pwm:decisionOutcome pwm:OutcomeAllow . FILTER NOT EXISTS { $this pwm:instructionEvidence ?i ; pwm:humanApproval ?approval . ?i pwm:assuranceLevel "step-up" ; pwm:signatureReference ?signature . ?approval pwm:approvalResolution pwm:ApprovalApproved ; pwm:resolvesApproval ?request . ?request a pwm:ApprovalRequest ; pwm:requestsDecision ?held ; pwm:atCheckpoint ?checkpoint . ?held pwm:decisionOutcome pwm:OutcomeHumanApproval ; pwm:inRun ?run ; pwm:underUseCase ?approvalUseCase ; pwm:decidedByRule ?approvalRule . ?checkpoint pwm:inRun ?run ; pwm:runState pwm:RunSuspended . $this pwm:inRun ?run ; pwm:underUseCase ?approvalUseCase ; pwm:decidedByRule ?approvalRule ; prov:generatedAtTime ?decisionAt . ?approval prov:generatedAtTime ?approvedAt . FILTER(?approvedAt < ?decisionAt) } }""" ] .

pwmsh:BehaviourBaselineShape a sh:NodeShape ; rdfs:label "BehaviourBaselineShape"@en ; sh:targetClass pwm:BehaviourBaseline ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 8. Checks recorded evidence; runtime enforcement remains external."@en ;
