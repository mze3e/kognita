    sh:property [ sh:path pwm:ingestedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:IngestedDocument ; sh:message "Record ingestedFrom (Kognita 0.4 item 1)." ] ;
    sh:property [ sh:path pwm:pageNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:message "Record pageNumber (Kognita 0.4 item 1)." ] ;
    sh:property [ sh:path pwm:sectionPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:message "Record sectionPath (Kognita 0.4 item 1)." ] ;
    sh:property [ sh:path pwm:characterStart ; sh:lessThan pwm:characterEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record characterStart (Kognita 0.4 item 1)." ] ;
    sh:property [ sh:path pwm:characterEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:message "Record characterEnd (Kognita 0.4 item 1)." ] ;
    sh:property [ sh:path pwm:classification ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record classification (Kognita 0.4 item 1)." ] ;
