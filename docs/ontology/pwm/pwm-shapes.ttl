    sh:property [ sh:path pwm:fleetIsolation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:fleetIsolation: minimum count 1, maximum count 1, datatype xsd:string." ] .

