    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 14. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:versionId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:versionId: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:threatModelReference ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ; sh:message "pwm:threatModelReference: minimum count 1, maximum count 1, datatype xsd:anyURI." ] .

pwmsh:EnforcementAttestationShape a sh:NodeShape ; rdfs:label "EnforcementAttestationShape"@en ; sh:targetClass pwm:EnforcementAttestation ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 15. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:attestedUseCase ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIUseCase ; sh:message "pwm:attestedUseCase: minimum count 1, maximum count 1, class pwm:AIUseCase." ] ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "prov:generatedAtTime: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fibo-fnd-aap-ppl:Person ; sh:message "prov:wasAttributedTo: minimum count 1, maximum count 1, class fibo-fnd-aap-ppl:Person." ] ;
    sh:property [ sh:path pwm:gatewayOnlyCredentials ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:gatewayOnlyCredentials: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:egressRestricted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:egressRestricted: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:property [ sh:path pwm:evidenceStoreIsolated ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:evidenceStoreIsolated: minimum count 1, maximum count 1, datatype xsd:boolean." ] .

pwmsh:DeploymentEnforcementShape a sh:NodeShape ; rdfs:label "DeploymentEnforcementShape"@en ; sh:targetClass pwm:AIUseCase ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 15. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:deploymentMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:deploymentMode: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:deploymentMode ; sh:in ( "gateway" "library" ) ; sh:message "pwm:deploymentMode: allowed values ( 'gateway' 'library' )." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Tier 2 or above requires gateway mode and attestation of isolated credentials, routing and evidence (Kognita 0.5 item 15)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:riskTier ?tier . FILTER(?tier IN (pwm:Tier2,pwm:Tier3,pwm:Tier4)) FILTER NOT EXISTS { $this pwm:deploymentMode "gateway" ; pwm:enforcementAttestation ?a . ?a pwm:attestedUseCase $this ; pwm:gatewayOnlyCredentials true ; pwm:egressRestricted true ; pwm:evidenceStoreIsolated true } }""" ] .

pwmsh:BoundedToolShape a sh:NodeShape ; rdfs:label "BoundedToolShape"@en ; sh:targetClass pwm:Tool ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 16. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:maximumDurationSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:maximumDurationSeconds: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:maximumDurationSeconds ; sh:minExclusive 0 ; sh:message "pwm:maximumDurationSeconds: minimum exclusive 0." ] ;
    sh:property [ sh:path pwm:supportsCancellation ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "pwm:supportsCancellation: minimum count 1, maximum count 1, datatype xsd:boolean." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Uncancellable tools need compensation or steps with intervening decisions (Kognita 0.5 item 16)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:supportsCancellation false . FILTER NOT EXISTS { $this pwm:compensatingAction ?a } FILTER NOT EXISTS { $this pwm:decisionSeparatedSteps true } }""" ] .

pwmsh:ActionStopShape a sh:NodeShape ; rdfs:label "ActionStopShape"@en ; sh:targetClass pwm:ActionStop ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 16. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:stoppedCall ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ToolCall ; sh:message "pwm:stoppedCall: minimum count 1, maximum count 1, class pwm:ToolCall." ] ;
    sh:property [ sh:path pwm:stopOutcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:stopOutcome: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:stopOutcome ; sh:in ( "cancelled" "completed" "timed-out" "unsupported" ) ; sh:message "pwm:stopOutcome: allowed values ( 'cancelled' 'completed' 'timed-out' 'unsupported' )." ] ;
    sh:property [ sh:path pwm:stopReason ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:stopReason: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "prov:generatedAtTime: minimum count 1, maximum count 1, datatype xsd:dateTime." ] .

pwmsh:AuthorityRequestScopeShape a sh:NodeShape ; rdfs:label "AuthorityRequestScopeShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A live delegation must authorize this tool, every declared tool verb, purpose, client, fields, exactly one jurisdictionCode and exactly one classification at or below the scope ceiling by rank (Kognita 0.5 item 2)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?a ; pwm:invokedTool ?tool ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER(?out != pwm:OutcomeDeny)
 FILTER NOT EXISTS { $this pwm:reliesOnDelegation/pwm:authorityScope ?s ; pwm:aboutClient ?client . ?tool pwm:actionVerb ?verb .
 ?s pwm:scopeTool ?tool ; pwm:aboutClient ?client .
 FILTER NOT EXISTS { ?tool pwm:actionVerb ?declaredVerb . FILTER NOT EXISTS { ?s pwm:actionVerb ?declaredVerb } } ?d pwm:hasPurpose ?purpose . ?s pwm:hasPurpose ?purpose .
 FILTER NOT EXISTS { $this pwm:requestedField ?field . FILTER NOT EXISTS { ?s pwm:scopeField ?field } }
 $this pwm:jurisdictionCode ?j ; pwm:classification ?c . ?s pwm:jurisdictionCode ?j ; pwm:classification ?ceiling .
 FILTER NOT EXISTS { $this pwm:jurisdictionCode ?otherJ . FILTER(!sameTerm(?otherJ, ?j)) }
 FILTER NOT EXISTS { $this pwm:classification ?otherC . FILTER(!sameTerm(?otherC, ?c)) }
 FILTER(?c IN (pwm:C0,pwm:C1,pwm:C2,pwm:C3) && ?ceiling IN (pwm:C0,pwm:C1,pwm:C2,pwm:C3))
 BIND(IF(?c = pwm:C0,0,IF(?c = pwm:C1,1,IF(?c = pwm:C2,2,3))) AS ?rank)
 BIND(IF(?ceiling = pwm:C0,0,IF(?ceiling = pwm:C1,1,IF(?ceiling = pwm:C2,2,3))) AS ?ceilingRank)
 FILTER(?rank <= ?ceilingRank)
 } }""" ] .

pwmsh:ScopeNarrowingLimitsShape a sh:NodeShape ; rdfs:label "ScopeNarrowingLimitsShape"@en ; sh:targetSubjectsOf pwm:parentDelegation ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 9. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Sub-delegation retains all parent numeric caps and may not increase autonomy (Kognita 0.5 item 9)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:parentDelegation ?p ; pwm:authorityScope ?s . ?p pwm:authorityScope ?ps .
 { ?ps pwm:scopeLimit ?limit . ?limit pwm:limitDimension ?dim ; pwm:limitWindowBasis ?basis ; pwm:limitUnit ?unit ; pwm:limitMaximum ?max .
 FILTER NOT EXISTS { ?s pwm:scopeLimit ?cl . ?cl pwm:limitDimension ?dim ; pwm:limitWindowBasis ?basis ; pwm:limitUnit ?unit ; pwm:limitMaximum ?cm . FILTER(?cm <= ?max) } }
 UNION { ?ps pwm:scopeAutonomyLevel ?pl . FILTER NOT EXISTS { ?s pwm:scopeAutonomyLevel ?sl . FILTER(IF(?sl = pwm:L0Retrieve, 0, IF(?sl = pwm:L1Explain, 1, IF(?sl = pwm:L2Recommend, 2, IF(?sl = pwm:L3Draft, 3, IF(?sl = pwm:L4ActAfterApproval, 4, IF(?sl = pwm:L5BoundedAutonomy, 5, IF(?sl = pwm:L6BroadAutonomy, 6, 99))))))) <= IF(?pl = pwm:L0Retrieve, 0, IF(?pl = pwm:L1Explain, 1, IF(?pl = pwm:L2Recommend, 2, IF(?pl = pwm:L3Draft, 3, IF(?pl = pwm:L4ActAfterApproval, 4, IF(?pl = pwm:L5BoundedAutonomy, 5, IF(?pl = pwm:L6BroadAutonomy, 6, 99)))))))) } } }""" ] .

pwmsh:AutonomyCallShape a sh:NodeShape ; rdfs:label "AutonomyCallShape"@en ; sh:targetClass pwm:ToolCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 3. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Calls cannot exceed effective or maximum autonomy; L4 routes to human approval (Kognita 0.5 item 3)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?a ; pwm:invokedTool ?t ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER(?out != pwm:OutcomeDeny)
 ?t pwm:requiredAutonomyLevel ?tl . ?a pwm:maxAutonomyLevel ?max . OPTIONAL { ?a pwm:effectiveAutonomyLevel ?effective } BIND(COALESCE(?effective,?max) AS ?al)
 FILTER(IF(?tl = pwm:L0Retrieve, 0, IF(?tl = pwm:L1Explain, 1, IF(?tl = pwm:L2Recommend, 2, IF(?tl = pwm:L3Draft, 3, IF(?tl = pwm:L4ActAfterApproval, 4, IF(?tl = pwm:L5BoundedAutonomy, 5, IF(?tl = pwm:L6BroadAutonomy, 6, 99))))))) > IF(?al = pwm:L0Retrieve, 0, IF(?al = pwm:L1Explain, 1, IF(?al = pwm:L2Recommend, 2, IF(?al = pwm:L3Draft, 3, IF(?al = pwm:L4ActAfterApproval, 4, IF(?al = pwm:L5BoundedAutonomy, 5, IF(?al = pwm:L6BroadAutonomy, 6, 99))))))) || (?tl = pwm:L4ActAfterApproval && ?out NOT IN (pwm:OutcomeHumanApproval,pwm:OutcomeDeny)) || IF(?al = pwm:L0Retrieve, 0, IF(?al = pwm:L1Explain, 1, IF(?al = pwm:L2Recommend, 2, IF(?al = pwm:L3Draft, 3, IF(?al = pwm:L4ActAfterApproval, 4, IF(?al = pwm:L5BoundedAutonomy, 5, IF(?al = pwm:L6BroadAutonomy, 6, 99))))))) > IF(?max = pwm:L0Retrieve, 0, IF(?max = pwm:L1Explain, 1, IF(?max = pwm:L2Recommend, 2, IF(?max = pwm:L3Draft, 3, IF(?max = pwm:L4ActAfterApproval, 4, IF(?max = pwm:L5BoundedAutonomy, 5, IF(?max = pwm:L6BroadAutonomy, 6, 99)))))))) }""" ] .

pwmsh:FleetHaltDecisionShape a sh:NodeShape ; rdfs:label "FleetHaltDecisionShape"@en ; sh:targetClass pwm:GovernedCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 11. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A halted fleet member must be denied on the next decision (Kognita 0.5 item 11)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callAgent ?a ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out ; <http://www.w3.org/ns/prov#generatedAtTime> ?at . FILTER(?out != pwm:OutcomeDeny)
 ?halt pwm:haltScope/pwm:fleetMember ?a ; <http://www.w3.org/ns/prov#generatedAtTime> ?ht . FILTER(?ht <= ?at) }""" ] .

pwmsh:ToolDurationShape a sh:NodeShape ; rdfs:label "ToolDurationShape"@en ; sh:targetSubjectsOf pwm:callDurationSeconds ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 16. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:callDurationSeconds ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxCount 1 ; sh:message "pwm:callDurationSeconds: maximum count 1, datatype xsd:decimal, minimum inclusive 0." ] ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A call beyond maximum duration needs an evidenced timeout (Kognita 0.5 item 16)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:callDurationSeconds ?n ; pwm:invokedTool/pwm:maximumDurationSeconds ?max . FILTER(?n > ?max) FILTER NOT EXISTS { ?stop pwm:stoppedCall $this ; pwm:stopOutcome "timed-out" } }""" ] .

pwmsh:ExclusiveWorkloadShape a sh:NodeShape ; rdfs:label "Exclusive workload identity"@en ; sh:targetClass pwm:AIAgent ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 1: credentials are never shared between agents."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Each registered agent has its own workload identity (Kognita 0.5 item 1)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:workloadIdentity ?i . ?other a pwm:AIAgent ; pwm:workloadIdentity ?i . FILTER(?other != $this) }""" ] .

# Review additions, 4 Nov 2026.
pwmsh:DelegationCeilingShape a sh:NodeShape ; rdfs:label "DelegationCeilingShape"@en ; sh:targetClass pwm:DelegatedAuthority ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 2. The permitted data class is the delegation's ceiling. Classes C0 to C3 are compared by their IRIs, which sort in rank order. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "A delegation's permitted data class must cover the classification of its authority scope, and a child delegation cannot permit a higher class than its parent (Kognita 0.5 item 2)." ;
        sh:select """SELECT DISTINCT $this WHERE {
            { $this pwm:permitsDataClass ?c ; pwm:authorityScope ?s . ?s pwm:classification ?sc . FILTER(STR(?c) < STR(?sc)) }
            UNION { $this pwm:permitsDataClass ?c ; pwm:parentDelegation ?p . ?p pwm:permitsDataClass ?pc . FILTER(STR(?c) > STR(?pc)) } }""" ] .

pwmsh:AgentAutonomyShape a sh:NodeShape ; rdfs:label "AgentAutonomyShape"@en ; sh:targetClass pwm:AIAgent ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 3. Levels L0 to L6 are compared by their IRIs, which sort in rank order. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "An agent's effective autonomy level cannot exceed its maximum autonomy level (Kognita 0.5 item 3)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:effectiveAutonomyLevel ?e ; pwm:maxAutonomyLevel ?m . FILTER(STR(?e) > STR(?m)) }""" ] .

pwmsh:RiskControlApprovalShape a sh:NodeShape ; rdfs:label "RiskControlApprovalShape"@en ;
    sh:targetClass pwm:BlastRadiusLimit, pwm:AutonomyPromotionGate ; dcterms:source pwmref:KOG-ROADMAP, pwmref:MAS-AIRG ;
    rdfs:comment "Firm-specific limits and gates must be set and approved by the risk committee, data governance committee or chief risk officer (Ahmed, 3 Nov 2026)."@en ;
    sh:property [ sh:path pwm:riskControlApproval ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RiskControlApproval ; sh:message "pwm:riskControlApproval: minimum count 1, maximum count 1, class pwm:RiskControlApproval." ] .

pwmsh:RiskControlApprovalRecordShape a sh:NodeShape ; rdfs:label "RiskControlApprovalRecordShape"@en ;
    sh:targetClass pwm:RiskControlApproval ; dcterms:source pwmref:KOG-ROADMAP, pwmref:MAS-AIRG ;
    rdfs:comment "Approval records identify a permitted firm approving role and approval time (Ahmed, 3 Nov 2026)."@en ;
    sh:property [ sh:path pwm:approverRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class pwm:RiskCommittee ] [ sh:class pwm:DataGovernanceCommittee ] [ sh:class pwm:ChiefRiskOfficer ] ) ; sh:message "Record exactly one approverRole: RiskCommittee, DataGovernanceCommittee or ChiefRiskOfficer." ] ;
    sh:property [ sh:path pwm:approvedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:approvedAt: minimum count 1, maximum count 1, datatype xsd:dateTime." ] .

