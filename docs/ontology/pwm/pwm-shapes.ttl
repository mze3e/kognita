pwmsh:ErasureShape a sh:NodeShape ; rdfs:label "ErasureShape"@en ; sh:targetClass pwm:ErasureEvent ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 7."@en ;
    sh:property [ sh:path pwm:erasedEntry ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RetentionEntry ; sh:message "Record erasedEntry (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record contentHash (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Erasure removes stored content reference and keeps the same hash on the entry, event and surviving chain evidence (0.3 item 7)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:erasedEntry ?entry ; pwm:contentHash ?hash . FILTER NOT EXISTS { ?entry pwm:contentHash ?hash ; pwm:erased true . FILTER NOT EXISTS { ?entry pwm:storeLocator ?locator } ?e pwm:evidenceFor $this ; pwm:eventType pwm:EventErasure ; pwm:contentHash ?hash ; pwm:recordHash ?recordHash } }""" ] .


pwmsh:ReconstructionReportShape a sh:NodeShape ; rdfs:label "ReconstructionReportShape"@en ; sh:targetClass pwm:ReconstructionReport ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 8."@en ;
    sh:property [ sh:path pwm:partOfInteraction ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:ClientInteraction ; sh:message "Record partOfInteraction (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:chainVerified ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "Record chainVerified (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:pinnedHashesVerified ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "Record pinnedHashesVerified (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Cover all ten questions explicitly, marking absent evidence not recorded (0.3 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { FILTER (NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionWhyClient ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionWhyProduct ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionInformation ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionModelAgent ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionAuthority ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionControls ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionRMChanges ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionFinalDecision ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionCommunication ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) } || NOT EXISTS { $this pwm:questionCoverage ?coverage . ?coverage pwm:reconstructionQuestion pwm:QuestionReproduction ; pwm:coverageStatus ?status . FILTER (?status IN (pwm:QuestionAnswered,pwm:QuestionNotRecorded)) }) }""" ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Report hash mismatches as findings (0.3 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:pinnedHashesVerified false . FILTER NOT EXISTS { $this pwm:hasFinding ?finding . ?finding pwm:findingKind "hash_mismatch" } }""" ] .


pwmsh:QuestionCoverageShape a sh:NodeShape ; rdfs:label "QuestionCoverageShape"@en ; sh:targetClass pwm:QuestionCoverage ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 8."@en ;
    sh:property [ sh:path pwm:reconstructionQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record reconstructionQuestion (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:coverageStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record coverageStatus (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Answered question must cite recorded evidence (0.3 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:coverageStatus pwm:QuestionAnswered . FILTER NOT EXISTS { $this pwm:citesSource ?source } }""" ] .


pwmsh:ReconstructionFindingShape a sh:NodeShape ; rdfs:label "ReconstructionFindingShape"@en ; sh:targetClass pwm:ReconstructionFinding ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 8."@en ;
    sh:property [ sh:path pwm:findingKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record findingKind (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:findingRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record findingRecord (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Hash mismatch finding records different expected and observed hashes (0.3 item 8)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:findingKind "hash_mismatch" . FILTER NOT EXISTS { $this pwm:expectedHash ?expected ; pwm:observedHash ?observed . FILTER (?expected != ?observed) } }""" ] .


pwmsh:GatewayConfigurationShape a sh:NodeShape ; rdfs:label "GatewayConfigurationShape"@en ; sh:targetClass pwm:AIUseCase ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 9."@en ;
    sh:property [ sh:path pwm:gatewayFailureMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Record gatewayFailureMode (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:retentionPolicy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:RetentionPolicy ] .


pwmsh:GovernedCallShape a sh:NodeShape ; rdfs:label "GovernedCallShape"@en ; sh:targetClass pwm:GovernedCall ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.3 item 3."@en ;
    sh:property [ sh:path pwm:callAgent ; sh:maxCount 1 ] ;
    sh:property [ sh:path pwm:systemTrigger ; sh:maxCount 1 ] ;
    sh:property [ sh:path pwm:inRun ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Run ; sh:message "Record inRun (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:governedByDecision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:PolicyDecision ; sh:message "Record governedByDecision (roadmap milestone 0.3)." ] ; sh:property [ sh:path pwm:clientConfiguration ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AuthenticatedClientConfiguration ; sh:message "Record clientConfiguration (roadmap milestone 0.3)." ] ; sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Call identity must be an agent bound to the authenticated client or a listed system trigger (0.3 Tier 0)." ; sh:select """SELECT DISTINCT $this WHERE { $this pwm:clientConfiguration ?config . FILTER NOT EXISTS { { $this pwm:callAgent ?agent . ?config pwm:boundAgent ?agent . FILTER NOT EXISTS { $this pwm:systemTrigger ?trigger } } UNION { $this pwm:systemTrigger ?trigger . ?config pwm:listedTrigger ?trigger . FILTER NOT EXISTS { $this pwm:callAgent ?agent } } } }""" ] .

# Pin each decision's component checks, including checks on denied requests.
pwmsh:PinnedDecisionShape a sh:NodeShape ;
    rdfs:label "Pinned decision checks"@en ; sh:targetClass pwm:PolicyDecision ;
    dcterms:source pwmref:KOG-ROADMAP , pwmref:MAS-AIRG ;
    rdfs:comment "Roadmap milestone 0.3 item 7; MAS AIRG 5.23(d) record keeping."@en ;
    sh:property [ sh:path pwm:hasCheck ; sh:minCount 1 ; sh:class pwm:PolicyCheck ;
        sh:message "Every policy decision carries pinned component checks (0.3 item 7)." ] .

pwmsh:SuspendedApprovalShape a sh:NodeShape ;
    rdfs:label "Approval checkpoint consistency"@en ; sh:targetClass pwm:ApprovalRequest ;
    dcterms:source pwmref:KOG-ROADMAP , pwmref:MAS-AIRG ;
    rdfs:comment "Roadmap milestone 0.3 item 2; MAS AIRG 5.9 human oversight."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ;
        sh:message "An approval request holds a HUMAN_APPROVAL decision at a suspended checkpoint of the same run (0.3 item 2)." ;
        sh:select """SELECT DISTINCT $this WHERE {
          $this pwm:requestsDecision ?decision ; pwm:atCheckpoint ?checkpoint .
          FILTER NOT EXISTS {
            ?decision pwm:decisionOutcome pwm:OutcomeHumanApproval ; pwm:inRun ?run .
            ?checkpoint pwm:inRun ?run ; pwm:runState pwm:RunSuspended .
          }
        }""" ] .

pwmsh:IngestedDocumentShape a sh:NodeShape ; rdfs:label "IngestedDocumentShape"@en ; sh:targetClass pwm:IngestedDocument ; dcterms:source pwmref:KOG-ROADMAP ;
    sh:property [ sh:path pwm:parserName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "Record parserName (Kognita 0.4 item 1)." ] ;
