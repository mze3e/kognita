    sh:property [ sh:path pwm:versionId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:versionId: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:baselineMetric ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "pwm:baselineMetric: minimum count 1, maximum count 1, datatype xsd:string." ] ;
    sh:property [ sh:path pwm:baselineExpected ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:baselineExpected: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:anomalyThreshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:anomalyThreshold: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:windowStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:windowStart: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:windowEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:windowEnd: minimum count 1, maximum count 1, datatype xsd:dateTime." ] .

pwmsh:BehaviourAnomalyShape a sh:NodeShape ; rdfs:label "BehaviourAnomalyShape"@en ; sh:targetClass pwm:BehaviourAnomaly ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 8. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:anomalyBaseline ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:BehaviourBaseline ; sh:message "pwm:anomalyBaseline: minimum count 1, maximum count 1, class pwm:BehaviourBaseline." ] ;
    sh:property [ sh:path pwm:anomalyValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "pwm:anomalyValue: minimum count 1, maximum count 1, datatype xsd:decimal." ] ;
    sh:property [ sh:path pwm:containmentApplied ; sh:hasValue true ; sh:message "pwm:containmentApplied: required value true." ] ;
    sh:property [ sh:path pwm:anomalyIncident ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIIncident ; sh:message "pwm:anomalyIncident: minimum count 1, maximum count 1, class pwm:AIIncident." ] ;
    sh:property [ sh:path pwm:notifiedRole ; sh:minCount 1 ; sh:class pwm:AccountabilityRole ; sh:message "pwm:notifiedRole: minimum count 1, class pwm:AccountabilityRole." ] .

pwmsh:CapabilityGrantShape a sh:NodeShape ; rdfs:label "CapabilityGrantShape"@en ; sh:targetClass pwm:CapabilityGrant ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 10. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:property [ sh:path pwm:grantee ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AIAgent ; sh:message "pwm:grantee: minimum count 1, maximum count 1, class pwm:AIAgent." ] ;
    sh:property [ sh:path pwm:grantedCapability ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:Tool ; sh:message "pwm:grantedCapability: minimum count 1, maximum count 1, class pwm:Tool." ] ;
    sh:property [ sh:path pwm:authorityScope ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pwm:AuthorityScope ; sh:message "pwm:authorityScope: minimum count 1, maximum count 1, class pwm:AuthorityScope." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:validFrom: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:validUntil ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:message "pwm:validUntil: minimum count 1, maximum count 1, datatype xsd:dateTime." ] ;
    sh:property [ sh:path pwm:validFrom ; sh:lessThan pwm:validUntil ; sh:message "pwm:validFrom: must be earlier or lower than pwm:validUntil." ] .

pwmsh:LiveGrantShape a sh:NodeShape ; rdfs:label "LiveGrantShape"@en ; sh:targetSubjectsOf pwm:reliesOnGrant ;
    dcterms:source pwmref:KOG-ROADMAP ; rdfs:comment "Roadmap milestone 0.5 item 10. Checks recorded evidence; runtime enforcement remains external."@en ;
    sh:sparql [ sh:prefixes <https://ahmedmuzammil.com/ontology/pwm/shapes> ; sh:message "Used capability grants must match agent and tool and remain unexpired and unrevoked (Kognita 0.5 item 10)." ;
        sh:select """SELECT DISTINCT $this WHERE { $this pwm:reliesOnGrant ?g ; pwm:governedByDecision ?d . ?d pwm:decisionOutcome ?out . FILTER(?out != pwm:OutcomeDeny)
 FILTER NOT EXISTS { $this pwm:callAgent ?a ; pwm:invokedTool ?tool . ?g pwm:grantee ?a ; pwm:grantedCapability ?tool ; pwm:validFrom ?s ; pwm:validUntil ?e . ?d <http://www.w3.org/ns/prov#generatedAtTime> ?at . FILTER(?at >= ?s && ?at < ?e) FILTER NOT EXISTS { ?r pwm:revokedAuthority ?g ; pwm:revokedAt ?rt . FILTER(?rt <= ?at) } } }""" ] .

