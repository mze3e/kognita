ex:RevokedCoveringEntitlement a pwm:HumanEntitlement ;
    pwm:authorityScope ex:Scope ;
    pwm:validFrom "2026-01-01T00:00:00+00:00"^^xsd:dateTime ;
    pwm:validUntil "2027-01-01T00:00:00+00:00"^^xsd:dateTime .

ex:MultiVerbTool a pwm:Tool ;
    rdfs:label "Read portfolio positions"@en ;
    pwm:actionVerb pwm:VerbAnalyse,
        pwm:VerbRead ;
    pwm:maximumDurationSeconds 30.0 ;
    pwm:requiredAutonomyLevel pwm:L0Retrieve ;
    pwm:reversibilityClass pwm:Irreversible ;
    pwm:supportsCancellation true .

ex:Agent pwm:permittedTool ex:MultiVerbTool .


# Firm approval of configured risk controls.
<https://example.org/pwm-example#Bad05BlastRadiusLimitShape> pwm:riskControlApproval ex:CommitteeApproval .
<https://example.org/pwm-example#Bad05PromotionGateShape> pwm:riskControlApproval ex:CommitteeApproval .
ex:BadLiveStatus a pwm:AuthorityLiveStatus ; pwm:liveStatusSubject ex:Delegation ; pwm:liveStatusValue "armed" ; pwm:observedAt "2026-11-03T02:00:00Z"^^xsd:dateTime .
ex:BadLimitApproval a pwm:BlastRadiusLimit ; pwm:limitDimension "clients" ; pwm:limitWindowBasis "minute" ; pwm:limitUnit "clients" ; pwm:limitMaximum 5.0 .
ex:BadGateApproval a pwm:AutonomyPromotionGate ; pwm:minimumSample "10"^^xsd:positiveInteger ; pwm:minimumWindowSeconds 60.0 ; pwm:qualityThreshold 0.95 ; pwm:exceptionRateThreshold 0.05 ; pwm:requiresFullTraceability true ; pwm:stepDownThreshold 0.8 .
ex:BadApprover a pwm:RiskControlApproval ; pwm:approverRole ex:Agent ; pwm:approvedAt "2026-11-02T00:00:00Z"^^xsd:dateTime .
ex:BadApprovalTime a pwm:RiskControlApproval ; pwm:approverRole ex:FirmRiskCommittee .

