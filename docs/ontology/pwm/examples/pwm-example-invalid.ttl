ex:MultiVerbScope a pwm:AuthorityScope ;
    pwm:aboutClient ex:Client ;
    pwm:accessEvent "Meeting within 24 hours" ;
    pwm:actionVerb pwm:VerbDraft,
        pwm:VerbRead ;
    pwm:classification pwm:C2 ;
    pwm:hasPurpose ex:PurposeMeetingPrep ;
    pwm:jurisdictionCode "SG" ;
    pwm:scopeAutonomyLevel pwm:L3Draft ;
    pwm:scopeField "riskProfile" ;
