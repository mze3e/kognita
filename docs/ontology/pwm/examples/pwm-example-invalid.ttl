    pwm:revokedAt "2026-11-03T00:00:00+00:00"^^xsd:dateTime ;
    pwm:revokedAuthority ex:RevokedCoveringEntitlement .

ex:CoverageDecision a pwm:PolicyDecision ;
    prov:generatedAtTime "2026-11-03T01:59:00+00:00"^^xsd:dateTime ;
    pwm:decidedByRule ex:RuleModelAccess ;
    pwm:decisionOutcome pwm:OutcomeAllow ;
    pwm:escalationThreshold 0.90 ;
    pwm:hasCheck ex:ModelAccessCheck ;
    pwm:hasPurpose ex:PurposeMeetingPrep ;
    pwm:inRun ex:Run ;
    pwm:limitObservation ex:Observation ;
    pwm:reliesOnDelegation ex:CoverageDelegation ;
    pwm:sandboxConstraints ex:Sandbox ;
    pwm:underUseCase ex:UseCaseMeetingPrep .

